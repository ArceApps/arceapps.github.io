---
import { optimizeGooglePlayImage } from "../utils/image-optimization";
import Card from "./Card.astro";

interface Props {
  title: string;
  description: string;
  icon?: string;
  realIconUrl?: string;
  link: string;
  color?: string; // Optional custom color class for icon background
  ctaText?: string;
  isExternal?: boolean;
  compact?: boolean;
  badges?: string[];
  category?: string;
  googlePlayUrl?: string;
}

const {
  title,
  description,
  icon = "android",
  realIconUrl,
  link,
  color = "bg-primary",
  ctaText = "Google Play Store",
  isExternal = false,
  compact = true,
  badges,
  category,
  googlePlayUrl,
} = Astro.props;

const displayBadges = (badges && badges.length > 0)
  ? badges
  : (category ? [category] : ['Android']);
---

<Card
  href={link}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  variant="app"
  ariaLabel={title}
  class="flex flex-col h-full bg-white dark:bg-[#111E26] border border-border dark:border-[#1F333E] rounded-2xl p-5 sm:p-6 transition-all"
>
  <div class="flex items-start gap-4 flex-1">
    <!-- Icono a la izquierda con esquinas redondeadas -->
    <div
      class={`h-14 w-14 shrink-0 rounded-2xl ${!realIconUrl ? color : "bg-white"} flex items-center justify-center text-white shadow-sm overflow-hidden border border-border/60 dark:border-[#1F333E]`}
    >
      {
        realIconUrl ? (
          <img
            src={optimizeGooglePlayImage(realIconUrl, 112, "square")}
            alt={`${title} icon`}
            loading="lazy"
            decoding="async"
            width="56"
            height="56"
            class="w-full h-full object-cover"
          />
        ) : (
          <span class="material-icons text-3xl">{icon}</span>
        )
      }
    </div>

    <!-- Contenido: Nombre, badge de categoría, descripción concisa de 2 líneas -->
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 mb-1 flex-wrap">
        <h3 class="font-bold text-lg text-on-surface dark:text-dark-on-surface group-hover:text-primary transition-colors motion-reduce:transition-none line-clamp-1">
          {title}
        </h3>
        {displayBadges.map((badge, idx) => (
          <span
            class:list={[
              "text-xs px-2.5 py-0.5 rounded-full",
              idx === 0
                ? "border border-primary/30 text-primary dark:text-teal-300 bg-primary/5 dark:bg-primary/10 font-semibold"
                : "bg-surface-subtle dark:bg-[#16242E] text-on-surface-variant dark:text-dark-on-surface-variant font-medium border border-border/40 dark:border-[#1F333E]",
            ]}
          >
            {badge}
          </span>
        ))}
      </div>
      <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant line-clamp-2 leading-relaxed">
        {description}
      </p>
    </div>
  </div>

  <!-- Bottom row: Enlace/botón a Google Play Store con icono oficial -->
  <div class="mt-4 pt-3 flex items-center justify-between border-t border-border/50 dark:border-[#1F333E]">
    <span class="inline-flex items-center gap-2 text-xs font-semibold text-primary dark:text-teal-400 group-hover:text-primary-strong dark:group-hover:text-teal-300 transition-colors motion-reduce:transition-none">
      <svg class="h-4 w-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3.609 1.814L13.792 12 3.61 22.186a2.222 2.222 0 0 1-.61-.954V2.768c.15-.36.368-.69.609-.954zm11.242 11.245l2.254 2.255-10.74 6.22 8.486-8.475zm2.885-1.127l2.84 1.645c.833.483.833 1.267 0 1.75l-2.84 1.645-2.52-2.52 2.52-2.52zm-2.885-1.127L6.365 2.33l10.74 6.22-2.254 2.255z"/>
      </svg>
      <span>{ctaText}</span>
    </span>
    <span class="material-icons text-primary dark:text-teal-400 text-base ml-2 shrink-0 transition-colors motion-reduce:transition-none" aria-hidden="true">arrow_forward</span>
  </div>
</Card>
