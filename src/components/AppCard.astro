---
interface Props {
  title: string;
  description: string;
  icon?: string;
  realIconUrl?: string;
  link: string;
  color?: string; // Optional custom color class for icon background
  ctaText?: string;
  isExternal?: boolean;
  compact?: boolean;
}

const {
  title,
  description,
  icon = "android",
  realIconUrl,
  link,
  color = "bg-primary",
  ctaText = "Descargar en Google Play",
  isExternal = true,
  compact = false,
} = Astro.props;

import { optimizeGooglePlayImage } from "../utils/image-optimization";
import Card from "./Card.astro";
---

<Card
  href={link}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  variant="app"
  ariaLabel={title}
>
  <div class:list={["flex h-full p-6", compact ? "items-start gap-4 sm:gap-5" : "flex-col"]}>
    <!-- Icon -->
    <div
      class={`h-14 w-14 shrink-0 rounded-2xl ${!realIconUrl ? color : "bg-white"} flex items-center justify-center text-white shadow-sm overflow-hidden ${compact ? "" : "mb-6"}`}
    >
      {
        realIconUrl ? (
          <img
            src={optimizeGooglePlayImage(realIconUrl, 112, "square")}
            alt={`${title} icon`}
            loading="lazy"
            decoding="async"
            width="56"
            height="56"
            class="w-full h-full object-cover"
          />
        ) : (
          <span class="material-icons text-3xl">{icon}</span>
        )
      }
    </div>

    <!-- Content -->
    <div class:list={["min-w-0", compact && "flex flex-1 flex-col self-stretch"]}>
    <h3
      class:list={["font-bold text-on-surface dark:text-dark-on-surface group-hover:text-primary transition-colors motion-reduce:transition-none", compact ? "mb-2 text-lg" : "mb-3 text-xl"]}
    >
      {title}
    </h3>
    <p
      class:list={["text-on-surface-variant dark:text-dark-on-surface-variant leading-relaxed flex-grow", compact ? "line-clamp-2 text-sm" : "line-clamp-3"]}
    >
      {description}
    </p>

    <!-- Action -->
    <div class:list={["flex items-center text-primary font-medium", compact ? "mt-4 text-sm" : "mt-6"]}>
      <span>{ctaText}</span>
      <span
        class="material-icons ml-1 text-sm"
        >arrow_forward</span
      >
    </div>
    </div>
  </div>
</Card>
