---
import { optimizeGooglePlayImage } from "../utils/image-optimization";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Card from "./Card.astro";

interface Props {
  title: string;
  description: string;
  icon?: string;
  realIconUrl?: string;
  link: string;
  color?: string; // Optional custom color class for icon background
  ctaText?: string;
  isExternal?: boolean;
  compact?: boolean;
  badges?: string[];
  category?: string;
  googlePlayUrl?: string;
}

const {
  title,
  description,
  icon = "android",
  realIconUrl,
  link,
  color = "bg-primary",
  ctaText = "Google Play Store",
  isExternal = false,
  compact = true,
  badges,
  category,
  googlePlayUrl,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Copy compartido EN/ES para los badges de la tarjeta.
const googlePlayLabel = t('apps.badge_google_play');
const androidLabel = t('apps.badge_android');
const detailText = t('apps.card_details');

// Badges visibles: la tienda (solo si hay URL real) y la plataforma Android.
// Los badges extra del llamante (categoria) se muestran primero.
interface Badge {
  key: string;
  label: string;
  icon?: string;
}

const extraBadges = (badges ?? []).filter(
  (badge) => badge !== googlePlayLabel && badge !== androidLabel
);
const categoryBadges: Badge[] = extraBadges.length > 0
  ? extraBadges.map((label, index) => ({ key: `category-${index}`, label }))
  : category
    ? [{ key: 'category', label: category }]
    : [];

const storeBadges: Badge[] = googlePlayUrl
  ? [{ key: 'google-play', label: googlePlayLabel, icon: 'shop' }]
  : [];

const platformBadges: Badge[] = [{ key: 'android', label: androidLabel, icon: 'android' }];

const visibleBadges: Badge[] = [...categoryBadges, ...storeBadges, ...platformBadges];
---

<Card
  href={link}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  variant="app"
  ariaLabel={title}
  class:list={[
  "flex h-full flex-col rounded-2xl border border-border bg-surface-raised transition-shadow duration-200 motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-focus/30 dark:border-dark-border dark:bg-dark-surface-raised",
  compact ? "p-5 sm:p-6" : "p-6 sm:p-8",
]}
>
  <div class="flex flex-1 items-start gap-4">
    <!-- Icono redondeado de la app -->
    <div
      class={`flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-border shadow-sm ${realIconUrl ? "bg-surface-raised dark:bg-dark-surface-raised" : `${color} text-white`}`}
    >
      {
        realIconUrl ? (
          <img
            src={optimizeGooglePlayImage(realIconUrl, 112, "square")}
            alt=""
            loading="lazy"
            decoding="async"
            width="56"
            height="56"
            class="h-full w-full object-cover"
          />
        ) : (
          <span class="material-icons text-3xl" aria-hidden="true">{icon}</span>
        )
      }
    </div>

    <!-- Contenido: titulo, badges y descripcion corta -->
    <div class="min-w-0 flex-1">
      <h3 class="text-content line-clamp-1 text-lg font-semibold transition-colors motion-reduce:transition-none group-hover:text-primary dark:text-dark-content dark:group-hover:text-primary">
        {title}
      </h3>

      {visibleBadges.length > 0 && (
        <ul class="mt-2 flex flex-wrap items-center gap-2">
          {visibleBadges.map((badge) => (
            <li
              class:list={[
                "inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 text-xs font-medium",
                badge.icon === 'shop'
                  ? "border-primary/30 bg-primary/5 text-primary dark:bg-primary/10 dark:text-primary"
                  : "border-border bg-surface-subtle text-content-muted dark:border-dark-border dark:bg-dark-surface-subtle dark:text-dark-content-muted",
              ]}
            >
              {badge.icon && (
                <span class="material-icons text-sm" aria-hidden="true">{badge.icon}</span>
              )}
              {badge.label}
            </li>
          ))}
        </ul>
      )}

      <p class="text-content-muted mt-2 line-clamp-2 text-sm leading-relaxed dark:text-dark-content-muted">
        {description}
      </p>
    </div>
  </div>

  <!-- Pie: CTA y flecha hacia el detalle de la app -->
  <div class="mt-4 flex items-center justify-between gap-3 border-t border-border pt-3 dark:border-dark-border">
    <span class="text-primary inline-flex min-w-0 items-center gap-2 text-xs font-semibold transition-colors motion-reduce:transition-none dark:text-primary group-hover:text-primary-strong dark:group-hover:text-primary">
      {googlePlayUrl ? (
        <span class="material-icons text-base" aria-hidden="true">shop</span>
      ) : (
        <span class="material-icons text-base" aria-hidden="true">info</span>
      )}
      <span class="truncate">{googlePlayUrl ? ctaText : detailText}</span>
    </span>
    <span class="material-icons text-primary shrink-0 text-base transition-colors motion-reduce:transition-none dark:text-primary" aria-hidden="true">arrow_forward</span>
  </div>
</Card>
