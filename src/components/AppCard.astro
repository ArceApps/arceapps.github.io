---
import { optimizeGooglePlayImage } from "../utils/image-optimization";
import Card from "./Card.astro";

interface Props {
  title: string;
  description: string;
  icon?: string;
  realIconUrl?: string;
  link: string;
  color?: string; // Optional custom color class for icon background
  ctaText?: string;
  isExternal?: boolean;
  compact?: boolean;
  badges?: string[];
  category?: string;
}

const {
  title,
  description,
  icon = "android",
  realIconUrl,
  link,
  color = "bg-primary",
  ctaText = "Descargar en Google Play",
  isExternal = true,
  compact = false,
  badges,
  category,
} = Astro.props;

const displayBadges = (badges && badges.length > 0)
  ? badges
  : (category ? [category, 'Android'] : ['Google Play', 'Android']);
---

<Card
  href={link}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  variant="app"
  ariaLabel={title}
>
  <div class:list={["flex h-full", compact ? "flex-col justify-between p-5 sm:p-6" : "flex-col p-6"]}>
    {
      compact ? (
        <>
          <div class="flex items-start gap-4">
            <!-- Icon -->
            <div
              class={`h-14 w-14 shrink-0 rounded-2xl ${!realIconUrl ? color : "bg-white"} flex items-center justify-center text-white shadow-sm overflow-hidden`}
            >
              {
                realIconUrl ? (
                  <img
                    src={optimizeGooglePlayImage(realIconUrl, 112, "square")}
                    alt={`${title} icon`}
                    loading="lazy"
                    decoding="async"
                    width="56"
                    height="56"
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <span class="material-icons text-3xl">{icon}</span>
                )
              }
            </div>

            <!-- Content -->
            <div class="min-w-0 flex-1">
              <h3 class="font-bold text-lg text-on-surface dark:text-dark-on-surface group-hover:text-primary transition-colors motion-reduce:transition-none line-clamp-1 mb-1">
                {title}
              </h3>
              <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant line-clamp-2 leading-relaxed">
                {description}
              </p>
            </div>
          </div>

          <!-- Bottom row -->
          <div class="mt-4 pt-3 flex items-center justify-between border-t border-border/40 dark:border-dark-border/40">
            <div class="flex flex-wrap items-center gap-2">
              {displayBadges.map((badge, idx) => (
                <span
                  class:list={[
                    "text-xs px-2.5 py-0.5 rounded-full",
                    idx === 0
                      ? "border border-primary/30 text-primary dark:text-teal-300 bg-primary/5 dark:bg-primary/10 font-semibold"
                      : "bg-surface-variant/80 dark:bg-dark-surface-subtle text-on-surface-variant dark:text-dark-on-surface-variant font-medium",
                  ]}
                >
                  {badge}
                </span>
              ))}
            </div>
            <span class="material-icons text-primary text-base ml-2 shrink-0" aria-hidden="true">arrow_forward</span>
          </div>
        </>
      ) : (
        <>
          <!-- Icon -->
          <div
            class={`h-14 w-14 shrink-0 rounded-2xl ${!realIconUrl ? color : "bg-white"} flex items-center justify-center text-white shadow-sm overflow-hidden mb-6`}
          >
            {
              realIconUrl ? (
                <img
                  src={optimizeGooglePlayImage(realIconUrl, 112, "square")}
                  alt={`${title} icon`}
                  loading="lazy"
                  decoding="async"
                  width="56"
                  height="56"
                  class="w-full h-full object-cover"
                />
              ) : (
                <span class="material-icons text-3xl">{icon}</span>
              )
            }
          </div>

          <!-- Content -->
          <div class="min-w-0 flex flex-1 flex-col self-stretch">
            <h3 class="font-bold text-xl text-on-surface dark:text-dark-on-surface group-hover:text-primary transition-colors motion-reduce:transition-none mb-3">
              {title}
            </h3>
            <p class="text-on-surface-variant dark:text-dark-on-surface-variant leading-relaxed line-clamp-3 flex-grow">
              {description}
            </p>

            <!-- Action -->
            <div class="flex items-center text-primary font-medium mt-6 text-sm">
              <span>{ctaText}</span>
              <span class="material-icons ml-1 text-sm" aria-hidden="true">arrow_forward</span>
            </div>
          </div>
        </>
      )
    }
  </div>
</Card>
