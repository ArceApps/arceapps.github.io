---
interface Props {
  number: string;
  title: string;
  id: string;
  href?: string;
  linkText?: string;
  class?: string;
}

const { number, title, id, href, linkText, class: className = "" } = Astro.props;
---

<header
  id={id}
  class:list={["mb-8 flex flex-wrap items-center justify-between gap-4", className]}
>
  <div class="flex flex-wrap items-center gap-3 sm:gap-4">
    <span class="sr-only" aria-hidden="true">{number}</span>
    <h2 class="text-2xl font-bold tracking-tight text-on-surface dark:text-dark-on-surface sm:text-3xl">
      {title}
    </h2>
    <slot name="after-title" />
  </div>

  <div class="flex items-center gap-4">
    <slot />
    {href && linkText && (
      <a
        href={href}
        class="inline-flex items-center text-sm font-semibold text-primary transition-colors hover:text-primary-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:text-teal-400 dark:hover:text-teal-300"
      >
        {linkText}
        <span class="material-icons ml-1 text-base" aria-hidden="true">arrow_forward</span>
      </a>
    )}
  </div>
</header>
