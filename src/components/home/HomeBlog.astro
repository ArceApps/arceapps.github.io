---
import HomeSectionHeader from "./HomeSectionHeader.astro";
import BlogCard from "../BlogCard.astro";
import Card from "../Card.astro";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: 'en' | 'es';
  linkPrefix: string;
  posts: any[];
  devlogs?: any[];
}

const { lang, linkPrefix, posts, devlogs = [] } = Astro.props;
const t = useTranslations(lang);
const blogUrl = `${linkPrefix}/blog`;
const devlogUrl = `${linkPrefix}/devlog`;
---

<section class="border-t border-border/50 bg-surface py-12 sm:py-16 cv-auto fade-in-section dark:border-dark-border/50 dark:bg-dark-surface md:py-24" style="contain-intrinsic-size: 700px;">
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <HomeSectionHeader
      number="02"
      title={lang === 'es' ? 'Últimos artículos' : 'Latest articles'}
      id="section-blog"
      href={blogUrl}
      linkText={lang === 'es' ? 'Ver todos' : 'View all'}
    >
      <div slot="after-title" class="flex items-center rounded-full border border-border bg-surface-subtle p-1 dark:border-dark-border dark:bg-dark-surface-subtle">
        <button
          id="home-tab-blog"
          type="button"
          class="rounded-full px-4 py-1.5 text-xs font-bold transition sm:text-sm bg-primary text-white shadow-sm"
        >
          Blog
        </button>
        <button
          id="home-tab-devlog"
          type="button"
          class="rounded-full px-4 py-1.5 text-xs font-bold transition sm:text-sm text-on-surface-variant hover:text-on-surface"
        >
          Devlog
        </button>
      </div>
    </HomeSectionHeader>

    <!-- Blog Posts Grid -->
    <div id="home-posts-blog" class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {posts.map((post) => (
        <div class="transition-transform duration-300 hover:-translate-y-1 motion-reduce:transition-none">
          <BlogCard post={post} />
        </div>
      ))}
    </div>

    <!-- Devlog Posts Grid -->
    <div id="home-posts-devlog" class="hidden grid grid-cols-1 gap-6 md:grid-cols-3">
      {devlogs.map((entry) => {
        const slug = entry.slug.split('/').pop();
        const href = `${linkPrefix}/devlog/${slug}`;
        const formattedDate = entry.data.pubDate ? new Date(entry.data.pubDate).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        }) : '';
        const firstTag = entry.data.tags?.[0];

        return (
          <div class="transition-transform duration-300 hover:-translate-y-1 motion-reduce:transition-none">
            <Card variant="article">
              <a
                href={href}
                data-astro-prefetch
                class="absolute inset-0 z-10 rounded-xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/50 transition-shadow motion-reduce:transition-none"
                aria-label={`${t('common.read_more')} ${entry.data.title}`}
              />

              <div class="aspect-video w-full overflow-hidden bg-gray-100 dark:bg-gray-800">
                <img
                  src={entry.data.heroImage || '/images/devlog-default.svg'}
                  alt={entry.data.title}
                  class="h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
              </div>

              <div class="pointer-events-none relative z-20 flex flex-grow flex-col p-6">
                <div class="mb-3 flex items-center gap-2">
                  {firstTag && (
                    <span class="rounded-md bg-primary/10 px-2 py-1 text-xs font-bold uppercase tracking-wider text-primary whitespace-nowrap">
                      {firstTag}
                    </span>
                  )}
                  <span class="ml-auto text-xs text-on-surface-variant/70 dark:text-dark-on-surface-variant/70">
                    {formattedDate}
                  </span>
                </div>

                <h3 class="pointer-events-none mb-3 line-clamp-2 text-xl font-bold text-on-surface transition-colors group-hover:text-primary dark:text-gray-100 motion-reduce:transition-none">
                  {entry.data.title}
                </h3>

                <p class="pointer-events-none mb-4 line-clamp-3 flex-grow text-sm leading-relaxed text-on-surface-variant dark:text-gray-300">
                  {entry.data.description}
                </p>

                <div class="pointer-events-none mt-auto flex items-center text-sm font-medium text-primary">
                  {t('home.read_entry')}
                  <span class="material-icons ml-1 text-base" aria-hidden="true">arrow_forward</span>
                </div>
              </div>
            </Card>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script is:inline define:vars={{ blogUrl, devlogUrl }}>
  (() => {
    const tabBlog = document.getElementById('home-tab-blog');
    const tabDevlog = document.getElementById('home-tab-devlog');
    const postsBlog = document.getElementById('home-posts-blog');
    const postsDevlog = document.getElementById('home-posts-devlog');
    const headerLink = document.querySelector('#section-blog a[href]');

    const activeClasses = ['bg-primary', 'text-white', 'shadow-sm'];
    const inactiveClasses = ['text-on-surface-variant', 'hover:text-on-surface'];

    function selectTab(tab) {
      if (tab === 'devlog') {
        tabDevlog?.classList.remove(...inactiveClasses);
        tabDevlog?.classList.add(...activeClasses);
        tabBlog?.classList.remove(...activeClasses);
        tabBlog?.classList.add(...inactiveClasses);

        postsBlog?.classList.add('hidden');
        postsDevlog?.classList.remove('hidden');

        if (headerLink) {
          headerLink.setAttribute('href', devlogUrl);
        }
      } else {
        tabBlog?.classList.remove(...inactiveClasses);
        tabBlog?.classList.add(...activeClasses);
        tabDevlog?.classList.remove(...activeClasses);
        tabDevlog?.classList.add(...inactiveClasses);

        postsDevlog?.classList.add('hidden');
        postsBlog?.classList.remove('hidden');

        if (headerLink) {
          headerLink.setAttribute('href', blogUrl);
        }
      }
    }

    tabBlog?.addEventListener('click', () => selectTab('blog'));
    tabDevlog?.addEventListener('click', () => selectTab('devlog'));
  })();
</script>
