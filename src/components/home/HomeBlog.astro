---
import HomeSectionHeader from "./HomeSectionHeader.astro";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: 'en' | 'es';
  linkPrefix: string;
  posts: any[];
  devlogs?: any[];
}

const { lang, linkPrefix, posts, devlogs = [] } = Astro.props;
const t = useTranslations(lang);
const blogUrl = `${linkPrefix}/blog`;
const devlogUrl = `${linkPrefix}/devlog`;

function getTagStyle(tag: string = ''): string {
  const lower = tag.toLowerCase();
  if (lower.includes('android') || lower.includes('kotlin')) {
    return 'bg-emerald-500/10 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400';
  }
  if (lower.includes('ia') || lower.includes('ai') || lower.includes('agent')) {
    return 'bg-cyan-500/10 text-cyan-600 dark:bg-cyan-500/20 dark:text-cyan-400';
  }
  if (lower.includes('arquitectura') || lower.includes('architecture')) {
    return 'bg-indigo-500/10 text-indigo-600 dark:bg-indigo-500/20 dark:text-indigo-400';
  }
  return 'bg-teal-500/10 text-primary dark:bg-teal-400/20 dark:text-teal-300';
}
---

<section class="border-t border-border/50 py-12 sm:py-16 md:py-20 cv-auto fade-in-section dark:border-[#1F333E]/50" style="contain-intrinsic-size: 700px;">
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <HomeSectionHeader
      number="02"
      title={lang === 'es' ? 'Últimos artículos' : 'Latest articles'}
      id="section-blog"
      href={blogUrl}
      linkText={lang === 'es' ? 'Ver todos' : 'View all'}
    >
      <div slot="after-title" class="inline-flex items-center rounded-full border border-border/80 bg-surface-subtle p-1 dark:border-[#1F333E] dark:bg-[#0D171F]">
        <button
          id="home-tab-blog"
          type="button"
          class="rounded-full px-4 py-1.5 text-xs sm:text-sm font-bold transition bg-primary text-white shadow-xs"
        >
          Blog
        </button>
        <button
          id="home-tab-devlog"
          type="button"
          class="rounded-full px-4 py-1.5 text-xs sm:text-sm font-bold transition text-on-surface-variant hover:text-on-surface dark:text-dark-on-surface-variant dark:hover:text-dark-on-surface"
        >
          Devlog
        </button>
      </div>
    </HomeSectionHeader>

    <!-- Blog Posts Grid (3 columnas en desktop) -->
    <div id="home-posts-blog" class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {posts.map((post) => {
        const slug = post.slug.split('/').pop();
        const href = `${linkPrefix}/blog/${slug}/`;
        const readingTime = Math.max(1, Math.ceil((post.body || "").split(/\s+/g).length / 200));
        const formattedDate = post.data.pubDate ? new Date(post.data.pubDate).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        }) : '';
        const tag = post.data.tags?.[0] || (lang === 'es' ? 'Artículo' : 'Article');
        const tagStyle = getTagStyle(tag);

        return (
          <article class="group relative flex flex-col justify-between rounded-2xl border border-border bg-white p-6 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:border-primary/50 hover:shadow-md dark:border-[#1F333E] dark:bg-[#111E26] dark:hover:border-teal-400/50">
            <a
              href={href}
              data-astro-prefetch
              class="absolute inset-0 z-10 rounded-2xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40"
              aria-label={`${lang === 'es' ? 'Leer artículo' : 'Read article'}: ${post.data.title}`}
            />

            <div>
              <!-- Badge temático superior + Metadatos -->
              <div class="flex items-center justify-between gap-2">
                <span class:list={["inline-flex items-center rounded-lg px-2.5 py-1 text-xs font-bold tracking-wide uppercase", tagStyle]}>
                  {tag}
                </span>
                <span class="text-xs text-on-surface-variant/70 dark:text-dark-on-surface-variant/70">
                  {formattedDate} · {readingTime} min
                </span>
              </div>

              <!-- Titular en negrita y jerarquía clara -->
              <h3 class="mt-4 text-lg font-bold tracking-tight text-on-surface transition-colors group-hover:text-primary dark:text-dark-on-surface dark:group-hover:text-teal-300 sm:text-xl line-clamp-2">
                {post.data.title}
              </h3>

              <!-- Extracto de 2 líneas con texto gris suave -->
              <p class="mt-2.5 text-sm leading-relaxed text-on-surface-variant/80 dark:text-dark-on-surface-variant/80 line-clamp-2">
                {post.data.description}
              </p>
            </div>

            <!-- Enlace sutil con flecha de lectura -->
            <div class="mt-6 flex items-center gap-1.5 text-xs font-semibold text-primary transition-all group-hover:gap-2.5 dark:text-teal-400 sm:text-sm">
              <span>{lang === 'es' ? 'Leer artículo' : 'Read article'}</span>
              <span class="material-icons text-base transition-transform group-hover:translate-x-0.5" aria-hidden="true">arrow_forward</span>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Devlog Posts Grid (3 columnas en desktop) -->
    <div id="home-posts-devlog" class="hidden grid grid-cols-1 gap-6 md:grid-cols-3">
      {devlogs.map((entry) => {
        const slug = entry.slug.split('/').pop();
        const href = `${linkPrefix}/devlog/${slug}/`;
        const readingTime = Math.max(1, Math.ceil((entry.body || "").split(/\s+/g).length / 200));
        const formattedDate = entry.data.pubDate ? new Date(entry.data.pubDate).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        }) : '';
        const tag = entry.data.tags?.[0] || 'Devlog';
        const tagStyle = getTagStyle(tag);

        return (
          <article class="group relative flex flex-col justify-between rounded-2xl border border-border bg-white p-6 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:border-primary/50 hover:shadow-md dark:border-[#1F333E] dark:bg-[#111E26] dark:hover:border-teal-400/50">
            <a
              href={href}
              data-astro-prefetch
              class="absolute inset-0 z-10 rounded-2xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40"
              aria-label={`${lang === 'es' ? 'Leer entrada' : 'Read entry'}: ${entry.data.title}`}
            />

            <div>
              <!-- Badge temático superior + Metadatos -->
              <div class="flex items-center justify-between gap-2">
                <span class:list={["inline-flex items-center rounded-lg px-2.5 py-1 text-xs font-bold tracking-wide uppercase", tagStyle]}>
                  {tag}
                </span>
                <span class="text-xs text-on-surface-variant/70 dark:text-dark-on-surface-variant/70">
                  {formattedDate} · {readingTime} min
                </span>
              </div>

              <!-- Titular en negrita y jerarquía clara -->
              <h3 class="mt-4 text-lg font-bold tracking-tight text-on-surface transition-colors group-hover:text-primary dark:text-dark-on-surface dark:group-hover:text-teal-300 sm:text-xl line-clamp-2">
                {entry.data.title}
              </h3>

              <!-- Extracto de 2 líneas con texto gris suave -->
              <p class="mt-2.5 text-sm leading-relaxed text-on-surface-variant/80 dark:text-dark-on-surface-variant/80 line-clamp-2">
                {entry.data.description}
              </p>
            </div>

            <!-- Enlace sutil con flecha de lectura -->
            <div class="mt-6 flex items-center gap-1.5 text-xs font-semibold text-primary transition-all group-hover:gap-2.5 dark:text-teal-400 sm:text-sm">
              <span>{lang === 'es' ? 'Leer entrada' : 'Read entry'}</span>
              <span class="material-icons text-base transition-transform group-hover:translate-x-0.5" aria-hidden="true">arrow_forward</span>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script is:inline define:vars={{ blogUrl, devlogUrl }}>
  (() => {
    const tabBlog = document.getElementById('home-tab-blog');
    const tabDevlog = document.getElementById('home-tab-devlog');
    const postsBlog = document.getElementById('home-posts-blog');
    const postsDevlog = document.getElementById('home-posts-devlog');
    const headerLink = document.querySelector('#section-blog a[href]');

    const activeClasses = ['bg-primary', 'text-white', 'shadow-xs'];
    const inactiveClasses = ['text-on-surface-variant', 'hover:text-on-surface', 'dark:text-dark-on-surface-variant', 'dark:hover:text-dark-on-surface'];

    function selectTab(tab) {
      if (tab === 'devlog') {
        tabDevlog?.classList.remove(...inactiveClasses);
        tabDevlog?.classList.add(...activeClasses);
        tabBlog?.classList.remove(...activeClasses);
        tabBlog?.classList.add(...inactiveClasses);

        postsBlog?.classList.add('hidden');
        postsDevlog?.classList.remove('hidden');

        if (headerLink) {
          headerLink.setAttribute('href', devlogUrl);
        }
      } else {
        tabBlog?.classList.remove(...inactiveClasses);
        tabBlog?.classList.add(...activeClasses);
        tabDevlog?.classList.remove(...activeClasses);
        tabDevlog?.classList.add(...inactiveClasses);

        postsDevlog?.classList.add('hidden');
        postsBlog?.classList.remove('hidden');

        if (headerLink) {
          headerLink.setAttribute('href', blogUrl);
        }
      }
    }

    tabBlog?.addEventListener('click', () => selectTab('blog'));
    tabDevlog?.addEventListener('click', () => selectTab('devlog'));
  })();
</script>
