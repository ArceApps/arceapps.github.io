---
import HomeSectionHeader from "./HomeSectionHeader.astro";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: 'en' | 'es';
  linkPrefix: string;
  posts: any[];
  devlogs?: any[];
}

const { lang, linkPrefix, posts, devlogs = [] } = Astro.props;
const t = useTranslations(lang);

const blogUrl = `${linkPrefix}/blog`;
const devlogUrl = `${linkPrefix}/devlog`;

const sectionTitle = t('home.articles.title');
const viewAllLabel = t('home.articles.view_all');
const readArticleLabel = t('home.articles.read_aria');
const blogFilterLabel = t('home.articles.filter_blog');
const devlogFilterLabel = t('home.articles.filter_devlog');
const filterAriaLabel = t('home.articles.filter_aria');
const readingTimeLabel = t('home.articles.reading_time');

interface ArticleCard {
  filter: 'blog' | 'devlog';
  href: string;
  title: string;
  description: string;
  image?: string;
  formattedDate: string;
  isoDate: string;
  readingTime: number;
}

function formatDate(value: Date | string): string {
  if (!value) return '';
  return new Date(value).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

function toIsoDate(value: Date | string): string {
  return value ? new Date(value).toISOString().slice(0, 10) : '';
}

function estimateReadingTime(body?: string): number {
  return Math.max(1, Math.ceil((body || '').split(/\s+/g).filter(Boolean).length / 200));
}

const blogCards: ArticleCard[] = posts.slice(0, 3).map((post) => ({
  filter: 'blog',
  href: `${blogUrl}/${post.slug.split('/').pop()}/`,
  title: post.data.title,
  description: post.data.description,
  image: post.data.heroImage,
  formattedDate: formatDate(post.data.pubDate),
  isoDate: toIsoDate(post.data.pubDate),
  readingTime: estimateReadingTime(post.body),
}));

const devlogCards: ArticleCard[] = devlogs.slice(0, 3).map((entry) => ({
  filter: 'devlog',
  href: `${devlogUrl}/${entry.slug.split('/').pop()}/`,
  title: entry.data.title,
  description: entry.data.description,
  image: entry.data.heroImage,
  formattedDate: formatDate(entry.data.pubDate),
  isoDate: toIsoDate(entry.data.pubDate),
  readingTime: estimateReadingTime(entry.body),
}));

const cards: ArticleCard[] = [...blogCards, ...devlogCards];

// Filtro activo por defecto: Blog. El script en cliente lo conmuta a Devlog.
const activeFilter: 'blog' | 'devlog' = 'blog';
---

<section class="border-t border-border/50 py-12 sm:py-16 md:py-20 cv-auto fade-in-section dark:border-dark-border/50" style="contain-intrinsic-size: 700px;">
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-articles-root>
    <HomeSectionHeader
      number="02"
      title={sectionTitle}
      id="section-blog"
    >
      <div
        slot="after-title"
        class="inline-flex items-center gap-2 rounded-full border border-border bg-surface-subtle p-1 dark:border-dark-border dark:bg-dark-surface-subtle"
        role="group"
        aria-label={filterAriaLabel}
      >
        <button
          type="button"
          data-filter="blog"
          data-active="true"
          aria-pressed="true"
          class="home-articles-chip inline-flex items-center rounded-full bg-primary px-4 py-1.5 text-xs font-semibold text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm"
        >
          {blogFilterLabel}
        </button>
        <button
          type="button"
          data-filter="devlog"
          data-active="false"
          aria-pressed="false"
          class="home-articles-chip inline-flex items-center rounded-full px-4 py-1.5 text-xs font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm"
        >
          {devlogFilterLabel}
        </button>
      </div>
    </HomeSectionHeader>

    <!-- Enlace de listado completo: apunta al listado según el chip activo -->
    <div class="mb-6 flex justify-end">
      <a
        id="home-articles-view-all"
        data-view-all
        href={blogUrl}
        class="inline-flex items-center text-sm font-semibold text-primary transition-colors hover:text-primary-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:text-[#00ACB0] dark:hover:text-[#00ACB0]"
      >
        {viewAllLabel}
        <span class="material-icons ml-1 text-base" aria-hidden="true">arrow_forward</span>
      </a>
    </div>

    <!-- Grid de 3 tarjetas: una por artículo, filtrable en cliente por data-filter -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {cards.map((card) => (
        <article
          data-article-card
          data-filter={card.filter}
          class:list={[
            "group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-xs transition-all duration-200 hover:border-primary/50 hover:shadow-md motion-reduce:transition-none dark:border-dark-border dark:bg-dark-surface-raised dark:hover:border-[#00ACB0]/50",
            card.filter !== activeFilter && "hidden",
          ]}
        >
          <a
            href={card.href}
            data-astro-prefetch
            class="absolute inset-0 z-10 rounded-2xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/40"
            aria-label={`${readArticleLabel}: ${card.title}`}
          />

          {card.image ? (
            <div class="aspect-video w-full overflow-hidden bg-surface-variant dark:bg-dark-surface-variant">
              <img
                src={card.image}
                alt=""
                width="800"
                height="450"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
          ) : (
            <div
              class="aspect-video w-full overflow-hidden bg-surface-variant dark:bg-dark-surface-variant"
              aria-hidden="true"
            >
              <div class="flex h-full w-full items-center justify-center">
                <span class="material-icons text-4xl text-on-surface-variant/40 dark:text-dark-on-surface-variant/40">article</span>
              </div>
            </div>
          )}

          <div class="flex flex-1 flex-col p-5 sm:p-6">
            <h3 class="text-content line-clamp-2 text-lg font-semibold tracking-tight transition-colors group-hover:text-primary dark:group-hover:text-[#00ACB0]">
              {card.title}
            </h3>

            <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-content-muted dark:text-dark-content-muted">
              {card.description}
            </p>

            <p class="mt-4 text-xs text-content-muted dark:text-dark-content-muted">
              <time datetime={card.isoDate}>{card.formattedDate}</time>
              <span aria-hidden="true"> · </span>
              <span>{readingTimeLabel.replace('{min}', String(card.readingTime))}</span>
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline define:vars={{ blogUrl, devlogUrl }}>
  (() => {
    const initHomeArticlesFilters = () => {
      const root = document.querySelector('[data-articles-root]');
      if (!root || root.dataset.articlesReady === 'true') return;
      root.dataset.articlesReady = 'true';

      const chips = Array.from(root.querySelectorAll('button[data-filter]'));
      const cards = Array.from(root.querySelectorAll('[data-article-card]'));
      const viewAll = root.querySelector('[data-view-all]');

      function selectFilter(filter) {
        chips.forEach((chip) => {
          const isActive = chip.getAttribute('data-filter') === filter;
          chip.setAttribute('data-active', isActive ? 'true' : 'false');
          chip.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          // El acento del chip activo lo aporta la utilidad bg-primary del sistema,
          // que en dark se sobreescribe a #00ACB0.
          chip.classList.toggle('bg-primary', isActive);
          chip.classList.toggle('text-white', isActive);
        });

        cards.forEach((card) => {
          card.classList.toggle('hidden', card.getAttribute('data-filter') !== filter);
        });

        if (viewAll) {
          viewAll.setAttribute('href', filter === 'devlog' ? devlogUrl : blogUrl);
        }
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => selectFilter(chip.getAttribute('data-filter')));
      });
    };

    initHomeArticlesFilters();
    document.addEventListener('astro:page-load', initHomeArticlesFilters);
  })();
</script>

<style>
  /* El chip activo usa las utilidades del sistema (bg-primary text-white), que en
     dark se sobreescriben a #00ACB0. Por eso el estilo base de abajo solo aplica
     al chip inactivo: las utilidades van en la capa utilities de Tailwind y este
     bloque scoped no la usa. */
  .home-articles-chip:not([data-active='true']) {
    color: var(--color-on-surface-variant);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .home-articles-chip:not([data-active='true']):hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .home-articles-chip[data-active='true'] {
    border-color: transparent;
  }

  :global(.dark) .home-articles-chip:not([data-active='true']) {
    color: var(--color-dark-on-surface-variant);
    background-color: var(--color-dark-surface-raised);
    border-color: var(--color-dark-border);
  }

  :global(.dark) .home-articles-chip:not([data-active='true']):hover {
    color: var(--color-dark-focus);
    border-color: var(--color-dark-focus);
  }
</style>
