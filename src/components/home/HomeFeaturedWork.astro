---
import HomeSectionHeader from "./HomeSectionHeader.astro";
import { useTranslations } from "../../i18n/utils";

interface FeaturedItem {
  title: string;
  description: string;
  href: string;
  heroImage?: string;
  kind: 'app' | 'project';
  realIconUrl?: string;
  googlePlayUrl?: string;
  repoUrl?: string;
  tags?: string[];
  screenshots?: string[];
}

interface Props {
  lang: 'en' | 'es';
  featuredWork?: FeaturedItem;
  featuredItems?: FeaturedItem[];
}

const { lang, featuredWork, featuredItems } = Astro.props;
const t = useTranslations(lang);

const item: FeaturedItem = featuredWork || (featuredItems && featuredItems.length > 0 ? featuredItems[0] : {
  title: 'RadioHub',
  description: lang === 'es'
    ? 'Una aplicación moderna de radio por internet para Android diseñada con Material You. Sintoniza miles de emisoras con reproducción fluida en segundo plano y temporizador de apagado.'
    : 'A modern internet radio app for Android built with Material You. Stream thousands of radio stations seamlessly with background playback and sleep timer.',
  href: lang === 'es' ? '/es/apps/radiohub' : '/apps/radiohub',
  kind: 'app' as const,
  realIconUrl: '/images/apps/radiohub/logo.png',
  googlePlayUrl: 'https://play.google.com/store/apps/details?id=com.arceapps.radiohub',
  tags: ['Music', 'Radio', 'Streaming'],
});

const iconUrl = item.realIconUrl || item.heroImage || '/images/apps/radiohub/logo.png';
const tags = (item.tags && item.tags.length > 0 ? item.tags : ['Android']).slice(0, 4);
const screenshots = (item.screenshots ?? []).filter((src) => typeof src === 'string' && src.length > 0);
const playUrl = item.googlePlayUrl || 'https://play.google.com/store/apps/details?id=com.arceapps.radiohub';
const projectHref = item.href || (lang === 'es' ? '/es/apps/radiohub' : '/apps/radiohub');

// Copy de los CTA: el literal español vive en la fuente Astro y el inglés se mantiene en ui.ts.
const projectCtaLabel = lang === 'es' ? 'Ver proyecto' : t('home.work.project_cta');
const playCtaLabel = lang === 'es' ? 'Ver en Google Play' : t('home.work.play_cta');
const androidBadgeLabel = t('home.work.android_badge');
const screenshotsAriaLabel = t('home.work.screenshots_aria');
const carouselPrevLabel = t('home.work.carousel_prev');
const carouselNextLabel = t('home.work.carousel_next');
---

<section class="py-12 sm:py-16 cv-auto fade-in-section" style="contain-intrinsic-size: 600px;">
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <HomeSectionHeader
      number="01"
      title={lang === 'es' ? 'Proyecto destacado' : 'Featured project'}
      id="section-work"
    />

    <!-- Split-card: contenido a la izquierda, capturas reales a la derecha -->
    <article class="material-card overflow-hidden p-6 sm:p-8 lg:p-10">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <!-- Columna izquierda: icono, título, meta real, descripción y acciones -->
        <div class="flex flex-col justify-center lg:col-span-6">
          <div class="flex items-start gap-4 sm:gap-5">
            <img
              src={iconUrl}
              alt={`${item.title} icon`}
              class="h-20 w-20 shrink-0 rounded-2xl border border-border object-cover shadow-sm dark:border-dark-border sm:h-24 sm:w-24"
              loading="lazy"
              decoding="async"
              width="96"
              height="96"
            />
            <div class="min-w-0">
              <h3 class="text-2xl font-extrabold tracking-tight text-on-surface dark:text-dark-on-surface sm:text-3xl">
                {item.title}
              </h3>
              <!-- Meta real: badge Android + chips de tags (sin ratings) -->
              <div class="mt-2 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-surface-variant px-2.5 py-1 text-xs font-semibold text-on-surface-variant dark:bg-dark-surface-variant dark:text-dark-on-surface-variant">
                  <span class="material-icons text-sm text-secondary dark:text-secondary" aria-hidden="true">smartphone</span>
                  {androidBadgeLabel}
                </span>
                {tags.map((tag) => (
                  <span class="inline-flex items-center rounded-full border border-border bg-surface px-2.5 py-1 text-xs font-medium text-on-surface-variant dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <p class="mt-6 text-base leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
            {item.description}
          </p>

          <!-- Botones de acción -->
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href={projectHref}
              class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-primary-strong focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30"
            >
              <span>{projectCtaLabel}</span>
              <span class="material-icons text-base" aria-hidden="true">arrow_forward</span>
            </a>

            <a
              href={playUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-5 py-3 text-sm font-semibold text-on-surface transition hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface dark:hover:border-primary dark:hover:text-primary"
            >
              <span>{playCtaLabel}</span>
            </a>
          </div>
        </div>

        <!-- Columna derecha: carrusel de capturas reales -->
        <div class="lg:col-span-6">
          <div
            class="home-work-carousel flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2"
            role="group"
            aria-label={screenshotsAriaLabel}
            tabindex="0"
          >
            {screenshots.length > 0 ? (
              screenshots.map((shot) => (
                <img
                  src={shot}
                  alt={`${item.title} screenshot`}
                  class="w-40 shrink-0 snap-center rounded-2xl border border-border bg-surface object-cover shadow-sm dark:border-dark-border dark:bg-dark-surface-raised sm:w-48"
                  loading="lazy"
                  decoding="async"
                />
              ))
            ) : (
              <img
                src={item.heroImage || '/images/apps/radiohub/es/feature_graphic.png'}
                alt={`${item.title} screenshot`}
                class="w-56 shrink-0 snap-center rounded-2xl border border-border bg-surface object-cover shadow-sm dark:border-dark-border dark:bg-dark-surface-raised"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>

          <!-- Controles circulares del carrusel -->
          <div class="mt-4 flex items-center gap-2">
            <button
              type="button"
              data-home-work-prev
              aria-label={carouselPrevLabel}
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border bg-surface text-on-surface transition hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface dark:hover:border-primary dark:hover:text-primary"
            >
              <span class="material-icons text-lg" aria-hidden="true">chevron_left</span>
            </button>
            <button
              type="button"
              data-home-work-next
              aria-label={carouselNextLabel}
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border bg-surface text-on-surface transition hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface dark:hover:border-primary dark:hover:text-primary"
            >
              <span class="material-icons text-lg" aria-hidden="true">chevron_right</span>
            </button>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  const initHomeWorkCarousel = () => {
    document.querySelectorAll<HTMLElement>('.home-work-carousel').forEach((track) => {
      if (track.dataset.carouselReady === 'true') return;
      track.dataset.carouselReady = 'true';

      const step = Math.max(track.clientWidth * 0.8, 160);
      const prev = track.parentElement?.querySelector<HTMLButtonElement>('[data-home-work-prev]');
      const next = track.parentElement?.querySelector<HTMLButtonElement>('[data-home-work-next]');

      prev?.addEventListener('click', () => {
        track.scrollBy({ left: -step, behavior: 'smooth' });
      });

      next?.addEventListener('click', () => {
        track.scrollBy({ left: step, behavior: 'smooth' });
      });
    });
  };

  initHomeWorkCarousel();
  document.addEventListener('astro:page-load', initHomeWorkCarousel);
</script>
