---
import HomeSectionHeader from "./HomeSectionHeader.astro";
import { useTranslations } from "../../i18n/utils";

interface FeaturedItem {
  title: string;
  description: string;
  href: string;
  heroImage?: string;
  kind: 'app' | 'project';
  realIconUrl?: string;
  googlePlayUrl?: string;
  repoUrl?: string;
  tags?: string[];
  screenshots?: string[];
}

interface Props {
  lang: 'en' | 'es';
  featuredWork?: FeaturedItem;
  featuredItems?: FeaturedItem[];
}

const { lang, featuredWork, featuredItems } = Astro.props;
const t = useTranslations(lang);

const items: FeaturedItem[] = (featuredItems && featuredItems.length > 0)
  ? featuredItems
  : (featuredWork ? [featuredWork] : []);
---

<section class="py-12 sm:py-16 cv-auto fade-in-section" style="contain-intrinsic-size: 600px;">
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <HomeSectionHeader
      number="01"
      title={lang === 'es' ? 'Proyecto destacado' : 'Featured project'}
      id="section-work"
    />

    {items.length > 0 ? (
      <div class="relative">
        {items.map((item, index) => (
          <div
            class:list={[
              "featured-slide",
              index === 0 ? "block" : "hidden"
            ]}
            data-index={index}
          >
            <article class="grid grid-cols-1 items-center gap-8 overflow-hidden rounded-3xl border border-border bg-surface-raised p-6 shadow-sm dark:border-dark-border dark:bg-dark-surface-raised sm:p-8 lg:grid-cols-12 lg:gap-12 lg:p-10">
              <!-- Left Column: Details -->
              <div class="flex flex-col justify-center lg:col-span-5">
                <div class="flex items-center gap-4">
                  <img
                    src={item.realIconUrl || (item.title.toLowerCase() === 'radiohub' ? '/images/apps/radiohub/logo.png' : (item.heroImage || '/images/apps/radiohub/logo.png'))}
                    alt={`${item.title} icon`}
                    class="h-16 w-16 rounded-2xl border border-border object-cover shadow-md dark:border-dark-border"
                    loading="lazy"
                    decoding="async"
                  />
                  <div>
                    <h3 class="text-2xl font-extrabold tracking-tight text-on-surface dark:text-dark-on-surface sm:text-3xl">
                      {item.title}
                    </h3>
                    <div class="mt-1">
                      <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-xs font-semibold text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400">
                        <span class="material-icons text-xs" aria-hidden="true">android</span>
                        {item.kind === 'app' ? 'Android' : 'Open Source'}
                      </span>
                    </div>
                  </div>
                </div>

                <p class="mt-5 text-base leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
                  {item.description}
                </p>

                <div class="mt-8 flex flex-wrap items-center gap-3">
                  <a
                    href={item.href}
                    class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-primary-strong focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30"
                  >
                    {lang === 'es' ? 'Ver proyecto' : 'View project'}
                    <span class="material-icons text-base" aria-hidden="true">arrow_forward</span>
                  </a>

                  {item.googlePlayUrl ? (
                    <a
                      href={item.googlePlayUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-on-surface transition hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 dark:border-dark-border dark:bg-dark-surface dark:text-dark-on-surface dark:hover:border-teal-400 dark:hover:text-teal-400"
                    >
                      <span class="material-icons text-base" aria-hidden="true">shop</span>
                      {lang === 'es' ? 'Ver en Google Play' : 'View on Google Play'}
                    </a>
                  ) : item.repoUrl ? (
                    <a
                      href={item.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-5 py-2.5 text-sm font-semibold text-on-surface transition hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 dark:border-dark-border dark:bg-dark-surface dark:text-dark-on-surface dark:hover:border-teal-400 dark:hover:text-teal-400"
                    >
                      <span class="material-icons text-base" aria-hidden="true">code</span>
                      {lang === 'es' ? 'Ver repositorio' : 'View repository'}
                    </a>
                  ) : null}
                </div>
              </div>

              <!-- Right Column: Mockup with screenshots -->
              <div class="lg:col-span-7">
                <div class="relative flex min-h-[300px] items-center justify-center overflow-hidden rounded-2xl border border-teal-500/20 bg-teal-50/50 p-4 sm:min-h-[340px] sm:p-6 dark:border-teal-400/10 dark:bg-teal-950/20">
                  {item.screenshots && item.screenshots.length > 0 ? (
                    <div class="relative flex w-full items-center justify-center gap-2 sm:gap-4">
                      {item.screenshots.slice(0, 3).map((shot, sIndex) => {
                        const isCenter = sIndex === 1 || (item.screenshots && item.screenshots.length < 3 && sIndex === 0);
                        return (
                          <div
                            class:list={[
                              "relative overflow-hidden rounded-2xl border-4 border-gray-800 bg-gray-900 shadow-xl transition-transform duration-300",
                              isCenter
                                ? "z-20 w-[36%] max-w-[170px] scale-105 shadow-2xl"
                                : "z-10 w-[30%] max-w-[140px] opacity-90 brightness-95"
                            ]}
                            style="aspect-ratio: 9 / 18.5;"
                          >
                            <div class="absolute left-1/2 top-1.5 z-10 h-1 w-8 -translate-x-1/2 rounded-full bg-gray-700/80" aria-hidden="true"></div>
                            <img
                              src={shot}
                              alt=""
                              loading="lazy"
                              decoding="async"
                              class="h-full w-full object-cover object-top"
                            />
                          </div>
                        );
                      })}
                    </div>
                  ) : item.heroImage ? (
                    <div class="relative w-full max-w-md overflow-hidden rounded-2xl border-4 border-gray-800 bg-gray-900 shadow-xl">
                      <img
                        src={item.heroImage}
                        alt={item.title}
                        class="h-auto w-full object-cover"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  ) : (
                    <div class="flex items-center justify-center py-12 text-primary opacity-60">
                      <span class="material-icons text-7xl">phone_android</span>
                    </div>
                  )}
                </div>
              </div>
            </article>
          </div>
        ))}

        {items.length > 1 && (
          <div class="mt-4 flex items-center justify-between px-2">
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="featured-prev"
                aria-label={lang === 'es' ? 'Proyecto anterior' : 'Previous project'}
                class="flex h-9 w-9 items-center justify-center rounded-full border border-border bg-surface text-on-surface shadow-sm transition hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface dark:hover:border-teal-400 dark:hover:text-teal-400"
              >
                <span class="material-icons text-base" aria-hidden="true">arrow_back</span>
              </button>
              <button
                type="button"
                id="featured-next"
                aria-label={lang === 'es' ? 'Siguiente proyecto' : 'Next project'}
                class="flex h-9 w-9 items-center justify-center rounded-full border border-border bg-surface text-on-surface shadow-sm transition hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface dark:hover:border-teal-400 dark:hover:text-teal-400"
              >
                <span class="material-icons text-base" aria-hidden="true">arrow_forward</span>
              </button>
            </div>

            <div class="flex items-center gap-2" id="featured-dots">
              {items.map((_, dotIndex) => (
                <button
                  type="button"
                  data-slide-target={dotIndex}
                  aria-label={`Slide ${dotIndex + 1}`}
                  class:list={[
                    "featured-dot h-2 rounded-full transition-all duration-300",
                    dotIndex === 0
                      ? "w-6 bg-primary dark:bg-teal-400"
                      : "w-2 bg-border hover:bg-on-surface-variant/40 dark:bg-dark-border"
                  ]}
                />
              ))}
            </div>
          </div>
        )}
      </div>
    ) : (
      <p class="py-12 text-center text-on-surface-variant dark:text-dark-on-surface-variant">
        {t('apps.empty')}
      </p>
    )}
  </div>
</section>

<script is:inline>
  (() => {
    const slides = document.querySelectorAll('.featured-slide');
    const dots = document.querySelectorAll('.featured-dot');
    const prevBtn = document.getElementById('featured-prev');
    const nextBtn = document.getElementById('featured-next');
    if (!slides || slides.length <= 1) return;

    let currentIndex = 0;

    function showSlide(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;
      currentIndex = index;

      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.remove('hidden');
          slide.classList.add('block');
        } else {
          slide.classList.remove('block');
          slide.classList.add('hidden');
        }
      });

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.className = 'featured-dot h-2 rounded-full transition-all duration-300 w-6 bg-primary dark:bg-teal-400';
        } else {
          dot.className = 'featured-dot h-2 rounded-full transition-all duration-300 w-2 bg-border hover:bg-on-surface-variant/40 dark:bg-dark-border';
        }
      });
    }

    prevBtn?.addEventListener('click', () => showSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => showSlide(currentIndex + 1));
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => showSlide(i));
    });
  })();
</script>
