---
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="home-hero relative isolate overflow-hidden border-b border-border bg-surface-subtle px-4 py-16 dark:border-dark-border dark:bg-dark-surface-subtle md:py-24"
  aria-labelledby="home-hero-title"
>
  <div class="relative mx-auto grid w-full max-w-7xl items-center gap-12 lg:grid-cols-[1.35fr_0.65fr]">
    <div>
      <p class="mb-5 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.15em] text-primary dark:text-teal-300">
        <span class="h-2 w-2 rounded-full bg-secondary" aria-hidden="true"></span>
        {lang === 'es' ? 'Desarrollo independiente · Android · IA' : 'Independent development · Android · AI'}
      </p>
      <h1 id="home-hero-title" class="home-hero-title max-w-4xl text-[clamp(2.65rem,5.4vw,6rem)] font-extrabold leading-[1.08] tracking-tight text-on-surface dark:text-dark-on-surface">
        {lang === 'es' ? 'Software independiente que resuelve problemas reales.' : 'Independent software for real-world problems.'}
      </h1>
      <p class="home-hero-manifesto mt-6 max-w-2xl text-lg leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant md:text-xl">{t('home.manifesto')}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={lang === 'es' ? '/es/projects' : '/projects'} class="inline-flex min-h-12 items-center gap-2 rounded-xl bg-primary px-6 py-3 font-bold text-white hover:bg-primary-strong focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 motion-reduce:transition-none">
          {t('home.view_all_projects')} <span class="material-icons text-lg" aria-hidden="true">arrow_forward</span>
        </a>
        <a href={lang === 'es' ? '/es/blog' : '/blog'} class="inline-flex min-h-12 items-center rounded-xl border border-border bg-surface px-6 py-3 font-semibold text-on-surface hover:border-primary focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface motion-reduce:transition-none">
          {t('home.view_all_articles')}
        </a>
      </div>
    </div>
    <div class="relative min-h-60 overflow-hidden rounded-3xl border border-border shadow-xl shadow-primary/5 dark:border-dark-border sm:min-h-80 lg:min-h-[390px]">
      <img src="/images/portfolio-landscape.svg" alt="" width="1200" height="740" class="absolute inset-0 h-full w-full object-cover dark:brightness-75" aria-hidden="true" />
      <div class="absolute bottom-5 left-5 rounded-xl border border-white/50 bg-white/85 px-4 py-3 text-xs font-bold uppercase tracking-wider text-[#193741] shadow-sm backdrop-blur-sm dark:border-white/10 dark:bg-[#10262b]/85 dark:text-teal-100">{lang === 'es' ? 'ArceApps / Software independiente' : 'ArceApps / Independent software'}</div>
    </div>
  </div>
  <div class="relative mx-auto mt-10 grid w-full max-w-7xl grid-cols-2 gap-3 lg:grid-cols-4">
    {[
      { icon: 'android', es: 'Apps Android', en: 'Android apps' },
      { icon: 'psychology', es: 'Herramientas de IA', en: 'AI tools' },
      { icon: 'code', es: 'Proyectos abiertos', en: 'Open projects' },
      { icon: 'article', es: 'Contenido técnico', en: 'Technical writing' }
    ].map((item) => (
      <div class="flex items-center gap-3 rounded-2xl border border-border bg-surface-raised p-4 shadow-sm dark:border-dark-border dark:bg-dark-surface-raised">
        <span class="material-icons rounded-lg bg-primary/10 p-2 text-primary dark:text-teal-300" aria-hidden="true">{item.icon}</span>
        <span class="text-sm font-semibold leading-tight text-on-surface dark:text-dark-on-surface">{lang === 'es' ? item.es : item.en}</span>
      </div>
    ))}
  </div>
  <a href="#section-work" class="home-hero-scroll mx-auto mt-10 flex h-10 w-10 items-center justify-center rounded-full border border-border text-on-surface-variant hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:text-dark-on-surface-variant" aria-label={t('home.scroll_hint')}>
    <span class="material-icons text-2xl" aria-hidden="true">keyboard_arrow_down</span>
  </a>
</section>
