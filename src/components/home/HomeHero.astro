---
import { Image } from "astro:assets";
import heroImg from "../../assets/hero-mountain-sunset.jpg";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const quickAccessPills = [
  {
    icon: 'android',
    label: lang === 'es' ? 'Apps Android' : 'Android Apps',
    href: lang === 'es' ? '/es/apps' : '/apps',
    iconColor: 'text-emerald-600 dark:text-emerald-400',
    iconBg: 'bg-emerald-500/10 dark:bg-emerald-500/20',
  },
  {
    icon: 'psychology',
    label: lang === 'es' ? 'Herramientas de IA' : 'AI Tools',
    href: lang === 'es' ? '/es/projects' : '/projects',
    iconColor: 'text-cyan-600 dark:text-cyan-400',
    iconBg: 'bg-cyan-500/10 dark:bg-cyan-500/20',
  },
  {
    icon: 'code',
    label: lang === 'es' ? 'Proyectos open source' : 'Open source projects',
    href: lang === 'es' ? '/es/projects' : '/projects',
    iconColor: 'text-amber-600 dark:text-amber-400',
    iconBg: 'bg-amber-500/10 dark:bg-amber-500/20',
  },
  {
    icon: 'menu_book',
    label: lang === 'es' ? 'Contenido técnico' : 'Technical content',
    href: lang === 'es' ? '/es/blog' : '/blog',
    iconColor: 'text-blue-600 dark:text-blue-400',
    iconBg: 'bg-blue-500/10 dark:bg-blue-500/20',
  },
];
---

<section
  class="home-hero relative isolate overflow-hidden"
  aria-labelledby="home-hero-title"
>
  <!-- Foto a sangre con overlay degradado para legibilidad del texto -->
  <Image
    src={heroImg}
    alt={lang === 'es' ? 'Montañas al atardecer' : 'Mountains at sunset'}
    class="absolute inset-0 -z-10 h-full w-full object-cover"
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    quality={70}
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-surface/95 via-surface/55 to-surface/5 dark:from-dark-surface/95 dark:via-dark-surface/55 dark:to-dark-surface/5"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-y-0 left-0 -z-10 w-3/4 bg-gradient-to-r from-surface/60 via-surface/20 to-transparent dark:from-dark-surface/60 dark:via-dark-surface/20 dark:to-transparent lg:w-2/3"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-5xl px-4 pt-20 pb-24 sm:px-6 sm:pt-28 sm:pb-32 lg:px-8">
    <span class="sr-only">ArceApps</span>

    <!-- Badge superior sutil con indicador verde/teal -->
    <div class="inline-flex items-center gap-2 rounded-full border border-border/80 bg-surface px-3.5 py-1.5 text-xs font-semibold tracking-wide text-on-surface-variant shadow-xs dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant">
      <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
      <span>{lang === 'es' ? 'DESARROLLO · ANDROID · IA · PROYECTOS' : 'DEVELOPMENT · ANDROID · AI · PROJECTS'}</span>
    </div>

    <!-- Titular principal de gran impacto -->
    <h1
      id="home-hero-title"
      class="home-hero-title mt-6 max-w-3xl text-4xl font-extrabold tracking-tight text-content dark:text-dark-content sm:text-5xl lg:text-6xl leading-[1.12]"
    >
      {lang === 'es' ? 'Software independiente que resuelve problemas reales' : 'Independent software solving real problems'}
    </h1>

    <!-- Párrafo explicativo -->
    <p class="home-hero-manifesto mt-6 max-w-2xl text-lg sm:text-xl leading-relaxed text-content-muted dark:text-dark-content-muted">
      {t('home.manifesto')}
    </p>

    <!-- CTAs de la maqueta -->
    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a
        href={lang === 'es' ? '/es/projects' : '/projects'}
        class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-strong focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30"
      >
        {lang === 'es' ? 'Explorar proyectos' : 'Explore projects'}
        <span aria-hidden="true">&rarr;</span>
      </a>
      <a
        href={lang === 'es' ? '/es/blog' : '/blog'}
        class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-6 py-3 text-sm font-semibold text-content shadow-xs transition hover:border-primary/50 hover:shadow-sm focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-content"
      >
        {lang === 'es' ? 'Leer artículos' : 'Read articles'}
      </a>
    </div>

    <!-- Fila de 4 Quick Access Pills / Chips horizontales -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      {quickAccessPills.map((pill) => (
        <a
          href={pill.href}
          class="group inline-flex items-center gap-2.5 rounded-xl border border-border bg-surface px-4 py-2.5 text-sm font-semibold text-on-surface shadow-xs transition hover:border-primary/50 hover:shadow-sm focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface dark:hover:border-primary/50"
        >
          <span class:list={["flex h-7 w-7 items-center justify-center rounded-lg transition-transform duration-200 group-hover:scale-110", pill.iconBg, pill.iconColor]}>
            <span class="material-icons text-lg" aria-hidden="true">{pill.icon}</span>
          </span>
          <span class="transition-colors group-hover:text-primary dark:group-hover:text-primary">
            {pill.label}
          </span>
        </a>
      ))}
    </div>

    <!-- Scroll Down Hint -->
    <div class="mt-12 flex justify-center">
      <a
        href="#section-work"
        class="home-hero-scroll flex h-10 w-10 items-center justify-center rounded-full border border-border bg-surface text-on-surface-variant shadow-xs transition hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant dark:hover:border-primary dark:hover:text-primary"
        aria-label={t('home.scroll_hint')}
      >
        <span class="material-icons text-xl" aria-hidden="true">keyboard_arrow_down</span>
      </a>
    </div>
  </div>
</section>
