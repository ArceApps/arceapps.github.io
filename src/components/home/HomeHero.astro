---
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const quickAccessPills = [
  {
    icon: 'android',
    label: lang === 'es' ? 'Apps Android' : 'Android Apps',
    href: lang === 'es' ? '/es/apps' : '/apps',
    iconColor: 'text-emerald-600 dark:text-emerald-400',
    iconBg: 'bg-emerald-500/10 dark:bg-emerald-500/20',
  },
  {
    icon: 'psychology',
    label: lang === 'es' ? 'Herramientas de IA' : 'AI Tools',
    href: lang === 'es' ? '/es/projects' : '/projects',
    iconColor: 'text-cyan-600 dark:text-cyan-400',
    iconBg: 'bg-cyan-500/10 dark:bg-cyan-500/20',
  },
  {
    icon: 'code',
    label: lang === 'es' ? 'Proyectos open source' : 'Open source projects',
    href: lang === 'es' ? '/es/projects' : '/projects',
    iconColor: 'text-amber-600 dark:text-amber-400',
    iconBg: 'bg-amber-500/10 dark:bg-amber-500/20',
  },
  {
    icon: 'menu_book',
    label: lang === 'es' ? 'Contenido técnico' : 'Technical content',
    href: lang === 'es' ? '/es/blog' : '/blog',
    iconColor: 'text-blue-600 dark:text-blue-400',
    iconBg: 'bg-blue-500/10 dark:bg-blue-500/20',
  },
];
---

<section
  class="home-hero relative isolate px-4 pt-12 pb-16 sm:px-6 sm:pt-16 sm:pb-20 lg:px-8 max-w-5xl mx-auto text-center"
  aria-labelledby="home-hero-title"
>
  <span class="sr-only">ArceApps</span>

  <!-- Badge superior sutil con indicador verde/teal -->
  <div class="inline-flex items-center gap-2 rounded-full border border-border/80 bg-white px-3.5 py-1.5 text-xs font-semibold tracking-wide text-on-surface-variant shadow-xs dark:border-[#1F333E] dark:bg-[#111E26] dark:text-dark-on-surface-variant">
    <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
    <span>{lang === 'es' ? 'DESARROLLO · ANDROID · IA · PROYECTOS' : 'DEVELOPMENT · ANDROID · AI · PROJECTS'}</span>
  </div>

  <!-- Titular principal de gran impacto -->
  <h1
    id="home-hero-title"
    class="home-hero-title mt-6 text-4xl font-extrabold tracking-tight text-on-surface dark:text-dark-on-surface sm:text-5xl lg:text-6xl leading-[1.12]"
  >
    {lang === 'es' ? 'Software independiente que resuelve problemas reales' : 'Independent software solving real problems'}
  </h1>

  <!-- Párrafo explicativo -->
  <p class="home-hero-manifesto mx-auto mt-6 max-w-2xl text-lg sm:text-xl leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
    {t('home.manifesto')}
  </p>

  <!-- Fila de 4 Quick Access Pills / Chips horizontales -->
  <div class="mt-10 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
    {quickAccessPills.map((pill) => (
      <a
        href={pill.href}
        class="group inline-flex items-center gap-2.5 rounded-xl border border-border bg-white px-4 py-2.5 text-sm font-semibold text-on-surface shadow-xs transition hover:border-primary/50 hover:shadow-sm focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 dark:border-[#1F333E] dark:bg-[#111E26] dark:text-dark-on-surface dark:hover:border-teal-400/50"
      >
        <span class:list={["flex h-7 w-7 items-center justify-center rounded-lg transition-transform duration-200 group-hover:scale-110", pill.iconBg, pill.iconColor]}>
          <span class="material-icons text-lg" aria-hidden="true">{pill.icon}</span>
        </span>
        <span class="transition-colors group-hover:text-primary dark:group-hover:text-teal-300">
          {pill.label}
        </span>
      </a>
    ))}
  </div>

  <!-- Scroll Down Hint -->
  <div class="mt-12 flex justify-center">
    <a
      href="#section-work"
      class="home-hero-scroll flex h-10 w-10 items-center justify-center rounded-full border border-border bg-white text-on-surface-variant shadow-xs transition hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-[#1F333E] dark:bg-[#111E26] dark:text-dark-on-surface-variant dark:hover:border-teal-400 dark:hover:text-teal-300"
      aria-label={t('home.scroll_hint')}
    >
      <span class="material-icons text-xl" aria-hidden="true">keyboard_arrow_down</span>
    </a>
  </div>
</section>
