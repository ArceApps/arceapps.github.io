---
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<header class="mx-auto mb-12 max-w-3xl text-center">
  {eyebrow && (
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-primary dark:text-dark-focus">
      {eyebrow}
    </p>
  )}
  <h1 class="text-4xl font-bold tracking-tight text-on-surface dark:text-dark-on-surface md:text-5xl">
    {title}
  </h1>
  <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
    {description}
  </p>
</header>
