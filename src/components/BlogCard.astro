---
import type { CollectionEntry } from "astro:content";
import { slugify } from "../utils/slugs";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Card from "./Card.astro";

interface Props {
  post: CollectionEntry<"blog">;
  list?: boolean;
}

const { post, list = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Estimate reading time from post.body
const readingTime = Math.max(1, Math.ceil((post.body || "").split(/\s+/g).length / 200));

// Short date format (e.g. '12 oct 2026' in ES, 'Oct 12, 2026' in EN)
const formattedDate = post.data.pubDate.toLocaleDateString(lang === 'es' ? "es-ES" : "en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const slug = post.slug.split('/').pop();
const href = lang === 'es' ? `/es/blog/${slug}/` : `/blog/${slug}/`;
const firstTag = post.data.tags?.[0];
---

<Card
  variant="article"
  class={list ? "sm:flex sm:flex-row sm:items-center gap-5 p-4 sm:p-5" : "flex flex-col p-4 sm:p-5"}
>
  <a
    href={href}
    data-astro-prefetch
    class="absolute inset-0 z-10 rounded-2xl focus-visible:ring-4 focus-visible:ring-primary/50 focus-visible:outline-none transition-shadow motion-reduce:transition-none"
    aria-label={`${t('common.read_more')} ${post.data.title}`}
  ></a>

  {
    list ? (
      <>
        {post.data.heroImage ? (
          <div class="aspect-video w-full sm:w-56 md:w-64 sm:shrink-0 rounded-xl overflow-hidden bg-gray-100 dark:bg-gray-800">
            <img
              src={post.data.heroImage}
              alt={post.data.title}
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
              width="800"
              height="450"
            />
          </div>
        ) : (
          <div
            class="aspect-video w-full sm:w-56 md:w-64 sm:shrink-0 rounded-xl overflow-hidden bg-surface-variant/40 dark:bg-dark-surface-subtle flex items-center justify-center text-on-surface-variant/40 dark:text-dark-on-surface-variant/40"
            aria-hidden="true"
          >
            <span class="material-icons text-4xl">article</span>
          </div>
        )}

        <div class="min-w-0 flex-1 flex flex-col justify-center mt-3 sm:mt-0">
          <h3 class="text-lg md:text-xl font-bold text-on-surface dark:text-dark-on-surface group-hover:text-primary transition-colors motion-reduce:transition-none line-clamp-2">
            {post.data.title}
          </h3>

          <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant line-clamp-2 mt-1.5 leading-relaxed">
            {post.data.description}
          </p>

          <div class="mt-3 flex flex-wrap items-center gap-2.5 text-xs text-on-surface-variant/80 dark:text-dark-on-surface-variant/80">
            <span>{formattedDate} · {readingTime} min</span>
            {firstTag && (
              <a
                href={lang === 'es' ? `/es/blog/tag/${slugify(firstTag)}/` : `/blog/tag/${slugify(firstTag)}/`}
                data-astro-prefetch
                class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary dark:text-teal-300 text-xs font-semibold hover:bg-primary/20 transition-colors motion-reduce:transition-none relative z-30 pointer-events-auto focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
              >
                {firstTag}
              </a>
            )}
          </div>
        </div>
      </>
    ) : (
      <>
        {post.data.heroImage ? (
          <div class="aspect-video w-full rounded-xl overflow-hidden bg-gray-100 dark:bg-gray-800">
            <img
              src={post.data.heroImage}
              alt={post.data.title}
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
              width="800"
              height="450"
            />
          </div>
        ) : (
          <div
            class="aspect-video w-full rounded-xl overflow-hidden bg-surface-variant/40 dark:bg-dark-surface-subtle flex items-center justify-center text-on-surface-variant/40 dark:text-dark-on-surface-variant/40"
            aria-hidden="true"
          >
            <span class="material-icons text-4xl">article</span>
          </div>
        )}

        <div class="mt-3.5 flex flex-col flex-1">
          {firstTag && (
            <div class="mb-2">
              <a
                href={lang === 'es' ? `/es/blog/tag/${slugify(firstTag)}/` : `/blog/tag/${slugify(firstTag)}/`}
                data-astro-prefetch
                class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary dark:text-teal-300 text-xs font-semibold hover:bg-primary/20 transition-colors motion-reduce:transition-none relative z-30 pointer-events-auto focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none"
              >
                {firstTag}
              </a>
            </div>
          )}

          <h3 class="text-base sm:text-lg font-bold text-on-surface dark:text-dark-on-surface group-hover:text-primary transition-colors motion-reduce:transition-none line-clamp-2 mb-2">
            {post.data.title}
          </h3>

          <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant line-clamp-2 mb-4 flex-grow leading-relaxed">
            {post.data.description}
          </p>

          <div class="text-xs text-on-surface-variant/80 dark:text-dark-on-surface-variant/80 mt-auto">
            {formattedDate} · {readingTime} min
          </div>
        </div>
      </>
    )
  }
</Card>
