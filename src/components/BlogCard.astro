---
import type { CollectionEntry } from "astro:content";
import { slugify } from "../utils/slugs";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Card from "./Card.astro";

interface Props {
  post: CollectionEntry<"blog">;
  list?: boolean;
  readingTime?: number;
}

const { post, list = false, readingTime: readingTimeProp } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Estimate reading time from post.body (words / 200), unless the caller provides it.
const wordCount = (post.body || "").trim().split(/\s+/g).filter(Boolean).length;
const readingTime = readingTimeProp ?? Math.max(1, Math.ceil(wordCount / 200));
const readingTimeLabel = t("blog.reading_time_short").replace("{min}", String(readingTime));

// Short date format (e.g. '12 oct 2026' in ES, 'Oct 12, 2026' in EN)
const formattedDate = post.data.pubDate.toLocaleDateString(lang === "es" ? "es-ES" : "en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const isoDate = post.data.pubDate.toISOString();

const coverAlt = t("blog.cover_alt").replace("{title}", post.data.title);

const slug = post.slug.split("/").pop();
const href = lang === "es" ? `/es/blog/${slug}/` : `/blog/${slug}/`;
const firstTag = post.data.tags?.[0];
const tagHref = firstTag
  ? lang === "es"
    ? `/es/blog/tag/${slugify(firstTag)}/`
    : `/blog/tag/${slugify(firstTag)}/`
  : undefined;
---

<Card
  variant="article"
  class={list ? "p-4 sm:p-5" : "p-5 flex flex-col"}
>
  <a
    href={href}
    data-astro-prefetch
    class="absolute inset-0 z-10 rounded-2xl focus-visible:ring-4 focus-visible:ring-focus/50 focus-visible:outline-none transition-shadow motion-reduce:transition-none"
    aria-label={`${t("common.read_more")} ${post.data.title}`}
  ></a>

  {
    list ? (
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
        <div class="relative w-full sm:w-48 sm:flex-shrink-0">
          {post.data.heroImage ? (
            <img
              src={post.data.heroImage}
              alt={coverAlt}
              class="aspect-video w-full rounded-xl object-cover bg-surface-subtle dark:bg-dark-surface-subtle"
              loading="lazy"
              decoding="async"
              width="384"
              height="216"
            />
          ) : (
            <div
              class="flex aspect-video w-full items-center justify-center rounded-xl overflow-hidden bg-surface-subtle text-content-muted/40 dark:bg-dark-surface-subtle dark:text-dark-content-muted/40"
              aria-hidden="true"
            >
              <span class="material-icons text-4xl">article</span>
            </div>
          )}

          {firstTag && (
            <a
              href={tagHref}
              data-astro-prefetch
              class="absolute left-3 top-3 z-20 inline-flex items-center rounded-full border border-border bg-surface-raised/90 px-2.5 py-0.5 text-xs font-semibold text-content backdrop-blur-sm transition-colors motion-reduce:transition-none hover:text-primary focus-visible:ring-2 focus-visible:ring-focus focus-visible:outline-none dark:border-dark-border dark:bg-dark-surface-raised/90 dark:text-dark-content dark:hover:text-primary"
            >
              #{firstTag}
            </a>
          )}
        </div>

        <div class="min-w-0 flex-1">
          <h3 class="font-semibold text-content line-clamp-2 leading-snug transition-colors motion-reduce:transition-none group-hover:text-primary dark:text-dark-content dark:group-hover:text-primary">
            {post.data.title}
          </h3>

          <p class="mt-2 text-sm text-content-muted line-clamp-2 leading-relaxed dark:text-dark-content-muted">
            {post.data.description}
          </p>

          <p class="mt-3 text-xs text-content-muted dark:text-dark-content-muted">
            <time datetime={isoDate}>{formattedDate}</time>
            <span aria-hidden="true"> · </span>
            <span>{readingTimeLabel}</span>
          </p>
        </div>
      </div>
    ) : (
      <>
        <div class="relative">
          {post.data.heroImage ? (
            <img
              src={post.data.heroImage}
              alt={coverAlt}
              class="aspect-video w-full rounded-xl object-cover bg-surface-subtle dark:bg-dark-surface-subtle"
              loading="lazy"
              decoding="async"
              width="800"
              height="450"
            />
          ) : (
            <div
              class="flex aspect-video w-full items-center justify-center rounded-xl overflow-hidden bg-surface-subtle text-content-muted/40 dark:bg-dark-surface-subtle dark:text-dark-content-muted/40"
              aria-hidden="true"
            >
              <span class="material-icons text-4xl">article</span>
            </div>
          )}

          {firstTag && (
            <a
              href={tagHref}
              data-astro-prefetch
              class="absolute left-3 top-3 z-20 inline-flex items-center rounded-full border border-border bg-surface-raised/90 px-2.5 py-0.5 text-xs font-semibold text-content backdrop-blur-sm transition-colors motion-reduce:transition-none hover:text-primary focus-visible:ring-2 focus-visible:ring-focus focus-visible:outline-none dark:border-dark-border dark:bg-dark-surface-raised/90 dark:text-dark-content dark:hover:text-primary"
            >
              #{firstTag}
            </a>
          )}
        </div>

        <div class="mt-4 flex flex-1 flex-col">
          <h3 class="text-base font-semibold text-content line-clamp-2 leading-snug transition-colors motion-reduce:transition-none group-hover:text-primary dark:text-dark-content dark:group-hover:text-primary">
            {post.data.title}
          </h3>

          <p class="mt-2 flex-grow text-sm text-content-muted line-clamp-2 leading-relaxed dark:text-dark-content-muted">
            {post.data.description}
          </p>

          <p class="mt-3 text-xs text-content-muted dark:text-dark-content-muted">
            <time datetime={isoDate}>{formattedDate}</time>
            <span aria-hidden="true"> · </span>
            <span>{readingTimeLabel}</span>
          </p>
        </div>
      </>
    )
  }
</Card>
