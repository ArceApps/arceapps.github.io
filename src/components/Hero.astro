---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="bg-surface py-20 dark:bg-dark-surface lg:py-28">
  <div class="container mx-auto px-4">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="text-center lg:col-span-7 lg:text-left">
        <div class="mb-8 inline-flex items-center gap-3 rounded-full border border-primary/25 bg-surface-raised px-4 py-2 dark:border-primary/40 dark:bg-dark-surface-raised">
          <span class="h-2.5 w-2.5 rounded-full bg-secondary" aria-hidden="true"></span>
          <span class="text-sm font-semibold uppercase tracking-wider text-primary dark:text-teal-400">
            {t('home.hero.eyebrow')}
          </span>
        </div>

        <h1 class="mb-6 text-5xl font-bold leading-[1.08] tracking-tight text-on-surface dark:text-dark-on-surface md:text-6xl lg:text-7xl">
          <span class="block text-primary dark:text-teal-400">{t('home.hero.prefix')}</span>
          <span class="block">{t('home.hero.title')}</span>
        </h1>

        <p class="mx-auto mb-10 max-w-xl text-lg leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant md:text-xl lg:mx-0">
          {t('home.hero.subtitle')}
        </p>

        <div class="flex flex-col justify-center gap-4 sm:flex-row lg:justify-start">
          <a
            href="#apps"
            data-astro-prefetch
            class="inline-flex items-center justify-center rounded-2xl bg-primary px-8 py-4 text-lg font-bold text-white transition-colors duration-200 hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 motion-reduce:transition-none"
          >
            <span class="material-icons mr-2 text-xl" aria-hidden="true">apps</span>
            {t('home.view_all_apps')}
          </a>
          <a
            href={lang === 'es' ? '/es/devlog' : '/devlog'}
            data-astro-prefetch
            class="inline-flex items-center justify-center rounded-2xl border border-border bg-surface-raised px-8 py-4 text-lg font-semibold text-on-surface transition-colors duration-200 hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 motion-reduce:transition-none dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface dark:hover:border-teal-400 dark:hover:text-teal-400"
          >
            <span class="material-icons mr-2 text-xl" aria-hidden="true">article</span>
            {t('nav.devlog')}
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="mx-auto max-w-md rounded-3xl border border-border bg-surface-raised p-6 dark:border-dark-border dark:bg-dark-surface-raised md:p-8">
          <div class="grid aspect-[4/3] grid-cols-5 grid-rows-4 gap-3" aria-hidden="true">
            <div class="col-span-3 row-span-2 rounded-2xl bg-primary"></div>
            <div class="col-span-2 row-span-3 rounded-2xl border-2 border-secondary bg-surface dark:bg-dark-surface"></div>
            <div class="col-span-2 row-span-2 rounded-2xl border border-primary/30 bg-primary/10"></div>
            <div class="col-span-3 rounded-2xl bg-secondary"></div>
          </div>
          <p class="mt-6 border-l-4 border-secondary pl-4 text-sm font-semibold uppercase tracking-wider text-on-surface-variant dark:text-dark-on-surface-variant">
            {t('home.hero.note')}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
