---
import Layout from "../../layouts/Layout.astro";
import HomeHero from "../home/HomeHero.astro";
import HomeDevlog from "../home/HomeDevlog.astro";
import HomeBlog from "../home/HomeBlog.astro";
import HomeFeaturedWork from "../home/HomeFeaturedWork.astro";
import HomeCta from "../home/HomeCta.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/utils";
import { isPublished } from "../../utils/publishing";

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const prefix = lang === 'es' ? 'es/' : 'en/';
const linkPrefix = lang === 'es' ? '/es' : '';

// Fetch all collections concurrently
const [rawBlog, rawDevlog, rawApps, rawProjects] = await Promise.all([
  getCollection("blog"),
  getCollection("devlog"),
  getCollection("apps"),
  getCollection("projects")
]);

// Get latest blog posts
const allPosts = rawBlog
  .filter(({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith(prefix))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Get latest devlog entry
const latestDevlog = rawDevlog
  .filter(({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith(prefix))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

// Get featured apps and projects
const apps = rawApps
  .filter(({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith(prefix))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const projects = rawProjects.filter(({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith(prefix));
const recentWork = [
  ...apps.map((app) => ({ type: 'app' as const, entry: app, pubDate: app.data.pubDate })),
  ...projects.map((project) => ({ type: 'project' as const, entry: project, pubDate: project.data.pubDate })),
].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf()).slice(0, 3);

// A consciously curated flagship: portfolio quality should not depend on publish dates.
const flagship = apps.find((app) => app.slug.split('/').pop() === 'radiohub');
const primaryWork = flagship ? { type: 'app' as const, entry: flagship } : recentWork[0];
const featuredWork = primaryWork
  ? {
      title: primaryWork.entry.data.title,
      description: primaryWork.entry.data.description,
      href: `${linkPrefix}/${primaryWork.type === 'project' ? 'projects' : 'apps'}/${primaryWork.entry.slug.split('/').pop() || ''}`,
      heroImage: primaryWork.entry.data.heroImage,
      kind: primaryWork.type,
      realIconUrl: primaryWork.type === 'app' && 'realIconUrl' in primaryWork.entry.data ? (primaryWork.entry.data as { realIconUrl?: string }).realIconUrl : undefined,
      tags: primaryWork.entry.data.tags,
      screenshots: primaryWork.type === 'app' && 'screenshots' in primaryWork.entry.data ? primaryWork.entry.data.screenshots : undefined,
    }
  : undefined;
---

<Layout title={lang === 'es' ? "ArceApps - Software independiente, Android e IA" : "ArceApps - Independent Software, Android & AI"}>
  {lang === 'en' && (
    <script is:inline>
        if (typeof localStorage !== 'undefined' && !localStorage.getItem('lang-preference')) {
          const lang = navigator.language || navigator.userLanguage;
          if (lang && lang.startsWith('es')) {
              window.location.href = '/es/';
          }
        }
    </script>
  )}

  <HomeHero lang={lang} />
  <HomeFeaturedWork lang={lang} featuredWork={featuredWork} />
  <HomeBlog lang={lang} linkPrefix={linkPrefix} posts={allPosts} />
  <HomeDevlog lang={lang} latestDevlog={latestDevlog} />
  <HomeCta lang={lang} />
</Layout>
