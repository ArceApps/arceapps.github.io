---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import BlogCard from "../../components/BlogCard.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Card from "../../components/Card.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Helper for prefixes
const prefix = lang === 'es' ? 'es/' : 'en/';
const linkPrefix = lang === 'es' ? '/es' : '';

// Get latest blog posts
const allPosts = (await getCollection("blog", ({ data, id }) => !data.draft && data.pubDate <= new Date() && id.startsWith(prefix)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Get latest devlog entry
const latestDevlog = (await getCollection("devlog", ({ data, id }) => !data.draft && data.pubDate <= new Date() && id.startsWith(prefix)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

// Get featured apps
const apps = (await getCollection("apps", ({ data, id }) => !data.draft && id.startsWith(prefix)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const devlogSlug = latestDevlog ? latestDevlog.slug.split('/').pop() : '';
---

<Layout title={lang === 'es' ? "ArceApps - Apps Android Premium" : "ArceApps - Premium Android Apps"}>
  <!-- Language Detection Script (Only on English/Root page) -->
  {lang === 'en' && (
    <script is:inline>
        // Detect language and redirect if Spanish
        // Only redirect if no preference is set and browser is Spanish
        if (typeof localStorage !== 'undefined' && !localStorage.getItem('lang-preference')) {
        const lang = navigator.language || navigator.userLanguage;
        if (lang && lang.startsWith('es')) {
            window.location.href = '/es/';
        }
        }
    </script>
  )}

  <Hero />

  <!-- Apps & Devlog -->
  <section id="apps" class="bg-surface py-24 dark:bg-dark-surface cv-auto fade-in-section" style="contain-intrinsic-size: 800px;">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto mb-20">
        <h2 class="text-4xl md:text-5xl font-black mb-6 text-on-surface dark:text-dark-on-surface tracking-tight">
          {t('home.building')}
        </h2>
        <p class="text-lg md:text-xl text-on-surface-variant dark:text-dark-on-surface-variant leading-relaxed">
          {t('home.building_desc')}
        </p>
      </div>

      {latestDevlog && (
        <div class="mx-auto mb-16 max-w-5xl">
          <Card variant="feature" class="p-8 md:p-10">
            <div class="flex h-full flex-col justify-between">
              <div>
                <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/10 px-4 py-1.5">
                  <span class="h-2.5 w-2.5 rounded-full bg-secondary" aria-hidden="true"></span>
                  <span class="text-xs font-bold uppercase tracking-wider text-primary dark:text-teal-400">
                    {t('home.building_public')}
                  </span>
                </div>

                <h3 class="mb-4 text-3xl font-extrabold text-on-surface dark:text-dark-on-surface md:text-4xl">
                  {latestDevlog.data.title}
                </h3>

                <p class="mb-8 text-base leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant md:text-lg">
                  {latestDevlog.data.description}
                </p>
              </div>

              <div class="flex flex-col gap-5 border-t border-border pt-6 dark:border-dark-border sm:flex-row sm:items-center sm:justify-between">
                <span class="text-sm font-semibold text-on-surface-variant dark:text-dark-on-surface-variant">
                  {latestDevlog.data.pubDate.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US')}
                </span>
                <a
                  href={`${linkPrefix}/devlog/${devlogSlug}`}
                  class="inline-flex items-center justify-center rounded-2xl bg-primary px-6 py-3 text-sm font-bold text-white transition-colors duration-200 hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 motion-reduce:transition-none"
                >
                  {t('home.read_entry')}
                  <span class="material-icons ml-2 text-sm" aria-hidden="true">arrow_forward</span>
                </a>
              </div>
            </div>
          </Card>
        </div>
      )}

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {apps.map(app => (
          <div class="h-full">
            <ProjectCard
              title={app.data.title}
              description={app.data.description}
              heroImage={app.data.heroImage}
              realIconUrl={app.data.realIconUrl}
              tags={app.data.tags}
              pubDate={app.data.pubDate}
              slug={app.slug.split('/').pop() || ''}
            />
          </div>
        ))}
      </div>

      <div class="mt-16 text-center">
        <a href={`${linkPrefix}/apps`} class="inline-flex items-center justify-center rounded-2xl border-2 border-primary px-10 py-4 text-lg font-bold text-primary transition-colors duration-200 hover:bg-primary hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 motion-reduce:transition-none">
          {t('home.view_all_apps')}
        </a>
      </div>
    </div>
  </section>

  <!-- Blog Section -->
  <section class="py-24 bg-surface dark:bg-dark-surface cv-auto fade-in-section" style="contain-intrinsic-size: 600px;">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div class="text-left">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-on-surface dark:text-dark-on-surface">{t('home.tech_articles')}</h2>
          <p class="text-lg text-on-surface-variant dark:text-dark-on-surface-variant max-w-2xl">
            {t('home.tech_articles_desc')}
          </p>
        </div>
        <a href={`${linkPrefix}/blog`} class="inline-flex items-center font-medium text-primary hover:text-secondary rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:text-secondary transition-colors group">
          {t('home.view_all_articles')}
          <span class="material-icons ml-1 transform group-hover:translate-x-1 transition-transform" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {allPosts.map(post => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-y-4 border-secondary bg-primary py-20 cv-auto fade-in-section" style="contain-intrinsic-size: 300px;">
    <div class="container mx-auto px-4 text-center text-white">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">{t('home.explore_code')}</h2>
      <p class="text-xl opacity-90 mb-10 max-w-2xl mx-auto">
        {t('home.explore_code_desc')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://github.com/arceapps" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-2xl bg-white px-8 py-4 text-lg font-bold text-primary transition-colors duration-200 hover:bg-gray-100 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-white/60 motion-reduce:transition-none">
          <span class="material-icons mr-2" aria-hidden="true">code</span>
          {t('home.view_github')}
        </a>
        <a href="https://play.google.com/store/apps/developer?id=Arce+Apps" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-2xl border-2 border-secondary bg-primary-strong px-8 py-4 text-lg font-bold text-white transition-colors duration-200 hover:bg-primary-strong/80 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-white/60 motion-reduce:transition-none">
          <span class="material-icons mr-2" aria-hidden="true">shop</span>
          {t('home.google_play')}
        </a>
      </div>
    </div>
  </section>

</Layout>
