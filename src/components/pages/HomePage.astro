---
import Layout from "../../layouts/Layout.astro";
import HomeHero from "../home/HomeHero.astro";
import HomeFeaturedWork from "../home/HomeFeaturedWork.astro";
import HomeBlog from "../home/HomeBlog.astro";
import HomeDevlog from "../home/HomeDevlog.astro";
import HomeCta from "../home/HomeCta.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/utils";
import { isPublished } from "../../utils/publishing";

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const prefix = lang === 'es' ? 'es/' : 'en/';
const linkPrefix = lang === 'es' ? '/es' : '';

// Fetch all collections concurrently
const [rawBlog, rawDevlog, rawApps, rawProjects] = await Promise.all([
  getCollection("blog"),
  getCollection("devlog"),
  getCollection("apps"),
  getCollection("projects")
]);

// Get latest blog posts
const allPosts = rawBlog
  .filter(({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith(prefix))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Get latest devlogs
const devlogs = rawDevlog
  .filter(({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith(prefix))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const latestDevlog = devlogs[0];

// Get featured apps and projects
const apps = rawApps
  .filter(({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith(prefix))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const projects = rawProjects.filter(({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith(prefix));

// Map all apps into featuredItems
const featuredItems = apps.map((app) => ({
  title: app.data.title,
  description: app.data.description,
  href: `${linkPrefix}/apps/${app.slug.split('/').pop() || ''}`,
  heroImage: app.data.heroImage,
  kind: 'app' as const,
  realIconUrl: ('realIconUrl' in app.data && (app.data as { realIconUrl?: string }).realIconUrl) || (app.slug.split('/').pop() === 'radiohub' ? '/images/apps/radiohub/logo.png' : undefined),
  googlePlayUrl: 'googlePlayUrl' in app.data ? (app.data as { googlePlayUrl?: string }).googlePlayUrl : undefined,
  repoUrl: 'repoUrl' in app.data ? (app.data as { repoUrl?: string }).repoUrl : undefined,
  tags: app.data.tags,
  screenshots: 'screenshots' in app.data ? (app.data as { screenshots?: string[] }).screenshots : undefined,
}));

// A consciously curated flagship: portfolio quality should not depend on publish dates.
const flagship = apps.find((app) => app.slug.split('/').pop() === 'radiohub');
const primaryApp = flagship || apps[0];
const featuredWork = primaryApp
  ? {
      title: primaryApp.data.title,
      description: primaryApp.data.description,
      href: `${linkPrefix}/apps/${primaryApp.slug.split('/').pop() || ''}`,
      heroImage: primaryApp.data.heroImage,
      kind: 'app' as const,
      realIconUrl: (flagship && 'realIconUrl' in flagship.data && (flagship.data as { realIconUrl?: string }).realIconUrl) || '/images/apps/radiohub/logo.png',
      googlePlayUrl: 'googlePlayUrl' in primaryApp.data ? (primaryApp.data as { googlePlayUrl?: string }).googlePlayUrl : undefined,
      repoUrl: 'repoUrl' in primaryApp.data ? (primaryApp.data as { repoUrl?: string }).repoUrl : undefined,
      tags: primaryApp.data.tags,
      screenshots: 'screenshots' in primaryApp.data ? (primaryApp.data as { screenshots?: string[] }).screenshots : undefined,
    }
  : undefined;
---

<Layout title={lang === 'es' ? "ArceApps - Software independiente, Android e IA" : "ArceApps - Independent Software, Android & AI"}>
  {lang === 'en' && (
    <script is:inline>
        if (typeof localStorage !== 'undefined' && !localStorage.getItem('lang-preference')) {
          const lang = navigator.language || navigator.userLanguage;
          if (lang && lang.startsWith('es')) {
              window.location.href = '/es/';
          }
        }
    </script>
  )}

  <HomeHero lang={lang} />
  <HomeFeaturedWork lang={lang} featuredWork={featuredWork} featuredItems={featuredItems} />
  <HomeBlog lang={lang} linkPrefix={linkPrefix} posts={allPosts} devlogs={devlogs} />
  <HomeDevlog lang={lang} latestDevlog={latestDevlog} />
  <HomeCta lang={lang} />
</Layout>
