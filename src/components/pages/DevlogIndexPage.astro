---
import Layout from "../../layouts/Layout.astro";
import PageIntro from "../PageIntro.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/utils";
import { isPublished } from "../../utils/publishing";

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const devlogs = (await getCollection("devlog", ({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith(`${lang}/`))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const defaultImage = "/images/devlog-default.svg";

// Helper for date formatting
const localeString = lang === 'es' ? 'es-ES' : 'en-US';

// Helper for alt text
const getCoverAlt = (title: string) => t('devlog.cover_alt').replace('{title}', title);

// Helper for link prefix
const linkPrefix = lang === 'es' ? '/es/devlog' : '/devlog';

// Broad editorial topics are inferred from published titles/tags; no extra content metadata required.
const getTopic = (log: typeof devlogs[number]): 'radiohub' | 'puzzles' | 'agents' | 'portfolio' | 'other' => {
  const title = log.data.title.toLowerCase();
  const tags = (log.data.tags || []).join(' ').toLowerCase();
  const combined = `${title} ${tags}`;
  if (combined.includes('radiohub')) return 'radiohub';
  if (/puzzle|sudoku|numberlink|kakuro|hitori/.test(combined)) return 'puzzles';
  if (/coucou|agent|codex|opencode|clawdbot|\bia\b|\bai\b|llm|mcp/.test(combined)) return 'agents';
  if (/arceapps|portfolio|astro|mirror|github pages/.test(combined)) return 'portfolio';
  return 'other';
};

const topics = [
  { value: 'all', name: lang === 'es' ? 'Todos' : 'All' },
  { value: 'agents', name: 'Coucou' },
  { value: 'radiohub', name: 'RadioHub' },
  { value: 'puzzles', name: 'Puzzles' },
  { value: 'portfolio', name: lang === 'es' ? 'Herramientas' : 'Tools' },
  { value: 'other', name: lang === 'es' ? 'Otros' : 'Other' },
].filter(({ value }) => value === 'all' || devlogs.some(log => getTopic(log) === value));

const getTopicName = (topic: string) => {
  switch (topic) {
    case 'agents': return 'Coucou';
    case 'radiohub': return 'RadioHub';
    case 'puzzles': return 'Puzzles';
    case 'portfolio': return lang === 'es' ? 'Herramientas' : 'Tools';
    default: return lang === 'es' ? 'Otros' : 'Other';
  }
};

const featuredReadingTime = devlogs.length > 0
  ? Math.max(1, Math.ceil((devlogs[0].body ? devlogs[0].body.split(/\s+/g).length : 200) / 200))
  : 0;

const featuredDate = devlogs.length > 0
  ? devlogs[0].data.pubDate.toLocaleDateString(localeString, {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : '';
---

<Layout title={`${t('devlog.title')} - ArceApps`}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: lang === 'es' ? 'Inicio' : 'Home', item: "https://arceapps.com" },
        { "@type": "ListItem", position: 2, name: lang === 'es' ? 'Bitácora' : 'Devlog', item: `https://arceapps.com${lang === 'es' ? '/es/devlog' : '/devlog'}` },
      ],
    }).replace(/</g, "\\u003C")}
  />

  <main class="mx-auto max-w-5xl px-4 py-12 md:py-16">
    <PageIntro
      title="Devlog"
      description={lang === "es" ? "El detrás de cámaras. Aquí comparto la evolución de mis proyectos, decisiones técnicas, experimentos y aprendizajes." : "Behind the scenes. Here I share the evolution of my projects, technical decisions, experiments, and lessons learned."}
    />

    <!-- Filter pills row -->
    {devlogs.length > 0 && (
      <nav class="mb-8 flex flex-wrap items-center gap-2" role="group" aria-label={lang === 'es' ? 'Filtrar entradas por proyecto o tema' : 'Filter entries by project or topic'} data-devlog-filters>
        {topics.map(({ value, name }) => (
          <button
            type="button"
            data-devlog-filter={value}
            aria-pressed={value === 'all' ? 'true' : 'false'}
            class:list={[
              "min-h-9 rounded-full px-4 py-1.5 text-xs md:text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none",
              value === 'all'
                ? "border-primary bg-primary text-white"
                : "border border-border bg-surface-raised text-on-surface-variant hover:border-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
            ]}
          >
            {name}
          </button>
        ))}
      </nav>
    )}

    {devlogs.length > 0 ? (
      <>
        <!-- Featured Latest Devlog Card -->
        <article
          data-devlog-topic={getTopic(devlogs[0])}
          class="mb-8 overflow-hidden rounded-3xl border border-border bg-surface-raised shadow-sm dark:border-dark-border dark:bg-dark-surface-raised"
        >
          <a
            href={`${linkPrefix}/${devlogs[0].slug.split('/').pop()}`}
            class="relative block aspect-[21/9] sm:aspect-[2.2/1] w-full overflow-hidden bg-surface-variant dark:bg-dark-surface-variant focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary"
          >
            <img
              src={devlogs[0].data.heroImage || defaultImage}
              alt={getCoverAlt(devlogs[0].data.title)}
              class="h-full w-full object-cover transition-transform duration-500 hover:scale-[1.02]"
              loading="eager"
              width="1200"
              height="550"
            />
            <span class="absolute left-4 top-4 rounded-full bg-primary px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-md">
              {getTopicName(getTopic(devlogs[0]))}
            </span>
          </a>
          <div class="p-6 md:p-8">
            <h2 class="text-2xl md:text-3xl font-extrabold text-on-surface dark:text-dark-on-surface">
              <a href={`${linkPrefix}/${devlogs[0].slug.split('/').pop()}`} class="transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                {devlogs[0].data.title}
              </a>
            </h2>
            <p class="mt-2 text-on-surface-variant dark:text-dark-on-surface-variant">
              {devlogs[0].data.description}
            </p>
            <div class="mt-5 flex items-center justify-between text-sm">
              <span class="text-on-surface-variant dark:text-dark-on-surface-variant">
                {featuredDate} · {featuredReadingTime} min
              </span>
              <a
                href={`${linkPrefix}/${devlogs[0].slug.split('/').pop()}`}
                class="font-bold text-primary dark:text-teal-300 inline-flex items-center gap-1 hover:underline"
              >
                {lang === 'es' ? 'Leer artículo' : 'Read article'}
                <span class="material-icons text-base" aria-hidden="true">arrow_forward</span>
              </a>
            </div>
          </div>
        </article>

        <!-- 2-Column Grid of Subsequent Devlog Cards -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {devlogs.slice(1, 13).map((log) => {
            const slug = log.slug.split('/').pop();
            const shortDate = log.data.pubDate.toLocaleDateString(localeString, {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            });
            const readingTime = Math.max(1, Math.ceil((log.body ? log.body.split(/\s+/g).length : 200) / 200));
            const logTopic = getTopic(log);
            return (
              <article
                data-devlog-topic={logTopic}
                class="flex flex-col overflow-hidden rounded-2xl border border-border bg-surface-raised shadow-sm transition-all hover:border-primary/40 dark:border-dark-border dark:bg-dark-surface-raised"
              >
                <a
                  href={`${linkPrefix}/${slug}`}
                  class="relative block aspect-video w-full overflow-hidden bg-surface-variant dark:bg-dark-surface-variant focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary"
                >
                  <img
                    src={log.data.heroImage || defaultImage}
                    alt={getCoverAlt(log.data.title)}
                    class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="338"
                  />
                  <span class="absolute left-3 top-3 rounded-full bg-surface-raised/90 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-primary shadow-sm backdrop-blur-sm dark:bg-dark-surface-raised/90 dark:text-teal-300">
                    {getTopicName(logTopic)}
                  </span>
                </a>
                <div class="flex flex-1 flex-col p-5">
                  <h2 class="text-lg font-bold text-on-surface transition-colors line-clamp-2 hover:text-primary dark:text-dark-on-surface">
                    <a href={`${linkPrefix}/${slug}`} class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                      {log.data.title}
                    </a>
                  </h2>
                  <p class="mt-2 line-clamp-2 flex-1 text-sm text-on-surface-variant dark:text-dark-on-surface-variant">
                    {log.data.description}
                  </p>
                  <div class="mt-4 flex items-center justify-between text-xs text-on-surface-variant dark:text-dark-on-surface-variant">
                    <span>{shortDate} · {readingTime} min</span>
                    <a href={`${linkPrefix}/${slug}`} class="inline-flex items-center gap-1 font-semibold text-primary hover:underline dark:text-teal-300">
                      {lang === 'es' ? 'Leer artículo' : 'Read article'}
                      <span class="material-icons text-sm" aria-hidden="true">arrow_forward</span>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        {devlogs.length > 13 && (
          <details data-devlog-archive class="mt-12 rounded-2xl border border-border bg-surface-raised p-6 dark:border-dark-border dark:bg-dark-surface-raised">
            <summary class="cursor-pointer font-semibold text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">{lang === 'es' ? 'Archivo de entradas anteriores' : 'Older entries'} ({devlogs.length - 13})</summary>
            <ul class="mt-5 grid gap-3 border-t border-border pt-5 dark:border-dark-border md:grid-cols-2">
              {devlogs.slice(13).map((log) => (
                <li data-devlog-topic={getTopic(log)}><a href={`${linkPrefix}/${log.slug.split('/').pop()}`} class="block rounded-lg p-2 font-medium text-on-surface-variant hover:bg-primary/10 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:text-dark-on-surface-variant">{log.data.title}</a></li>
              ))}
            </ul>
          </details>
        )}
      </>
    ) : (
      <div class="rounded-2xl border border-border bg-surface-raised px-6 py-14 text-center dark:border-dark-border dark:bg-dark-surface-raised">
        <span class="material-icons mb-4 text-4xl text-on-surface-variant dark:text-dark-on-surface-variant" aria-hidden="true">terminal</span>
        <p class="text-lg text-on-surface-variant dark:text-dark-on-surface-variant">{t('devlog.empty')}</p>
      </div>
    )}
  </main>

  <script>
    const initDevlogFilters = () => {
      const container = document.querySelector<HTMLElement>('[data-devlog-filters]');
      if (!container || container.dataset.initialized) return;
      container.dataset.initialized = 'true';
      const buttons = [...container.querySelectorAll<HTMLButtonElement>('[data-devlog-filter]')];
      const entries = [...document.querySelectorAll<HTMLElement>('[data-devlog-topic]')];
      const archive = document.querySelector<HTMLDetailsElement>('[data-devlog-archive]');
      const activate = (topic: string) => {
        buttons.forEach(button => {
          const active = button.dataset.devlogFilter === topic;
          button.setAttribute('aria-pressed', String(active));
          button.classList.toggle('bg-primary', active);
          button.classList.toggle('text-white', active);
          button.classList.toggle('border-primary', active);
          button.classList.toggle('bg-surface-raised', !active);
          button.classList.toggle('dark:bg-dark-surface-raised', !active);
          button.classList.toggle('text-on-surface-variant', !active);
          button.classList.toggle('dark:text-dark-on-surface-variant', !active);
        });
        entries.forEach(entry => {
          entry.hidden = topic !== 'all' && entry.dataset.devlogTopic !== topic;
        });
        if (archive) {
          const hasOlder = [...archive.querySelectorAll<HTMLElement>('[data-devlog-topic]')].some(entry => !entry.hidden);
          archive.hidden = !hasOlder;
          if (topic !== 'all' && hasOlder) archive.open = true;
          else if (topic === 'all') archive.open = false;
        }
      };
      buttons.forEach(button => button.addEventListener('click', () => activate(button.dataset.devlogFilter || 'all')));
    };
    document.addEventListener('astro:page-load', initDevlogFilters);
    if (document.readyState !== 'loading') initDevlogFilters();
  </script>
</Layout>
