---
import Layout from "../../layouts/Layout.astro";
import PageIntro from "../PageIntro.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/utils";
import { isPublished } from "../../utils/publishing";

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const devlogs = (await getCollection("devlog", ({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith(`${lang}/`))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// R9: la destacada es la entrada más reciente real; el resto alimenta la lista.
const featured = devlogs[0];
const restDevlogs = devlogs.slice(1);

const defaultImage = "/images/devlog-default.svg";
const localeString = lang === 'es' ? 'es-ES' : 'en-US';

const getCoverAlt = (title: string) => t('devlog.cover_alt').replace('{title}', title);
const linkPrefix = lang === 'es' ? '/es/devlog' : '/devlog';
const slugOf = (log: (typeof devlogs)[number]) => log.slug.split('/').pop() ?? '';

const getReadingTime = (log: (typeof devlogs)[number]) =>
  Math.max(1, Math.ceil((log.body ? log.body.split(/\s+/g).length : 200) / 200));

const getReadingLabel = (log: (typeof devlogs)[number]) =>
  t('devlog.reading_time').replace('{min}', String(getReadingTime(log)));

const formatDate = (date: Date, options: Intl.DateTimeFormatOptions) =>
  date.toLocaleDateString(localeString, options);

type DevlogSeries = 'coucou' | 'radiohub' | 'puzzlehub' | 'tools';

// D6: las series se derivan de los títulos y tags reales de las entradas
// publicadas; no hay categorías inventadas en el listado.
const getSeries = (log: (typeof devlogs)[number]): DevlogSeries | 'other' => {
  const haystack = `${log.data.title} ${(log.data.tags ?? []).join(' ')}`.toLowerCase();
  if (haystack.includes('radiohub')) return 'radiohub';
  if (/puzzle|sudoku|numberlink|kakuro|hitori/.test(haystack)) return 'puzzlehub';
  if (/coucou|agent|codex|opencode|clawdbot|\bia\b|\bai\b|llm|mcp/.test(haystack)) return 'coucou';
  if (/arceapps|portfolio|astro|mirror|github pages/.test(haystack)) return 'tools';
  return 'other';
};

const seriesLabels: Record<DevlogSeries, string> = {
  coucou: t('devlog.series_coucou'),
  radiohub: t('devlog.series_radiohub'),
  puzzlehub: t('devlog.series_puzzlehub'),
  tools: t('devlog.series_tools'),
};

const seriesCounts = new Map<DevlogSeries, number>();
for (const log of devlogs) {
  const series = getSeries(log);
  if (series === 'other') continue;
  seriesCounts.set(series, (seriesCounts.get(series) ?? 0) + 1);
}

const MAX_VISIBLE_SERIES = 3;
const seriesChips = [...seriesCounts.entries()]
  .sort((a, b) => b[1] - a[1] || seriesLabels[a[0]].localeCompare(seriesLabels[b[0]]))
  .map(([value]) => ({ value, label: seriesLabels[value] }));
const visibleSeries = seriesChips.slice(0, MAX_VISIBLE_SERIES);
const overflowSeries = seriesChips.slice(MAX_VISIBLE_SERIES);

const featuredSeries = featured ? getSeries(featured) : 'other';
const featuredBadge = featuredSeries === 'other'
  ? (featured?.data.tags?.[0] ?? t('devlog.heading'))
  : seriesLabels[featuredSeries];
---

<Layout title={`${t('devlog.title')} - ArceApps`}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: t('common.home'), item: "https://arceapps.com" },
        { "@type": "ListItem", position: 2, name: t('devlog.heading'), item: `https://arceapps.com${lang === 'es' ? '/es/devlog' : '/devlog'}` },
      ],
    }).replace(/</g, "\\u003C")}
  />

  <main class="mx-auto max-w-5xl px-4 py-12 md:py-16">
    <PageIntro
      title={t('devlog.heading')}
      description={t('devlog.intro')}
    />

    {devlogs.length > 0 && (
      <>
        <!-- Chips de filtro por serie, derivados de las entradas reales (D6) -->
        <nav
          class="mb-4 flex flex-wrap items-center gap-2"
          role="group"
          aria-label={t('devlog.filter_aria')}
          data-devlog-filters
        >
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="devlog-filter-btn inline-flex min-h-9 items-center rounded-full bg-primary px-4 py-1.5 text-xs font-semibold text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none md:text-sm"
          >
            {t('devlog.filter_all')}
          </button>
          {visibleSeries.map(({ value, label }) => (
            <button
              type="button"
              data-filter={value}
              aria-pressed="false"
              class="devlog-filter-btn inline-flex min-h-9 items-center rounded-full border border-border bg-surface-raised px-4 py-1.5 text-xs font-medium text-on-surface-variant transition-colors hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant md:text-sm"
            >
              {label}
            </button>
          ))}
          {overflowSeries.length > 0 && (
            <button
              type="button"
              data-more-toggle
              aria-expanded="false"
              aria-controls="devlog-more-filters"
              class="inline-flex min-h-9 items-center rounded-full border border-border bg-surface-raised px-4 py-1.5 text-xs font-medium text-on-surface-variant transition-colors hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant md:text-sm"
            >
              {t('devlog.filter_others')}
            </button>
          )}
        </nav>

        <!-- "Otros" solo revela el resto de series; nunca aplica un filtro. -->
        {overflowSeries.length > 0 && (
          <div id="devlog-more-filters" data-more-filters hidden class="mb-8 flex flex-wrap gap-2">
            {overflowSeries.map(({ value, label }) => (
              <button
                type="button"
                data-filter={value}
                aria-pressed="false"
                class="devlog-filter-btn inline-flex min-h-9 items-center rounded-full border border-border bg-surface-raised px-4 py-1.5 text-xs font-medium text-on-surface-variant transition-colors hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant md:text-sm"
              >
                {label}
              </button>
            ))}
          </div>
        )}
      </>
    )}

    {featured ? (
      <>
        <!-- Tarjeta destacada: la entrada más reciente real -->
        <article
          data-devlog-featured
          data-devlog-topic={featuredSeries}
          class="mb-10 overflow-hidden rounded-2xl border border-border bg-surface-raised shadow-sm transition-all hover:border-primary/50 hover:shadow-md dark:border-dark-border dark:bg-dark-surface-raised"
        >
          <a
            href={`${linkPrefix}/${slugOf(featured)}`}
            class="relative block aspect-[16/9] w-full overflow-hidden rounded-2xl bg-surface-variant focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary dark:bg-dark-surface-variant sm:aspect-[21/9]"
          >
            <img
              src={featured.data.heroImage ?? defaultImage}
              alt={getCoverAlt(featured.data.title)}
              class="h-full w-full rounded-2xl object-cover"
              loading="eager"
              width="1200"
              height="500"
            />
            <span class="absolute left-4 top-4 rounded-full bg-surface-raised/90 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary shadow-sm backdrop-blur-sm dark:bg-dark-surface-raised/90">
              {featuredBadge}
            </span>
          </a>

          <div class="p-6 md:p-8">
            <h2 class="text-2xl font-extrabold text-on-surface dark:text-dark-on-surface md:text-3xl">
              <a
                href={`${linkPrefix}/${slugOf(featured)}`}
                class="transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
              >
                {featured.data.title}
              </a>
            </h2>

            <p class="mt-3 text-base leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
              {featured.data.description}
            </p>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-4 text-sm dark:border-dark-border">
              <span class="inline-flex flex-wrap items-center gap-1.5 text-on-surface-variant dark:text-dark-on-surface-variant">
                <time datetime={featured.data.pubDate.toISOString()}>
                  {formatDate(featured.data.pubDate, { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <span aria-hidden="true">·</span>
                <span>{getReadingLabel(featured)}</span>
              </span>
              <a
                href={`${linkPrefix}/${slugOf(featured)}`}
                class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-primary-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none"
              >
                <span>{t('devlog.read_article')}</span>
                <span class="material-icons text-base" aria-hidden="true">arrow_forward</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Resto de entradas reales, excluida la destacada -->
        {restDevlogs.length > 0 && (
          <section class="mt-2" aria-labelledby="devlog-more-entries">
            <h2 id="devlog-more-entries" class="sr-only">{t('devlog.more_entries')}</h2>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              {restDevlogs.map((log) => {
                const series = getSeries(log);
                return (
                  <article
                    data-devlog-topic={series}
                    class="material-card flex flex-col overflow-hidden transition-all hover:border-primary/40"
                  >
                    {log.data.heroImage && (
                      <a
                        href={`${linkPrefix}/${slugOf(log)}`}
                        class="relative block aspect-video w-full overflow-hidden rounded-t-xl bg-surface-variant focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary dark:bg-dark-surface-variant"
                      >
                        <img
                          src={log.data.heroImage}
                          alt={getCoverAlt(log.data.title)}
                          class="h-full w-full object-cover"
                          loading="lazy"
                          decoding="async"
                          width="600"
                          height="338"
                        />
                        {series !== 'other' && (
                          <span class="absolute left-3 top-3 rounded-full bg-surface-raised/90 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-primary shadow-sm backdrop-blur-sm dark:bg-dark-surface-raised/90">
                            {seriesLabels[series]}
                          </span>
                        )}
                      </a>
                    )}
                    <div class="flex flex-1 flex-col p-5">
                      <h3 class="text-base font-semibold text-on-surface transition-colors line-clamp-2 hover:text-primary dark:text-dark-on-surface sm:text-lg">
                        <a
                          href={`${linkPrefix}/${slugOf(log)}`}
                          class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                        >
                          {log.data.title}
                        </a>
                      </h3>
                      <p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
                        {log.data.description}
                      </p>
                      <div class="mt-4 flex items-center justify-between border-t border-border pt-3 text-xs text-on-surface-variant dark:border-dark-border dark:text-dark-on-surface-variant">
                        <span>{formatDate(log.data.pubDate, { year: 'numeric', month: 'short', day: 'numeric' })} · {getReadingLabel(log)}</span>
                        <a
                          href={`${linkPrefix}/${slugOf(log)}`}
                          class="inline-flex items-center gap-1 font-semibold text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                        >
                          {t('devlog.read_article')}
                          <span class="material-icons text-sm" aria-hidden="true">arrow_forward</span>
                        </a>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        )}
      </>
    ) : (
      <div class="rounded-2xl border border-border bg-surface-raised px-6 py-14 text-center dark:border-dark-border dark:bg-dark-surface-raised">
        <span class="material-icons mb-4 text-4xl text-on-surface-variant dark:text-dark-on-surface-variant" aria-hidden="true">terminal</span>
        <p class="text-lg text-on-surface-variant dark:text-dark-on-surface-variant">{t('devlog.empty')}</p>
      </div>
    )}
  </main>

  <script>
    const initDevlogFilters = () => {
      const container = document.querySelector<HTMLElement>('[data-devlog-filters]');
      if (!container || container.dataset.initialized === 'true') return;
      container.dataset.initialized = 'true';

      const buttons = [
        ...document.querySelectorAll<HTMLButtonElement>('[data-devlog-filters] [data-filter], [data-more-filters] [data-filter]'),
      ];
      const moreToggle = document.querySelector<HTMLButtonElement>('[data-more-toggle]');
      const moreFilters = document.querySelector<HTMLElement>('[data-more-filters]');
      const entries = [...document.querySelectorAll<HTMLElement>('[data-devlog-topic]')];

      // "Otros" solo revela la fila de series ocultas: no aplica filtros.
      if (moreToggle && moreFilters) {
        moreToggle.addEventListener('click', () => {
          const expanded = moreToggle.getAttribute('aria-expanded') === 'true';
          moreToggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
          moreFilters.hidden = expanded;
        });
      }

      const activate = (filter: string) => {
        buttons.forEach((button) => {
          const isActive = button.dataset.filter === filter;
          button.setAttribute('aria-pressed', String(isActive));
          button.classList.toggle('bg-primary', isActive);
          button.classList.toggle('text-white', isActive);
          button.classList.toggle('border', !isActive);
          button.classList.toggle('border-border', !isActive);
          button.classList.toggle('bg-surface-raised', !isActive);
          button.classList.toggle('text-on-surface-variant', !isActive);
          button.classList.toggle('dark:border-dark-border', !isActive);
          button.classList.toggle('dark:bg-dark-surface-raised', !isActive);
          button.classList.toggle('dark:text-dark-on-surface-variant', !isActive);
        });
        entries.forEach((entry) => {
          entry.hidden = filter !== 'all' && entry.dataset.devlogTopic !== filter;
        });
      };

      buttons.forEach((button) => {
        if (button.dataset.filterBound === 'true') return;
        button.dataset.filterBound = 'true';
        button.addEventListener('click', () => activate(button.dataset.filter || 'all'));
      });
    };

    document.addEventListener('astro:page-load', initDevlogFilters);
    if (document.readyState !== 'loading') initDevlogFilters();
  </script>
</Layout>
