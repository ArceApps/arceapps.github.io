---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../PageIntro.astro';
import BlogCard from '../BlogCard.astro';
import { blogTopics, type BlogTopic } from '../../utils/blog-topics';

interface Props {
  lang: 'es' | 'en';
  topic: BlogTopic;
  page: Page<CollectionEntry<'blog'>>;
  availableTopics: BlogTopic[];
}
const { lang, topic, page, availableTopics } = Astro.props;
const es = lang === 'es';
const prefix = es ? '/es/blog' : '/blog';
const topicInfo = blogTopics.find(item => item.slug === topic);
const label = topicInfo ? (es ? topicInfo.es : topicInfo.en) : topic;
---

<Layout
  title={`${label} · Blog — ArceApps`}
  description={es ? `Artículos de ${label} publicados en ArceApps.` : `ArceApps articles about ${label}.`}
>
  <main class="mx-auto max-w-5xl px-4 py-12 md:py-16">
    <a
      href={prefix}
      class="mb-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
    >
      <span class="material-icons text-base" aria-hidden="true">arrow_back</span>
      {es ? 'Volver al blog' : 'Back to blog'}
    </a>

    <PageIntro
      eyebrow="BLOG"
      title={label}
      description={es ? 'Explora artículos y guías de esta categoría.' : 'Explore articles and guides in this category.'}
    />

    <!-- Search bar & Category filter pills row -->
    <div class="mb-8">
      <button
        type="button"
        data-open-search
        class="flex min-h-12 w-full items-center gap-3 rounded-xl border border-border bg-surface-raised px-5 py-3 text-left text-on-surface-variant shadow-sm transition-all hover:border-primary/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
      >
        <span class="material-icons text-primary dark:text-teal-300" aria-hidden="true">search</span>
        <span class="flex-1 text-sm md:text-base text-on-surface-variant/70 dark:text-dark-on-surface-variant/70">{es ? 'Buscar artículos...' : 'Search articles...'}</span>
        <kbd class="hidden rounded-md border border-border bg-surface px-2 py-0.5 text-xs font-semibold text-on-surface-variant dark:border-dark-border dark:bg-dark-surface dark:text-dark-on-surface-variant sm:inline-block">⌘K</kbd>
      </button>

      <nav class="mt-4 flex flex-wrap items-center gap-2" aria-label={es ? 'Categorías del blog' : 'Blog categories'}>
        <a
          href={prefix}
          class="inline-flex min-h-9 items-center rounded-full border border-border bg-surface-raised px-4 py-1.5 text-xs md:text-sm font-semibold text-on-surface-variant hover:border-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
        >
          {es ? 'Todos' : 'All'}
        </a>
        {blogTopics.filter(item => availableTopics.includes(item.slug)).map(item => (
          <a
            href={`${prefix}/topic/${item.slug}/`}
            aria-current={item.slug === topic ? 'page' : undefined}
            class:list={[
              "inline-flex min-h-9 items-center rounded-full px-4 py-1.5 text-xs md:text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary",
              item.slug === topic
                ? "bg-primary text-white"
                : "border border-border bg-surface-raised text-on-surface-variant hover:border-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
            ]}
          >
            {es ? item.es : item.en}
          </a>
        ))}
      </nav>
    </div>

    <!-- Article list -->
    {page.data.length > 0 ? (
      <div class="grid grid-cols-1 gap-4">
        {page.data.map(post => <BlogCard post={post} list={true} />)}
      </div>
    ) : (
      <div class="rounded-2xl border border-border bg-surface-raised px-6 py-14 text-center dark:border-dark-border dark:bg-dark-surface-raised">
        <p class="text-lg text-on-surface-variant dark:text-dark-on-surface-variant">{es ? 'No hay artículos en esta categoría.' : 'No articles in this category.'}</p>
      </div>
    )}

    <!-- Pagination -->
    {(page.url.prev || page.url.next) && (
      <nav class="mt-10 flex flex-wrap justify-center items-center gap-3" aria-label={es ? 'Páginas' : 'Pages'}>
        {page.url.prev && (
          <a href={page.url.prev} class="inline-flex min-h-11 items-center rounded-xl border border-border bg-surface-raised px-5 py-2 font-semibold text-primary hover:border-primary dark:border-dark-border dark:bg-dark-surface-raised">
            {es ? 'Anterior' : 'Previous'}
          </a>
        )}
        <span class="inline-flex items-center px-3 text-sm text-on-surface-variant dark:text-dark-on-surface-variant">
          {page.currentPage} / {page.lastPage}
        </span>
        {page.url.next && (
          <a href={page.url.next} class="inline-flex min-h-11 items-center rounded-xl border border-border bg-surface-raised px-5 py-2 font-semibold text-primary hover:border-primary dark:border-dark-border dark:bg-dark-surface-raised">
            {es ? 'Siguiente' : 'Next'}
          </a>
        )}
      </nav>
    )}
  </main>
</Layout>
