---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../ContactForm.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import aboutMountains from '../../assets/about-mountains.jpg';
import { useTranslations } from '../../i18n/utils';
import { isPublished } from '../../utils/publishing';

interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const es = lang === 'es';
const t = useTranslations(lang);

const [apps, projects, blog] = await Promise.all([
  getCollection('apps', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft && isPublished(data.pubDate)),
  getCollection('projects', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft && isPublished(data.pubDate)),
  getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft && isPublished(data.pubDate))
]);

const contactHref = lang === 'es' ? '/es/contact' : '/contact';

const areas = [
  {
    icon: 'smartphone',
    color: 'bg-[#059669]/10 text-[#059669] dark:bg-[#059669]/20',
    title: t('about.work.android.title'),
    desc: t('about.work.android.subtitle'),
    href: es ? '/es/apps' : '/apps'
  },
  {
    icon: 'psychology',
    color: 'bg-[#F97316]/10 text-[#F97316] dark:bg-[#F97316]/20',
    title: t('about.work.ai.title'),
    desc: t('about.work.ai.subtitle'),
    href: es ? '/es/devlog' : '/devlog'
  },
  {
    icon: 'code',
    color: 'bg-[#038C8E]/10 text-[#038C8E] dark:bg-[#038C8E]/20',
    title: t('about.work.software.title'),
    desc: t('about.work.software.subtitle'),
    href: es ? '/es/projects' : '/projects'
  },
  {
    icon: 'menu_book',
    color: 'bg-[#E11D48]/10 text-[#E11D48] dark:bg-[#E11D48]/20',
    title: t('about.work.content.title'),
    desc: t('about.work.content.subtitle'),
    href: es ? '/es/blog' : '/blog'
  }
];
---

<Layout
  title={es ? 'Sobre ArceApps — Desarrollador independiente' : 'About ArceApps — Independent developer'}
  description={es ? 'Desarrollador independiente de aplicaciones Android, herramientas de IA y proyectos de software.' : 'Independent developer of Android apps, AI tools, and software projects.'}
  type="website"
  image="/logo.png"
>
  <div class="dark:bg-dark-surface min-h-screen">
    <main class="mx-auto max-w-4xl px-4 py-12 md:py-16">
      <!-- Hero: intro + foto de portada -->
      <header class="about-hero grid gap-8 md:grid-cols-[1.15fr_1fr] md:items-center">
        <div>
          <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-on-surface dark:text-dark-on-surface">
            {es ? 'Hola, soy ArceApps' : 'Hi, I am ArceApps'}
          </h1>
          <p class="mt-3 text-lg md:text-xl font-medium text-primary dark:text-[#00ACB0]">
            {t('about.intro')}
          </p>

          <!-- Fila de enlaces sociales / contacto: Botones circulares limpios -->
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <!-- GitHub -->
            <a
              href="https://github.com/arceapps"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-surface-raised text-on-surface shadow-sm transition-all hover:border-primary hover:text-primary hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface dark:hover:border-primary"
              aria-label="GitHub"
              title="GitHub"
            >
              <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
            </a>

            <!-- Google Play -->
            <a
              href="https://play.google.com/store/apps/dev?id=8812775800441745731"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-surface-raised text-on-surface shadow-sm transition-all hover:border-primary hover:text-primary hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface dark:hover:border-primary"
              aria-label="Google Play"
              title="Google Play"
            >
              <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3.609 1.814L13.792 12 3.61 22.186a2.23 2.23 0 0 1-.61-.986V2.8c.144-.383.364-.72.609-.986zm11.242 11.245l2.453 2.453-11.41 6.54 8.957-8.993zm2.453-2.118l3.197 1.832a1.442 1.442 0 0 1 0 2.454l-3.197 1.832-2.3-2.3 2.3-1.818zm-2.453-.335L5.894 1.609l11.41 6.54-2.453 2.453z"></path>
              </svg>
            </a>

            <!-- X / Twitter -->
            <a
              href="https://x.com/arceapps"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-surface-raised text-on-surface shadow-sm transition-all hover:border-primary hover:text-primary hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface dark:hover:border-primary"
              aria-label="X (Twitter)"
              title="X (Twitter)"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
              </svg>
            </a>

            <!-- Email / Contact -->
            <a
              href="#contact"
              class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-surface-raised text-on-surface shadow-sm transition-all hover:border-primary hover:text-primary hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface dark:hover:border-primary"
              aria-label={es ? 'Contacto por email' : 'Email contact'}
              title={es ? 'Contacto' : 'Contact'}
            >
              <span class="material-icons text-xl" aria-hidden="true">mail</span>
            </a>
          </div>
        </div>

        <Image
          src={aboutMountains}
          alt={t('about.photo_alt')}
          class="about-mountains aspect-[4/3] w-full rounded-2xl border border-border object-cover shadow-sm dark:border-dark-border md:aspect-auto md:h-full"
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 40vw, 100vw"
          loading="eager"
          quality={75}
        />
      </header>

      <!-- Bio paragraph -->
      <p class="mt-8 text-base md:text-lg leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
        {t('about.bio')}
      </p>

      <!-- Stats: Apps publicadas · Artículos publicados · Proyectos open source -->
      <section class="about-stats mt-8" aria-labelledby="about-stats-title">
        <h2 id="about-stats-title" class="sr-only">{es ? 'Cifras' : 'Numbers'}</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="material-card flex flex-col items-center px-4 py-6 text-center">
            <span class="text-4xl font-extrabold text-primary dark:text-[#00ACB0]">{apps.length}</span>
            <span class="mt-1 text-sm font-medium text-on-surface-variant dark:text-dark-on-surface-variant">
              {es ? 'Apps publicadas' : 'Published apps'}
            </span>
          </div>
          <div class="material-card flex flex-col items-center px-4 py-6 text-center">
            <span class="text-4xl font-extrabold text-primary dark:text-[#00ACB0]">{blog.length}</span>
            <span class="mt-1 text-sm font-medium text-on-surface-variant dark:text-dark-on-surface-variant">
              {es ? 'Artículos publicados' : 'Published articles'}
            </span>
          </div>
          <div class="material-card flex flex-col items-center px-4 py-6 text-center">
            <span class="text-4xl font-extrabold text-primary dark:text-[#00ACB0]">{projects.length}</span>
            <span class="mt-1 text-sm font-medium text-on-surface-variant dark:text-dark-on-surface-variant">
              {es ? 'Proyectos open source' : 'Open source projects'}
            </span>
          </div>
        </div>
      </section>

      <!-- Sección about.work (Cuadrícula 2x2) -->
      <section id="about-work" class="mt-12" aria-labelledby="about-work-title">
        <h2 id="about-work-title" class="text-2xl font-bold mb-6 text-on-surface dark:text-dark-on-surface">
          {t('about.work.title')}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {areas.map((area) => (
            <a
              href={area.href}
              class="group flex items-start gap-4 rounded-2xl border border-border bg-surface-raised p-5 sm:p-6 shadow-sm transition-all hover:border-primary/50 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised"
            >
              <span class:list={["flex h-12 w-12 shrink-0 items-center justify-center rounded-xl", area.color]}>
                <span class="material-icons text-2xl" aria-hidden="true">{area.icon}</span>
              </span>
              <div class="min-w-0">
                <h3 class="block text-base font-semibold text-on-surface transition-colors group-hover:text-primary dark:text-dark-on-surface">
                  {area.title}
                </h3>
                <span class="mt-1 block text-sm text-content-muted dark:text-dark-content-muted leading-relaxed">
                  {area.desc}
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Bloque de Cierre about.cta con botón directo a contacto -->
      <div id="about-cta" class="mt-12 rounded-3xl border border-border bg-surface-raised p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 dark:border-dark-border dark:bg-dark-surface-raised shadow-sm">
        <div class="max-w-xl">
          <h2 class="text-2xl font-bold text-on-surface dark:text-dark-on-surface">
            {t('about.cta.title')}
          </h2>
          <p class="mt-2 text-sm text-on-surface-variant dark:text-dark-on-surface-variant leading-relaxed">
            {t('about.cta.subtitle')}
          </p>
        </div>
        <a
          href={contactHref}
          class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-surface shadow-sm transition-all hover:bg-primary-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          <span>{t('about.cta.button')}</span>
          <span class="material-icons text-base" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

      <!-- Embedded Contact Section -->
      <div id="contact" class="mt-12 rounded-3xl border border-border bg-surface-raised p-6 shadow-sm dark:border-dark-border dark:bg-dark-surface-raised md:p-10">
        <div class="mb-6 text-center">
          <h2 class="text-2xl font-bold text-on-surface dark:text-dark-on-surface">
            {es ? 'Envíame un mensaje' : 'Send a message'}
          </h2>
          <p class="mt-2 text-sm text-on-surface-variant dark:text-dark-on-surface-variant">
            {es ? 'Completa el formulario y te responderé lo antes posible.' : 'Fill out the form and I will get back to you as soon as possible.'}
          </p>
        </div>
        <ContactForm lang={lang} />
      </div>
    </main>
  </div>
</Layout>
