---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../ContactForm.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../utils/publishing';

interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const es = lang === 'es';

const [apps, projects, blog] = await Promise.all([
  getCollection('apps', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft && isPublished(data.pubDate)),
  getCollection('projects', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft && isPublished(data.pubDate)),
  getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft && isPublished(data.pubDate))
]);

const areas = es ? [
  { icon: 'smartphone', color: 'bg-primary/10 text-primary dark:text-teal-300', title: 'Desarrollo Android', desc: 'Apps nativas con Kotlin y Jetpack Compose', href: '/es/apps' },
  { icon: 'auto_awesome', color: 'bg-amber-500/10 text-amber-500 dark:text-amber-400', title: 'Inteligencia artificial', desc: 'Agentes, automatización y herramientas prácticas', href: '/es/devlog' },
  { icon: 'code', color: 'bg-primary/10 text-primary dark:text-teal-300', title: 'Proyectos de software', desc: 'Herramientas, librerías y experimentos', href: '/es/projects' },
  { icon: 'article', color: 'bg-primary/10 text-primary dark:text-teal-300', title: 'Contenido técnico', desc: 'Blog, devlog y guías prácticas', href: '/es/blog' }
] : [
  { icon: 'smartphone', color: 'bg-primary/10 text-primary dark:text-teal-300', title: 'Android development', desc: 'Native apps with Kotlin and Jetpack Compose', href: '/apps' },
  { icon: 'auto_awesome', color: 'bg-amber-500/10 text-amber-500 dark:text-amber-400', title: 'Artificial intelligence', desc: 'Agents, automation and practical tools', href: '/devlog' },
  { icon: 'code', color: 'bg-primary/10 text-primary dark:text-teal-300', title: 'Software projects', desc: 'Tools, libraries and experiments', href: '/projects' },
  { icon: 'article', color: 'bg-primary/10 text-primary dark:text-teal-300', title: 'Technical content', desc: 'Blog, devlog and practical guides', href: '/blog' }
];
---

<Layout
  title={es ? 'Sobre ArceApps — Desarrollador independiente' : 'About ArceApps — Independent developer'}
  description={es ? 'Desarrollador independiente de aplicaciones Android, herramientas de IA y proyectos de software.' : 'Independent developer of Android apps, AI tools, and software projects.'}
  type="website"
  image="/logo.png"
>
  <div class="dark:bg-dark-surface min-h-screen">
    <main class="mx-auto max-w-4xl px-4 py-12 md:py-16">
      <!-- Header -->
      <header class="text-left">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-on-surface dark:text-dark-on-surface">
          {es ? 'Hola, soy ArceApps' : 'Hi, I am ArceApps'}
        </h1>
        <p class="mt-3 text-lg md:text-xl text-on-surface-variant dark:text-dark-on-surface-variant">
          {es ? 'Desarrollador independiente, apasionado por crear software útil y compartir conocimiento.' : 'Independent developer, passionate about building useful software and sharing knowledge.'}
        </p>
      </header>

      <!-- Scenic Landscape Banner Image -->
      <div class="mt-8 overflow-hidden rounded-3xl border border-border shadow-sm dark:border-dark-border">
        <img
          src="/images/portfolio-landscape.svg"
          alt="ArceApps Landscape"
          class="aspect-[2.4/1] w-full object-cover"
          width="1200"
          height="500"
        />
      </div>

      <!-- Bio paragraph below the banner -->
      <p class="mt-6 text-base md:text-lg leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
        {es ? 'Me dedico al desarrollo de aplicaciones Android, herramientas de IA y proyectos de software. Me gusta resolver problemas reales, aprender tecnologías nuevas y compartir todo el proceso.' : 'I dedicate myself to developing Android apps, AI tools, and software projects. I enjoy solving real problems, learning new technologies, and sharing the entire process.'}
      </p>

      <!-- 3-Column Metrics Card -->
      <div class="mt-8 grid grid-cols-3 divide-x divide-border rounded-2xl border border-border bg-surface-raised py-5 text-center shadow-sm dark:divide-dark-border dark:border-dark-border dark:bg-dark-surface-raised">
        <div class="flex flex-col items-center px-2">
          <span class="material-icons text-2xl text-primary dark:text-teal-300" aria-hidden="true">smartphone</span>
          <span class="mt-1 text-2xl font-extrabold text-on-surface dark:text-dark-on-surface md:text-3xl">{apps.length}</span>
          <span class="mt-0.5 text-xs text-on-surface-variant dark:text-dark-on-surface-variant md:text-sm">{es ? 'Apps publicadas' : 'Published apps'}</span>
        </div>
        <div class="flex flex-col items-center px-2">
          <span class="material-icons text-2xl text-amber-500 dark:text-amber-400" aria-hidden="true">auto_awesome</span>
          <span class="mt-1 text-2xl font-extrabold text-on-surface dark:text-dark-on-surface md:text-3xl">{blog.length}+</span>
          <span class="mt-0.5 text-xs text-on-surface-variant dark:text-dark-on-surface-variant md:text-sm">{es ? 'Artículos publicados' : 'Published articles'}</span>
        </div>
        <div class="flex flex-col items-center px-2">
          <span class="material-icons text-2xl text-primary dark:text-teal-300" aria-hidden="true">code</span>
          <span class="mt-1 text-2xl font-extrabold text-on-surface dark:text-dark-on-surface md:text-3xl">{projects.length}</span>
          <span class="mt-0.5 text-xs text-on-surface-variant dark:text-dark-on-surface-variant md:text-sm">{es ? 'Proyectos open source' : 'Open source projects'}</span>
        </div>
      </div>

      <!-- 'En qué trabajo' / 'What I work on' Section -->
      <section class="mt-12">
        <h2 class="text-2xl font-bold mb-5 text-on-surface dark:text-dark-on-surface">
          {es ? 'En qué trabajo' : 'What I work on'}
        </h2>
        <div class="flex flex-col gap-3">
          {areas.map((area) => (
            <a
              href={area.href}
              class="group flex items-center gap-4 rounded-2xl border border-border bg-surface-raised p-4 shadow-sm transition-colors hover:border-primary/40 dark:border-dark-border dark:bg-dark-surface-raised"
            >
              <div class:list={["flex h-12 w-12 shrink-0 items-center justify-center rounded-xl", area.color]}>
                <span class="material-icons text-2xl" aria-hidden="true">{area.icon}</span>
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-base font-bold text-on-surface transition-colors group-hover:text-primary dark:text-dark-on-surface">
                  {area.title}
                </h3>
                <p class="truncate text-sm text-on-surface-variant dark:text-dark-on-surface-variant">
                  {area.desc}
                </p>
              </div>
              <span class="material-icons text-on-surface-variant/40 transition-transform group-hover:translate-x-0.5 group-hover:text-primary dark:text-dark-on-surface-variant/40" aria-hidden="true">arrow_forward</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Bottom '¿Hablamos?' / 'Let’s talk?' CTA Banner Card -->
      <div class="mt-12 rounded-2xl border border-border bg-surface-subtle/70 p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 dark:border-dark-border dark:bg-dark-surface-raised">
        <div>
          <h3 class="text-xl font-bold text-on-surface dark:text-dark-on-surface">
            {es ? '¿Hablamos?' : 'Let’s talk?'}
          </h3>
          <p class="mt-1 text-sm text-on-surface-variant dark:text-dark-on-surface-variant">
            {es ? 'Si quieres comentar un proyecto, hacer una sugerencia o simplemente saludar, estaré encantado de leerte.' : 'Whether you have a question about my apps, want to discuss an idea, or just feel like saying hello — I’d love to hear from you.'}
          </p>
        </div>
        <a
          href="#contact"
          class="inline-flex shrink-0 items-center gap-1.5 rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:bg-teal-600 dark:hover:bg-teal-500"
        >
          {es ? 'Contactar' : 'Contact'}
          <span class="material-icons text-base" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

      <!-- Embedded Contact Section -->
      <div id="contact" class="mt-12 rounded-3xl border border-border bg-surface-raised p-6 shadow-sm dark:border-dark-border dark:bg-dark-surface-raised md:p-10">
        <div class="mb-6 text-center">
          <h2 class="text-2xl font-bold text-on-surface dark:text-dark-on-surface">
            {es ? 'Envíame un mensaje' : 'Send a message'}
          </h2>
          <p class="mt-2 text-sm text-on-surface-variant dark:text-dark-on-surface-variant">
            {es ? 'Completa el formulario y te responderé lo antes posible.' : 'Fill out the form and I will get back to you as soon as possible.'}
          </p>
        </div>
        <ContactForm lang={lang} />
      </div>
    </main>
  </div>
</Layout>
