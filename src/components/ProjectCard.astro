---
import { optimizeGooglePlayImage } from "../utils/image-optimization";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Card from "./Card.astro";

interface Props {
  title: string;
  description: string;
  heroImage?: string;
  realIconUrl?: string;
  tags?: string[];
  technologies?: string[];
  pubDate: Date;
  datePrecision?: 'exact' | 'approximate';
  slug: string;
  kind?: 'app' | 'project';
  status?: 'active' | 'maintained' | 'archived' | 'experimental';
  repositoryUrl?: string;
  demoUrl?: string;
}

const {
  title,
  description,
  heroImage,
  realIconUrl,
  tags = [],
  technologies = [],
  pubDate,
  datePrecision = 'exact',
  slug,
  kind = 'project',
  status,
  repositoryUrl,
  demoUrl,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basePath = kind === 'project' ? 'projects' : 'apps';
const statusText = status ? (lang === 'es'
  ? { active: 'Activo', maintained: 'En mantenimiento', archived: 'Archivado', experimental: 'Experimental' }[status]
  : { active: 'Active', maintained: 'Maintained', archived: 'Archived', experimental: 'Experimental' }[status]) : undefined;
const href = lang === 'es' ? `/es/${basePath}/${slug}` : `/${basePath}/${slug}`;
const displayTechnologies = technologies.length > 0 ? technologies : tags;
---

<Card
  variant="app"
  ariaLabel={title}
  class="flex flex-col h-full bg-white dark:bg-[#111E26] border border-border dark:border-[#1F333E] rounded-2xl overflow-hidden shadow-sm transition-shadow duration-200 motion-reduce:transition-none"
>
  <!-- Image Area -->
  <div class="relative h-48 sm:h-52 overflow-hidden bg-surface-subtle dark:bg-[#0D171F] border-b border-border dark:border-[#1F333E]">
    <a href={href} class="block h-full w-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" aria-label={title}>
      {
        heroImage ? (
          <img
            src={optimizeGooglePlayImage(heroImage, 800, "width")}
            alt={title}
            width="400"
            height="224"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-opacity motion-reduce:transition-none"
          />
        ) : (
          <div
            class="w-full h-full flex items-center justify-center text-on-surface-variant/40 dark:text-dark-on-surface-variant/40"
            aria-hidden="true"
          >
            <span class="material-icons text-5xl">folder_special</span>
          </div>
        )
      }
    </a>

    <!-- Top Status Overlay -->
    <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 z-10">
      {statusText && (
        <span class="inline-flex items-center gap-1 rounded-full bg-teal-500/10 px-2.5 py-0.5 text-xs font-bold text-primary dark:bg-teal-400/10 dark:text-teal-300 backdrop-blur-md border border-teal-500/20">
          <span class="h-1.5 w-1.5 rounded-full bg-primary dark:bg-teal-400" aria-hidden="true"></span>
          <span>{statusText}</span>
        </span>
      )}
    </div>

    <!-- Quick Link Badges: GitHub & Demo -->
    <div class="absolute top-3 right-3 flex flex-wrap items-center gap-1.5 z-10">
      {repositoryUrl && (
        <a
          href={repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full bg-slate-900/80 px-2.5 py-1 text-xs font-semibold text-white shadow-sm backdrop-blur-md transition-colors hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none"
          aria-label={`${title} repository on GitHub`}
        >
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub</span>
        </a>
      )}
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full bg-primary px-2.5 py-1 text-xs font-semibold text-white shadow-sm backdrop-blur-md transition-colors hover:bg-primary-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none"
          aria-label={`${title} live demo`}
        >
          <span class="material-icons text-xs" aria-hidden="true">open_in_new</span>
          <span>Demo</span>
        </a>
      )}
    </div>
  </div>

  <!-- Content Area -->
  <div class="p-6 flex flex-col flex-1">
    <a href={href} class="group/title focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded">
      <h2 class="text-xl font-bold text-on-surface dark:text-dark-on-surface group-hover/title:text-primary transition-colors motion-reduce:transition-none mb-2">
        {title}
      </h2>
    </a>

    <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant line-clamp-3 leading-relaxed mb-4 flex-1">
      {description}
    </p>

    <!-- Technologies Employed Badges -->
    {displayTechnologies.length > 0 && (
      <div class="mb-5 flex flex-wrap gap-1.5">
        {displayTechnologies.map((tech) => (
          <span class="inline-flex items-center rounded-md bg-surface-subtle px-2.5 py-1 text-xs font-medium text-on-surface-variant border border-border/60 dark:bg-[#16242E] dark:text-dark-on-surface-variant dark:border-[#1F333E]">
            {tech}
          </span>
        ))}
      </div>
    )}

    <!-- Bottom row: Date & Details Link -->
    <div class="mt-auto pt-4 flex items-center justify-between border-t border-border/50 dark:border-[#1F333E]">
      <span class="flex flex-col items-start gap-0.5">
        <time datetime={pubDate.toISOString()} class="text-xs text-on-surface-variant dark:text-dark-on-surface-variant">
          {pubDate.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { year: 'numeric', month: 'short' })}
        </time>
        {datePrecision === 'approximate' && (
          <span class="text-[0.65rem] uppercase tracking-wider text-secondary">
            {t('projects.date_approximate')}
          </span>
        )}
      </span>

      <a
        href={href}
        class="inline-flex items-center gap-1 text-xs font-bold text-primary dark:text-teal-400 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded"
      >
        <span>{t('common.read_more')}</span>
        <span class="material-icons text-sm" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
  </div>
</Card>
