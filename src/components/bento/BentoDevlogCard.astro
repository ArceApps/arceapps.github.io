---
import BentoCard from "./BentoCard.astro";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: 'en' | 'es';
  latestDevlog?: {
    data: {
      title: string;
      description: string;
      pubDate: Date;
    };
    slug: string;
  };
}

const { lang, latestDevlog } = Astro.props;
const t = useTranslations(lang);
const linkPrefix = lang === 'es' ? '/es' : '';
const devlogSlug = latestDevlog ? latestDevlog.slug.split('/').pop() : '';
---

<BentoCard colSpan="lg:col-span-2" rowSpan="lg:row-span-1" variant="default" class="justify-between">
  {latestDevlog ? (
    <div class="flex flex-col h-full justify-between">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/10 px-3 py-1 text-xs font-bold text-primary dark:text-teal-400 uppercase tracking-wider">
            <span class="h-2 w-2 rounded-full bg-secondary animate-pulse" aria-hidden="true"></span>
            {t('home.bento.devlog_badge')}
          </span>
          <span class="text-xs text-on-surface-variant/80 dark:text-dark-on-surface-variant/80 font-medium">
            {latestDevlog.data.pubDate.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US')}
          </span>
        </div>

        <h3 class="text-xl font-bold text-on-surface dark:text-dark-on-surface mb-2 line-clamp-1 group-hover:text-primary dark:group-hover:text-teal-400 transition-colors">
          {latestDevlog.data.title}
        </h3>

        <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant line-clamp-2 leading-relaxed mb-4">
          {latestDevlog.data.description}
        </p>
      </div>

      <div class="pt-3 border-t border-border/50 dark:border-dark-border/50 flex justify-end">
        <a
          href={`${linkPrefix}/devlog/${devlogSlug}`}
          class="inline-flex items-center text-xs font-bold text-primary dark:text-teal-400 hover:text-secondary transition-colors"
        >
          {t('home.read_entry')}
          <span class="material-icons ml-1 text-sm" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
    </div>
  ) : (
    <div class="flex flex-col h-full justify-between">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-secondary/25 bg-secondary/10 px-3 py-1 text-xs font-bold text-secondary uppercase tracking-wider mb-3">
          <span class="material-icons text-xs" aria-hidden="true">code</span>
          {t('home.bento.devlog_fallback')}
        </span>
        <h3 class="text-xl font-bold text-on-surface dark:text-dark-on-surface mb-2">
          {t('home.explore_code')}
        </h3>
        <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant line-clamp-2">
          {t('home.explore_code_desc')}
        </p>
      </div>
      <div class="pt-3 border-t border-border/50 dark:border-dark-border/50 flex justify-end">
        <a
          href={`${linkPrefix}/projects`}
          class="inline-flex items-center text-xs font-bold text-primary dark:text-teal-400 hover:text-secondary transition-colors"
        >
          {t('home.view_all_projects')}
          <span class="material-icons ml-1 text-sm" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
    </div>
  )}
</BentoCard>
