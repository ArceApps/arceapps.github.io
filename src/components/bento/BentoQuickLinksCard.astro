---
import BentoCard from "./BentoCard.astro";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BentoCard colSpan="lg:col-span-1" rowSpan="lg:row-span-1" variant="secondary" class="justify-between">
  <div>
    <div class="flex items-center gap-2 mb-3">
      <span class="material-icons text-sm text-secondary" aria-hidden="true">open_in_new</span>
      <span class="text-xs font-bold uppercase tracking-wider text-secondary">
        {t('home.bento.links_badge')}
      </span>
    </div>

    <div class="flex flex-col gap-3 mt-2">
      <a
        href="https://github.com/arceapps"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-3 rounded-2xl bg-surface-variant/40 dark:bg-dark-surface-variant/40 hover:bg-primary/10 hover:text-primary dark:hover:text-teal-400 border border-border/40 dark:border-dark-border/40 transition-colors group/btn"
      >
        <div class="flex items-center gap-3">
          <span class="material-icons text-xl text-on-surface dark:text-dark-on-surface group-hover/btn:text-primary dark:group-hover/btn:text-teal-400" aria-hidden="true">code</span>
          <div>
            <div class="text-xs font-bold text-on-surface dark:text-dark-on-surface">{t('home.view_github')}</div>
            <div class="text-[10px] text-on-surface-variant dark:text-dark-on-surface-variant">{t('home.bento.github_desc')}</div>
          </div>
        </div>
        <span class="material-icons text-sm text-on-surface-variant group-hover/btn:translate-x-0.5 transition-transform" aria-hidden="true">chevron_right</span>
      </a>

      <a
        href="https://play.google.com/store/apps/dev?id=8812775800441745731"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-3 rounded-2xl bg-surface-variant/40 dark:bg-dark-surface-variant/40 hover:bg-secondary/10 hover:text-secondary border border-border/40 dark:border-dark-border/40 transition-colors group/btn"
      >
        <div class="flex items-center gap-3">
          <span class="material-icons text-xl text-on-surface dark:text-dark-on-surface group-hover/btn:text-secondary" aria-hidden="true">shop</span>
          <div>
            <div class="text-xs font-bold text-on-surface dark:text-dark-on-surface">{t('home.google_play')}</div>
            <div class="text-[10px] text-on-surface-variant dark:text-dark-on-surface-variant">{t('home.bento.playstore_desc')}</div>
          </div>
        </div>
        <span class="material-icons text-sm text-on-surface-variant group-hover/btn:translate-x-0.5 transition-transform" aria-hidden="true">chevron_right</span>
      </a>
    </div>
  </div>
</BentoCard>
