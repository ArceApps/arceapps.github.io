---
import BentoCard from "./BentoCard.astro";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stackItems = [
  { label: 'Kotlin', icon: 'code', bg: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20' },
  { label: 'Jetpack Compose', icon: 'android', bg: 'bg-green-500/10 text-green-600 dark:text-green-400 border-green-500/20' },
  { label: 'Astro', icon: 'rocket_launch', bg: 'bg-orange-500/10 text-orange-600 dark:text-orange-400 border-orange-500/20' },
  { label: 'Tailwind CSS', icon: 'palette', bg: 'bg-teal-500/10 text-teal-600 dark:text-teal-400 border-teal-500/20' },
];
---

<BentoCard colSpan="lg:col-span-1" rowSpan="lg:row-span-1" variant="default" class="justify-between">
  <div>
    <div class="flex items-center gap-2 mb-3">
      <span class="material-icons text-sm text-primary dark:text-teal-400" aria-hidden="true">layers</span>
      <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant/80 dark:text-dark-on-surface-variant/80">
        {t('home.bento.tech_badge')}
      </span>
    </div>

    <h3 class="text-lg font-bold text-on-surface dark:text-dark-on-surface mb-4 leading-snug">
      {t('home.bento.tech_title')}
    </h3>

    <div class="flex flex-wrap gap-2">
      {stackItems.map((item) => (
        <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-xl border text-xs font-semibold ${item.bg} group-hover:scale-105 transition-transform duration-200`}>
          <span class="material-icons text-xs" aria-hidden="true">{item.icon}</span>
          {item.label}
        </span>
      ))}
    </div>
  </div>
</BentoCard>
