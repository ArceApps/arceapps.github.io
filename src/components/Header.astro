---
import { Image } from "astro:assets";
import brandIcon from "../assets/brand-icon.png";
import Search from "./Search.astro";
import { getLangFromUrl, useTranslations, isPathActive, getLocalizedTogglePath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  translatedPath?: string;
}

const { translatedPath } = Astro.props;

const navItems = [
  { label: t('nav.home'), href: lang === 'es' ? '/es/' : '/', icon: 'home' },
  { label: t('nav.projects'), href: lang === 'es' ? '/es/projects' : '/projects', icon: 'code' },
  { label: t('nav.apps'), href: lang === 'es' ? '/es/apps' : '/apps', icon: 'smartphone' },
  { label: t('nav.blog'), href: lang === 'es' ? '/es/blog' : '/blog', icon: 'article' },
  { label: t('nav.devlog'), href: lang === 'es' ? '/es/devlog' : '/devlog', icon: 'terminal' },
  { label: t('nav.contact'), href: lang === 'es' ? '/es/contact' : '/contact', icon: 'mail' },
];

const { pathname } = Astro.url;

const isActive = (href: string) => isPathActive(pathname, href);

// Language Toggle Logic
const currentLang = lang;
const nextLang = currentLang === 'es' ? 'en' : 'es';

// Use translatedPath if provided, otherwise fallback to simple path replacement
const nextPath = translatedPath || getLocalizedTogglePath(Astro.url, currentLang);
---

<header
  class="sticky top-0 z-50 bg-[#F8F9FA]/80 dark:bg-[#091117]/80 backdrop-blur-md border-b border-border/80 dark:border-dark-border/80 transition-colors duration-300"
>
  <div class="container mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a
      href={lang === 'es' ? '/es/' : '/'}
      data-astro-prefetch
      class="flex items-center gap-2.5 group focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none rounded-lg p-1"
    >
      <Image
        src={brandIcon}
        alt="ArceApps Logo"
        width={36}
        height={36}
        loading="eager"
        fetchpriority="high"
        class="w-9 h-9 rounded-xl shadow-xs group-hover:scale-105 transition-transform"
      />
      <span
        class="text-xl font-bold tracking-tight text-[#111827] dark:text-[#F3F4F6]"
      >
        Arce<span class="text-primary dark:text-[#2DD4BF]">Apps</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden xl:flex items-center gap-1 2xl:gap-2">
      {
        navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              data-astro-prefetch
              aria-current={active ? "page" : undefined}
              class:list={[
                "relative px-3.5 py-1.5 text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none rounded-lg",
                active
                  ? "text-primary dark:text-[#2DD4BF] font-semibold"
                  : "text-on-surface-variant dark:text-dark-on-surface-variant hover:text-primary dark:hover:text-[#2DD4BF]",
              ]}
            >
              {item.label}
              {active && (
                <span
                  class="absolute bottom-0 left-3.5 right-3.5 h-0.5 bg-primary dark:bg-[#2DD4BF] rounded-full"
                  aria-hidden="true"
                />
              )}
            </a>
          );
        })
      }
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <!-- Search -->
      <Search />

      <!-- Language Toggle (Pill ES / EN) -->
      <a
        id="language-toggle"
        href={nextPath}
        class="h-8 px-2.5 rounded-full flex items-center gap-1 font-semibold text-xs tracking-wider border border-border/80 dark:border-dark-border/80 bg-white/70 dark:bg-[#111E26]/70 hover:border-primary/50 dark:hover:border-[#2DD4BF]/50 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary shadow-xs"
        aria-label={t('nav.language')}
        data-lang={nextLang}
      >
        <span class={currentLang === 'es' ? 'font-bold text-primary dark:text-[#2DD4BF]' : 'text-gray-400 dark:text-gray-500'}>ES</span>
        <span class="text-gray-300 dark:text-gray-600 font-light text-[11px]">/</span>
        <span class={currentLang === 'en' ? 'font-bold text-primary dark:text-[#2DD4BF]' : 'text-gray-400 dark:text-gray-500'}>EN</span>
      </a>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        class="w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant dark:text-dark-on-surface-variant hover:text-primary dark:hover:text-[#2DD4BF] hover:bg-surface-subtle dark:hover:bg-[#111E26] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary overflow-hidden"
        aria-label={t('nav.theme')}
      >
        <div class="relative w-5 h-5 flex items-center justify-center">
          <!-- Moon Icon (Visible in Light Mode -> Action: Go Dark) -->
          <span
            id="icon-dark"
            class="material-icons absolute inset-0 text-lg flex items-center justify-center transform transition-all duration-300 motion-reduce:duration-0 rotate-0 scale-100 opacity-100 dark:-rotate-90 dark:scale-0 dark:opacity-0"
            aria-hidden="true"
          >
            dark_mode
          </span>
          <!-- Sun Icon (Visible in Dark Mode -> Action: Go Light) -->
          <span
            id="icon-light"
            class="material-icons absolute inset-0 text-lg flex items-center justify-center transform transition-all duration-300 motion-reduce:duration-0 rotate-90 scale-0 opacity-0 dark:rotate-0 dark:scale-100 dark:opacity-100"
            aria-hidden="true"
          >
            light_mode
          </span>
        </div>
      </button>

      <!-- Mobile Menu Button -->
      <button
        id="menu-toggle"
        class="xl:hidden w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant dark:text-dark-on-surface-variant hover:text-primary dark:hover:text-[#2DD4BF] hover:bg-surface-subtle dark:hover:bg-[#111E26] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-haspopup="true"
      >
        <span class="material-icons text-2xl" aria-hidden="true">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden xl:hidden absolute left-4 right-4 top-full mt-2 max-h-[calc(100vh-5rem)] overflow-y-auto overscroll-contain rounded-2xl border border-border dark:border-dark-border bg-surface/95 dark:bg-[#111E26]/95 backdrop-blur-md shadow-xl motion-reduce:scroll-auto"
    aria-hidden="true"
    data-state="closed"
  >
    <nav class="flex flex-col p-3 gap-1">
      {
        navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              data-astro-prefetch
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex items-center gap-3 py-2.5 px-3.5 text-base rounded-xl border-l-4 transition-colors motion-reduce:transition-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none",
                active
                  ? "border-primary font-bold text-primary dark:text-[#2DD4BF] bg-primary/10 dark:bg-primary/20"
                  : "border-transparent font-medium text-on-surface dark:text-dark-on-surface hover:bg-surface-subtle dark:hover:bg-[#16242E]",
              ]}
            >
              <span class="material-icons text-xl opacity-80" aria-hidden="true">{item.icon}</span>
              <span>{item.label}</span>
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script src="../scripts/header.ts"></script>
<script>
  // Language preference handler
  document.addEventListener('astro:page-load', () => {
    const langToggle = document.getElementById('language-toggle');
    if (langToggle) {
      langToggle.addEventListener('click', () => {
        const nextLang = langToggle.getAttribute('data-lang');
        if (nextLang) {
          localStorage.setItem('lang-preference', nextLang);
        }
      });
    }
  });
</script>
