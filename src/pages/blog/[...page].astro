---
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/BlogCard.astro";
import PageIntro from "../../components/PageIntro.astro";
import Search from "../../components/Search.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import type { Page } from "astro";
import { slugify } from "../../utils/slugs";
import { useTranslations } from "../../i18n/utils";
import { isPublished } from "../../utils/publishing";
import { topicOf } from "../../utils/blog-topics";

const t = useTranslations('en');

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allPosts = (await getCollection("blog", ({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith('en/'))).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  const tagCounts = new Map<string, number>();
  for (const post of allPosts) {
    for (const tag of post.data.tags || []) tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
  const allTags = [...tagCounts.keys()].sort((a, b) => (tagCounts.get(b) || 0) - (tagCounts.get(a) || 0) || a.localeCompare(b));

  return paginate(allPosts, { pageSize: 6, props: { allTags } });
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
  allTags: string[];
}

const { page, allTags } = Astro.props;

const MAX_TAG_CHIPS = 5;
const slugTag = (tag: string) => tag.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-');
const visibleTags = allTags.slice(0, MAX_TAG_CHIPS);
const overflowTags = allTags.slice(MAX_TAG_CHIPS);
---

<Layout title="Technical articles & guides — ArceApps" description="Reflections, tutorials, and lessons learned about Android development, AI, and software architecture.">
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://arceapps.com" },
        { "@type": "ListItem", position: 2, name: "Blog", item: "https://arceapps.com/blog" },
      ],
    }).replace(/</g, "\\u003C")}
  />

  <main class="mx-auto max-w-5xl px-4 py-12 md:py-16">
    <PageIntro
      eyebrow="BLOG"
      title={t('blog.title')}
      description="Reflections, tutorials, and lessons learned about Android development, AI, and software architecture."
    />

    <!-- Search bar & tag filter chips -->
    <div class="mb-8">
      <div class="flex items-center gap-3 rounded-xl border border-border bg-surface-raised px-4 py-2 shadow-sm dark:border-dark-border dark:bg-dark-surface-raised">
        <Search />
        <span class="flex-1 text-sm text-on-surface-variant/70 dark:text-dark-on-surface-variant/70">{t('blog.search_placeholder')}</span>
      </div>

      <nav class="mt-4 flex flex-wrap items-center gap-2" aria-label={t('blog.filter_aria')} data-blog-chips>
        <button type="button" data-filter="all" aria-pressed="true" class="blog-filter-btn inline-flex min-h-9 items-center rounded-full bg-primary px-4 py-1.5 text-xs font-semibold text-white md:text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
          {t('blog.filter_all')}
        </button>
        {visibleTags.map((tag) => (
          <button type="button" data-filter={slugTag(tag)} aria-pressed="false" class="blog-filter-btn inline-flex min-h-9 items-center rounded-full border border-border bg-surface-raised px-4 py-1.5 text-xs font-medium text-on-surface-variant hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary md:text-sm dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant">
            {tag}
          </button>
        ))}
        {overflowTags.length > 0 && (
          <button
            type="button"
            data-more-toggle
            aria-expanded="false"
            aria-controls="blog-more-tags"
            class="inline-flex min-h-9 items-center rounded-full border border-border bg-surface-raised px-4 py-1.5 text-xs font-medium text-on-surface-variant hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary md:text-sm dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
          >
            {t('blog.filter_more')}
          </button>
        )}
      </nav>
      {overflowTags.length > 0 && (
        <div id="blog-more-tags" data-more-tags hidden class="mt-3 flex flex-wrap gap-2">
          {overflowTags.map((tag) => (
            <button type="button" data-filter={slugTag(tag)} aria-pressed="false" class="blog-filter-btn inline-flex min-h-9 items-center rounded-full border border-border bg-surface px-3 py-1.5 text-xs font-medium text-on-surface-variant hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary md:text-sm dark:border-dark-border dark:bg-dark-surface dark:text-dark-on-surface-variant">{tag}</button>
          ))}
        </div>
      )}
    </div>

    <!-- Article list -->
    {page.data.length > 0 ? (
      <div class="grid grid-cols-1 gap-4" data-blog-list>
        {page.data.map((post) => (
          <div data-blog-card data-tags={(post.data.tags || []).map(slugTag).join(' ')} data-topic={topicOf(post)}>
            <BlogCard post={post} list={true} />
          </div>
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-border bg-surface-raised px-6 py-14 text-center dark:border-dark-border dark:bg-dark-surface-raised">
        <p class="text-lg text-on-surface-variant dark:text-dark-on-surface-variant">{t('blog.empty')}</p>
      </div>
    )}

    <!-- Pagination Controls -->
    {(page.url.prev || page.url.next) && (
      <nav class="mt-10 flex justify-center gap-4" aria-label={t('blog.pagination')} data-pagination>
        {page.url.prev && (
          <a href={page.url.prev} class="inline-flex items-center rounded-xl border border-border bg-surface-raised px-5 py-2.5 font-medium text-primary transition-colors hover:border-primary hover:bg-primary hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus/50 motion-reduce:transition-none dark:border-dark-border dark:bg-dark-surface-raised">
            <span class="material-icons mr-2 text-base" aria-hidden="true">arrow_back</span>
            {t('blog.previous')}
          </a>
        )}
        {page.url.next && (
          <a href={page.url.next} class="inline-flex items-center rounded-xl border border-border bg-surface-raised px-5 py-2.5 font-medium text-primary transition-colors hover:border-primary hover:bg-primary hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus/50 motion-reduce:transition-none dark:border-dark-border dark:bg-dark-surface-raised">
            {t('blog.next')}
            <span class="material-icons ml-2 text-base" aria-hidden="true">arrow_forward</span>
          </a>
        )}
      </nav>
    )}

    <!-- Bottom tags section -->
    <section class="mt-16 rounded-2xl border border-border bg-surface-raised p-8 text-center dark:border-dark-border dark:bg-dark-surface-raised">
      <h2 class="mb-4 text-xl font-bold text-on-surface dark:text-dark-on-surface">{t('blog.filter_tags')}</h2>
      <p class="mx-auto mb-6 max-w-xl text-sm text-on-surface-variant dark:text-dark-on-surface-variant">Popular topics & technologies</p>
      <nav class="flex flex-wrap justify-center gap-2" aria-label="Popular topics">
        {allTags.slice(0, 12).map((tag) => (
          <a
            href={`/blog/tag/${slugify(tag)}/`}
            class="inline-flex items-center rounded-full border border-border bg-surface px-3 py-1.5 text-xs md:text-sm font-medium text-on-surface transition-colors hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface dark:text-dark-on-surface"
          >
            #{tag}
          </a>
        ))}
      </nav>
      {allTags.length > 12 && (
        <div class="mx-auto mt-6 max-w-3xl rounded-xl border border-border bg-surface p-4 dark:border-dark-border dark:bg-dark-surface">
          <p class="mb-3 text-center text-xs font-semibold uppercase tracking-wide text-on-surface-variant dark:text-dark-on-surface-variant">
            All tags ({allTags.length})
          </p>
          <nav class="flex max-h-40 flex-wrap justify-center gap-2 overflow-y-auto" aria-label="All tags">
            {allTags.slice(12).map((tag) => (
              <a
                href={`/blog/tag/${slugify(tag)}/`}
                class="rounded-lg px-2.5 py-1 text-xs md:text-sm text-on-surface-variant hover:bg-primary/10 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:text-dark-on-surface-variant"
              >
                #{tag}
              </a>
            ))}
          </nav>
        </div>
      )}
    </section>
  </main>

  <script>
    function setupBlogFilters() {
      // Los chips de tag viven en la fila visible y en la fila que revela "Más +".
      const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-blog-chips] [data-filter], [data-more-tags] [data-filter]'));
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-blog-card]'));
      const moreToggle = document.querySelector<HTMLButtonElement>('[data-more-toggle]');
      const moreTags = document.querySelector<HTMLElement>('[data-more-tags]');
      const active = ['bg-primary', 'text-white', 'font-semibold'];
      const inactive = ['border', 'border-border', 'bg-surface-raised', 'text-on-surface-variant', 'font-medium', 'dark:border-dark-border', 'dark:bg-dark-surface-raised', 'dark:text-dark-on-surface-variant'];
      const apply = (filter: string) => {
        chips.forEach((chip) => {
          const isActive = chip.getAttribute('data-filter') === filter;
          chip.classList.remove(...(isActive ? inactive : active));
          chip.classList.add(...(isActive ? active : inactive));
          chip.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
        cards.forEach((card) => {
          const tags = (card.getAttribute('data-tags') || '').split(' ').filter(Boolean);
          card.classList.toggle('hidden', filter !== 'all' && !tags.includes(filter));
        });
      };

      // "Más +" solo revela la fila de tags ocultos: nunca aplica un filtro.
      if (moreToggle && moreTags && moreToggle.dataset.moreBound !== 'true') {
        moreToggle.dataset.moreBound = 'true';
        moreToggle.addEventListener('click', () => {
          const expanded = moreToggle.getAttribute('aria-expanded') === 'true';
          moreToggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
          moreTags.hidden = expanded;
        });
      }

      if (!chips.length || !cards.length) return;
      chips.forEach((chip) => {
        if (chip.dataset.filterBound === 'true') return;
        chip.dataset.filterBound = 'true';
        chip.addEventListener('click', () => apply(chip.getAttribute('data-filter') || 'all'));
      });
    }
    setupBlogFilters();
    document.addEventListener('astro:page-load', setupBlogFilters);
  </script>
</Layout>
