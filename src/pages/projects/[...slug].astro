---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
export async function getStaticPaths() { return (await getCollection('projects', ({ id, data }) => id.startsWith('en/') && !data.draft)).map(project => ({ params: { slug: project.slug.split('/').pop() }, props: { project } })); }
const { project } = Astro.props;
const { Content } = await project.render();
const t = useTranslations(getLangFromUrl(Astro.url));
const dateLabel = project.data.datePrecision === 'approximate' ? t('projects.approximate_date') : t('projects.published_date');
---
<Layout title={`${project.data.title} — ArceApps`} description={project.data.description}>
  <article class="mx-auto max-w-5xl px-4 py-16 md:py-20">
    <img src={project.data.heroImage} alt={project.data.heroImageAlt} class="mb-10 aspect-[2/1] w-full rounded-[2rem] object-cover shadow-xl shadow-primary/10" />
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">{dateLabel}</p>
    <time datetime={project.data.pubDate.toISOString()} class="mt-2 block text-sm text-on-surface-variant dark:text-dark-on-surface-variant">{project.data.pubDate.toLocaleDateString('en-US')}</time>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-on-surface dark:text-dark-on-surface md:text-6xl">{project.data.title}</h1>
    <p class="mt-5 max-w-3xl text-xl leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">{project.data.description}</p>
    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technologies">
      {project.data.technologies.map((technology) => <li class="rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-sm font-semibold text-primary">{technology}</li>)}
    </ul>
    <div class="prose mt-10 max-w-none dark:prose-invert"><Content /></div>
    <a class="mt-10 inline-flex items-center rounded-2xl bg-primary px-6 py-3 font-bold text-white transition hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30" href={project.data.repositoryUrl} target="_blank" rel="noopener noreferrer"><span class="material-icons mr-2" aria-hidden="true">code</span>{t('projects.repository')}</a>
  </article>
</Layout>
