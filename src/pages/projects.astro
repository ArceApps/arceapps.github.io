---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { isPublished } from "../utils/publishing";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = (await getCollection("projects", ({ data, id }) => !data.draft && id.startsWith("en/") && isPublished(data.pubDate))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const highlights = [
  {
    icon: 'code',
    title: 'Open Source',
    desc: 'Public repositories with open licences for the community',
  },
  {
    icon: 'smart_toy',
    title: 'AI & Agents',
    desc: 'Experimental workflows and tools for autonomous development',
  },
  {
    icon: 'terminal',
    title: 'Practical Focus',
    desc: 'Real-world solutions for everyday development challenges',
  },
  {
    icon: 'hub',
    title: 'Connected Ecosystem',
    desc: 'Integration with Android, GitHub, and modern toolchains',
  },
];
---

<Layout title={`${t('projects.title')} — ArceApps`} description={t('projects.subtitle')}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://arceapps.com" },
        { "@type": "ListItem", position: 2, name: "Projects", item: "https://arceapps.com/projects" },
      ],
    }).replace(/</g, "\\u003C")}
  />

  <!-- Header Section with PageIntro & Filter Pills -->
  <section class="border-b border-border bg-surface px-4 py-12 dark:border-dark-border dark:bg-dark-surface md:py-16">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="text-left [&>header]:text-left [&>header]:mx-0 [&>header]:max-w-none [&>header>p]:mx-0">
        <PageIntro eyebrow={t("projects.eyebrow")} title={t("projects.title")} description={t("projects.subtitle")} />
      </div>

      <!-- Filter Pills Row -->
      <div class="mt-8 flex flex-wrap gap-2.5" role="toolbar" aria-label="Filter projects">
        <button
          type="button"
          data-project-filter="all"
          aria-pressed="true"
          class="project-filter-btn inline-flex items-center rounded-full bg-primary px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          All
        </button>
        <button
          type="button"
          data-project-filter="ai"
          aria-pressed="false"
          class="project-filter-btn inline-flex items-center rounded-full border border-border bg-surface-raised px-4 py-2 text-sm font-medium text-on-surface-variant transition-all hover:border-primary/50 hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
        >
          AI & Agents
        </button>
        <button
          type="button"
          data-project-filter="android"
          aria-pressed="false"
          class="project-filter-btn inline-flex items-center rounded-full border border-border bg-surface-raised px-4 py-2 text-sm font-medium text-on-surface-variant transition-all hover:border-primary/50 hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
        >
          Android
        </button>
        <button
          type="button"
          data-project-filter="open-source"
          aria-pressed="false"
          class="project-filter-btn inline-flex items-center rounded-full border border-border bg-surface-raised px-4 py-2 text-sm font-medium text-on-surface-variant transition-all hover:border-primary/50 hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
        >
          Open Source
        </button>
      </div>
    </div>
  </section>

  <!-- Projects Grid Section -->
  <main class="mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-16">
    {projects.length > 0 ? (
      <div id="projects-grid" class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => {
          const cats = ['all', 'open-source'];
          const title = (project.data.title || '').toLowerCase();
          const desc = (project.data.description || '').toLowerCase();
          const tags = (project.data.tags || []).map((tag: string) => tag.toLowerCase());
          const techs = (project.data.technologies || []).map((tech: string) => tech.toLowerCase());
          const combined = [...tags, ...techs, title, desc].join(' ');

          if (combined.includes('ai') || combined.includes('ia') || combined.includes('agent') || combined.includes('agente') || combined.includes('skills')) {
            cats.push('ai');
          }
          if (combined.includes('android') || combined.includes('kotlin')) {
            cats.push('android');
          }

          return (
            <div data-project-card data-project-category={cats.join(' ')} class="h-full">
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                heroImage={project.data.heroImage}
                tags={project.data.tags}
                pubDate={project.data.pubDate}
                datePrecision={project.data.datePrecision}
                slug={project.slug.split('/').pop() ?? ''}
                kind="project"
                status={project.data.status}
              />
            </div>
          );
        })}
      </div>
    ) : (
      <p class="rounded-3xl border border-border bg-surface-raised p-10 text-center text-on-surface-variant dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant">
        {t('projects.empty')}
      </p>
    )}

    <!-- GitHub Open Source Callout Card -->
    <div class="mt-16 rounded-3xl border border-border bg-surface-raised p-8 text-center shadow-sm dark:border-dark-border dark:bg-dark-surface-raised md:p-12">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary dark:text-teal-300">
        <span class="material-icons text-3xl" aria-hidden="true">code</span>
      </div>
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-on-surface dark:text-dark-on-surface">
        Explore more code & collaborate
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
        All our projects and experiments are developed openly. Check out our repositories, contribute or fork them on GitHub.
      </p>
      <div class="mt-6 flex justify-center">
        <a
          href="https://github.com/ArceApps"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-primary-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          <span>View ArceApps on GitHub</span>
          <span class="material-icons text-base" aria-hidden="true">open_in_new</span>
        </a>
      </div>
    </div>
  </main>

  <!-- Bottom 4-column Highlights Bar -->
  <section class="border-t border-border bg-surface-subtle py-14 dark:border-dark-border dark:bg-dark-surface-subtle">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {highlights.map((item) => (
          <div class="flex flex-col items-center rounded-2xl border border-border bg-surface-raised p-6 text-center shadow-sm dark:border-dark-border dark:bg-dark-surface-raised transition-all">
            <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary dark:text-teal-300">
              <span class="material-icons text-2xl" aria-hidden="true">{item.icon}</span>
            </div>
            <h3 class="mt-4 font-bold text-on-surface dark:text-dark-on-surface">
              {item.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Client-side filtering script -->
  <script>
    function setupProjectFilters() {
      const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-project-filter]');
      const cards = document.querySelectorAll<HTMLElement>('[data-project-card]');

      if (!filterBtns.length || !cards.length) return;

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-project-filter') || 'all';

          // Update active state of buttons
          filterBtns.forEach((b) => {
            if (b === btn) {
              b.classList.remove('border', 'border-border', 'bg-surface-raised', 'text-on-surface-variant', 'dark:border-dark-border', 'dark:bg-dark-surface-raised', 'dark:text-dark-on-surface-variant', 'font-medium');
              b.classList.add('bg-primary', 'text-white', 'font-semibold', 'shadow-sm');
              b.setAttribute('aria-pressed', 'true');
            } else {
              b.classList.remove('bg-primary', 'text-white', 'font-semibold', 'shadow-sm');
              b.classList.add('border', 'border-border', 'bg-surface-raised', 'text-on-surface-variant', 'dark:border-dark-border', 'dark:bg-dark-surface-raised', 'dark:text-dark-on-surface-variant', 'font-medium');
              b.setAttribute('aria-pressed', 'false');
            }
          });

          // Filter cards
          cards.forEach((card) => {
            const categories = (card.getAttribute('data-project-category') || '').split(' ');
            if (filter === 'all' || categories.includes(filter)) {
              card.style.display = '';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    }

    setupProjectFilters();
    document.addEventListener('astro:page-load', setupProjectFilters);
  </script>
</Layout>
