---
import Layout from "../../layouts/Layout.astro";
import AppCard from "../../components/AppCard.astro";
import PageIntro from "../../components/PageIntro.astro";
import { getCollection } from "astro:content";
import { isPublished } from "../../utils/publishing";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations('en');
const apps = (await getCollection("apps", ({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith('en/'))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = apps.find((app) => app.slug.split('/').pop() === 'radiohub');
const linkPrefix = '';

const getAppMetadata = (slug: string, tags: string[] = []) => {
  if (slug === 'radiohub' || tags.some(tag => ['Radio', 'Music', 'Streaming', 'Audio'].includes(tag))) {
    return { category: 'Audio' };
  }
  if (slug === '4line' || tags.some(tag => ['Strategy'].includes(tag))) {
    return { category: 'Tools' };
  }
  if (slug === 'puzzlehub') {
    return { category: 'Tools' };
  }
  return { category: 'Utilities' };
};

// Destacada RadioHub (split-card de la maqueta). Titulo y nombres de las 4
// caracteristicas: copy traducible (src/i18n/ui.ts), resuelto por idioma.
const radioHubFeatured = {
  title: t('apps.featured_title'),
  features: [
    {
      icon: 'radio',
      title: t('apps.featured_feature_stations_title'),
      desc: t('apps.featured_feature_stations_desc'),
    },
    {
      icon: 'favorite',
      title: t('apps.featured_feature_favorites_title'),
      desc: t('apps.featured_feature_favorites_desc'),
    },
    {
      icon: 'person_off',
      title: t('apps.featured_feature_no_signup_title'),
      desc: t('apps.featured_feature_no_signup_desc'),
    },
    {
      icon: 'palette',
      title: t('apps.featured_feature_material_title'),
      desc: t('apps.featured_feature_material_desc'),
    },
  ],
};

// D6: los chips de categoria se derivan de los tags reales de las apps publicadas
// (frecuencia descendente, top 5). No se inventan categorias.
const MAX_CATEGORY_CHIPS = 5;

const tagFrequency = new Map<string, number>();
for (const app of apps) {
  for (const tag of app.data.tags ?? []) {
    const key = tag.trim();
    if (!key) continue;
    tagFrequency.set(key, (tagFrequency.get(key) ?? 0) + 1);
  }
}

const categoryChips = [...tagFrequency.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, MAX_CATEGORY_CHIPS)
  .map(([tag]) => ({ label: tag, filter: tag.toLowerCase().replace(/[^a-z0-9]+/g, '-') }));

// Copy de la cabecera: vive en src/i18n/ui.ts y se resuelve por idioma.
const listTitle = t('apps.list_title');
const listSubtitle = t('apps.list_subtitle');
const filterAllLabel = t('apps.filter_all');
const filterAriaLabel = t('apps.filter_aria');

const qualityPillars = [
  {
    icon: 'verified_user',
    title: 'No intrusive ads',
    desc: 'No full-screen popups, interstitial video ads, or annoying banners disrupting your experience.',
  },
  {
    icon: 'lock',
    title: 'Privacy-first',
    desc: 'Your data stays strictly yours. Zero hidden tracking, background telemetry, or account obligations.',
  },
  {
    icon: 'palette',
    title: 'Material Design 3',
    desc: 'Polished interfaces built with Material You dynamic color, adaptive layouts, and native dark mode.',
  },
  {
    icon: 'bolt',
    title: 'Native performance',
    desc: 'Engineered natively in Kotlin and Jetpack Compose for buttery-smooth animations and minimal battery usage.',
  },
];
---

<Layout title={`${t('apps.title')} - ArceApps`}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://arceapps.com" },
        { "@type": "ListItem", position: 2, name: "Apps", item: "https://arceapps.com/apps" },
      ],
    }).replace(/</g, "\\u003C")}
  />

  <!-- Header Section with App Icon, Title, Subtitle & Category Filter Chips -->
  <section class="border-b border-border bg-surface px-4 py-12 dark:border-dark-border dark:bg-dark-surface md:py-16">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="text-left [&>header]:text-left [&>header]:mx-0 [&>header]:max-w-none [&>header]>p]:mx-0">
        <PageIntro
          icon="apps"
          title={listTitle}
          description={listSubtitle}
        />
      </div>

      <!-- Chips de categoria derivados de los tags reales de las apps (D6) -->
      <div
        class="mt-8 flex flex-wrap gap-2.5"
        role="toolbar"
        aria-label={filterAriaLabel}
        data-apps-chips
      >
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="app-filter-btn inline-flex items-center rounded-full bg-primary px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          {filterAllLabel}
        </button>
        {categoryChips.map((chip) => (
          <button
            type="button"
            data-filter={chip.filter}
            aria-pressed="false"
            class="app-filter-btn inline-flex items-center rounded-full border border-border bg-surface-raised px-4 py-2 text-sm font-medium text-on-surface-variant transition-all hover:border-primary/50 hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
          >
            {chip.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Cuadrícula de Aplicaciones (Apps Grid): Tarjetas uniformes con diseño limpio -->
  <section class="border-b border-border bg-surface-subtle/60 py-10 dark:border-dark-border dark:bg-dark-surface md:py-14">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-on-surface dark:text-dark-on-surface sm:text-2xl">
            All Android Apps
          </h2>
          <p class="mt-1 text-sm text-on-surface-variant dark:text-dark-on-surface-variant">
            Explore our complete suite of Android tools, puzzles, and multimedia apps
          </p>
        </div>
      </div>

      {apps.length > 0 ? (
        <div id="apps-grid" class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
          {apps.map((app) => {
            const slug = app.slug.split('/').pop() || '';
            const isRadioHub = slug === 'radiohub';
            const realIcon = isRadioHub
              ? (app.data.realIconUrl || "/images/apps/radiohub/logo.png")
              : app.data.realIconUrl;

            const meta = getAppMetadata(slug, app.data.tags);

            const appTags = app.data.tags ?? [];

            return (
              <div
                data-app-card
                data-tags={appTags.map((tag) => tag.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-')).join(' ')}
                class="h-full"
              >
                <AppCard
                  title={app.data.title}
                  description={app.data.description}
                  icon={app.data.icon}
                  realIconUrl={realIcon}
                  link={`${linkPrefix}/apps/${slug}`}
                  isExternal={false}
                  compact={true}
                  ctaText="Google Play Store"
                  badges={[meta.category, "Android"]}
                  googlePlayUrl={app.data.googlePlayUrl}
                />
              </div>
            );
          })}
        </div>
      ) : (
        <p class="rounded-xl border border-border p-8 text-center dark:border-dark-border">{t('apps.empty')}</p>
      )}

      <!-- Empty state when category filter has no matches -->
      <div id="apps-empty-filter" class="hidden rounded-2xl border border-border bg-surface-raised p-12 text-center dark:border-dark-border dark:bg-dark-surface-raised">
        <span class="material-icons mx-auto text-4xl text-on-surface-variant/60" aria-hidden="true">search_off</span>
        <h3 class="mt-3 text-lg font-bold text-on-surface dark:text-dark-on-surface">No apps found in this category</h3>
        <p class="mt-1 text-sm text-on-surface-variant dark:text-dark-on-surface-variant">Try selecting "All" to view all available applications.</p>
      </div>
    </div>
  </section>

  <!-- Destacada RadioHub: split-card de la maqueta con datos reales de radiohub.md -->
  {featured && (
    <section class="border-t border-border bg-surface py-14 dark:border-dark-border dark:bg-dark-surface md:py-20">
      <div class="mx-auto max-w-7xl px-4 md:px-6">
        <div class="mb-10 max-w-2xl">
          <h2 class="text-2xl font-extrabold tracking-tight text-on-surface dark:text-dark-on-surface sm:text-3xl">
            {radioHubFeatured.title}
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant sm:text-base">
            {t('apps.featured_subtitle')}
          </p>
        </div>

        <!-- Split-card: contenido a la izquierda, capturas reales a la derecha -->
        <article class="material-card overflow-hidden p-6 sm:p-8 lg:p-10">
          <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12">
            <!-- Columna izquierda: icono, nombre, descripcion y acciones -->
            <div class="flex flex-col justify-center lg:col-span-6">
              <div class="flex items-center gap-4">
                <img
                  src="/images/apps/radiohub/logo.png"
                  alt={t('apps.featured_icon_alt')}
                  width="80"
                  height="80"
                  loading="lazy"
                  decoding="async"
                  class="h-16 w-16 shrink-0 rounded-2xl border border-border object-cover shadow-sm dark:border-dark-border sm:h-20 sm:w-20"
                />
                <h3 class="text-2xl font-extrabold tracking-tight text-on-surface dark:text-dark-on-surface sm:text-3xl">
                  {featured.data.title}
                </h3>
              </div>

              <p class="mt-6 text-base leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
                {t('apps.featured_description')}
              </p>

              <!-- Botones de accion: Google Play + repositorio -->
              <div class="mt-7 flex flex-wrap items-center gap-3">
                <a
                  href={featured.data.googlePlayUrl || 'https://play.google.com/store/apps/details?id=com.arceapps.radiohub'}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-primary-strong focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30"
                >
                  <span>{t('apps.featured_cta_play')}</span>
                  <span class="material-icons text-base" aria-hidden="true">arrow_forward</span>
                </a>
                <a
                  href={featured.data.repoUrl || 'https://github.com/ArceApps/PodcastRadio.git'}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-border bg-surface px-5 py-3 text-sm font-semibold text-on-surface transition hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/30 dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface dark:hover:border-primary dark:hover:text-primary"
                >
                  <span>{t('apps.featured_cta_code')}</span>
                  <span class="material-icons text-base" aria-hidden="true">arrow_forward</span>
                </a>
              </div>

              <!-- Chips de tags reales de la app -->
              <div class="mt-6 flex flex-wrap items-center gap-2">
                {(featured.data.tags ?? []).map((tag) => (
                  <span class="inline-flex items-center rounded-full border border-border bg-surface px-2.5 py-1 text-xs font-medium text-on-surface-variant dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Columna derecha: capturas reales del frontmatter -->
            <div class="lg:col-span-6">
              <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2">
                {(featured.data.screenshots ?? []).slice(0, 4).map((shot) => (
                  <img
                    src={shot}
                    alt={t('apps.featured_screenshot_alt')}
                    loading="lazy"
                    decoding="async"
                    class="w-40 shrink-0 snap-center rounded-2xl border border-border bg-surface object-cover shadow-sm dark:border-dark-border dark:bg-dark-surface-raised sm:w-48"
                  />
                ))}
              </div>
            </div>
          </div>
        </article>

        <!-- Fila de 4 caracteristicas reales de radiohub.md -->
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {radioHubFeatured.features.map((feature) => (
            <div class="flex flex-col items-center text-center">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary dark:bg-primary/15 dark:text-primary">
                <span class="material-icons text-2xl" aria-hidden="true">{feature.icon}</span>
              </div>
              <h3 class="mt-4 text-base font-bold text-on-surface dark:text-dark-on-surface">
                {feature.title}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
                {feature.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Sección inferior de 4 Pilares de Calidad -->
  <section class="border-t border-border bg-surface-subtle py-14 dark:border-dark-border dark:bg-dark-surface-subtle">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="mb-10 text-center">
        <h2 class="text-2xl font-bold tracking-tight text-on-surface dark:text-dark-on-surface sm:text-3xl">
          Quality Pillars in Every App
        </h2>
        <p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant sm:text-base">
          Core principles guiding the design and engineering of all our Android applications
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {qualityPillars.map((item) => (
          <div class="flex flex-col items-center rounded-2xl border border-border bg-surface-raised p-6 text-center shadow-sm dark:border-dark-border dark:bg-dark-surface-raised transition-all">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-500/10 text-primary dark:bg-teal-400/10 dark:text-teal-300">
              <span class="material-icons text-2xl" aria-hidden="true">{item.icon}</span>
            </div>
            <h3 class="mt-4 font-bold text-on-surface dark:text-dark-on-surface text-base">
              {item.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Client-side filtering script -->
  <script>
    function setupAppFilters() {
      const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-apps-chips] [data-filter]'));
      const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-app-card]'));
      const emptyState = document.getElementById('apps-empty-filter');

      if (!chips.length || !cards.length) return;

      const ACTIVE_CLASSES = ['bg-primary', 'text-white', 'font-semibold', 'shadow-sm'];
      const INACTIVE_CLASSES = [
        'border',
        'border-border',
        'bg-surface-raised',
        'text-on-surface-variant',
        'dark:border-dark-border',
        'dark:bg-dark-surface-raised',
        'dark:text-dark-on-surface-variant',
        'font-medium',
      ];

      const applyFilter = (filter: string) => {
        // Estado accesible y visual del chip activo.
        chips.forEach((chip) => {
          const isActive = chip.getAttribute('data-filter') === filter;
          chip.classList.remove(...(isActive ? INACTIVE_CLASSES : ACTIVE_CLASSES));
          chip.classList.add(...(isActive ? ACTIVE_CLASSES : INACTIVE_CLASSES));
          chip.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        // Filtrado de las tarjetas por los tags reales de cada app.
        let visibleCount = 0;
        cards.forEach((card) => {
          const tags = (card.getAttribute('data-tags') || '').split(' ').filter(Boolean);
          if (filter === 'all' || tags.includes(filter)) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (emptyState) {
          emptyState.classList.toggle('hidden', visibleCount > 0);
        }
      };

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          applyFilter(chip.getAttribute('data-filter') || 'all');
        });
      });

      // Estado inicial: "Todas" activo.
      applyFilter('all');
    }

    setupAppFilters();
    document.addEventListener('astro:page-load', setupAppFilters);
  </script>
</Layout>
