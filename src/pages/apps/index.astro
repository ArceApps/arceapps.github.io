---
import Layout from "../../layouts/Layout.astro";
import AppCard from "../../components/AppCard.astro";
import PageIntro from "../../components/PageIntro.astro";
import { getCollection } from "astro:content";
import { isPublished } from "../../utils/publishing";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations('en');
const apps = (await getCollection("apps", ({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith('en/'))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = apps.find((app) => app.slug.split('/').pop() === 'radiohub');
const linkPrefix = '';

const highlights = [
  {
    icon: 'radio',
    title: 'Thousands of stations',
    desc: 'Stations from around the world always available',
  },
  {
    icon: 'favorite_border',
    title: 'Favorites',
    desc: 'Save your favorite stations and games',
  },
  {
    icon: 'person_off',
    title: 'No sign-ups',
    desc: 'Open the app and start using it instantly',
  },
  {
    icon: 'palette',
    title: 'Material 3 Design',
    desc: 'Crafted interface in light and dark mode',
  },
];
---

<Layout title={`${t('apps.title')} - ArceApps`}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://arceapps.com" },
        { "@type": "ListItem", position: 2, name: "Apps", item: "https://arceapps.com/apps" },
      ],
    }).replace(/</g, "\\u003C")}
  />

  <!-- Header Section with PageIntro & Filter Pills -->
  <section class="border-b border-border bg-surface px-4 py-12 dark:border-dark-border dark:bg-dark-surface md:py-16">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="text-left [&>header]:text-left [&>header]:mx-0 [&>header]:max-w-none [&>header>p]:mx-0">
        <PageIntro
          title="Android Applications"
          description="Useful, well-designed applications with a clear goal: making your everyday life easier."
        />
      </div>

      <!-- Filter Pills Row -->
      <div class="mt-8 flex flex-wrap gap-2.5" role="toolbar" aria-label="Filter applications">
        <button
          type="button"
          data-app-filter="all"
          aria-pressed="true"
          class="app-filter-btn inline-flex items-center rounded-full bg-primary px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        >
          All
        </button>
        <button
          type="button"
          data-app-filter="google-play"
          aria-pressed="false"
          class="app-filter-btn inline-flex items-center rounded-full border border-border bg-surface-raised px-4 py-2 text-sm font-medium text-on-surface-variant transition-all hover:border-primary/50 hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
        >
          On Google Play
        </button>
        <button
          type="button"
          data-app-filter="puzzles"
          aria-pressed="false"
          class="app-filter-btn inline-flex items-center rounded-full border border-border bg-surface-raised px-4 py-2 text-sm font-medium text-on-surface-variant transition-all hover:border-primary/50 hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
        >
          Puzzles & Logic
        </button>
        <button
          type="button"
          data-app-filter="multimedia"
          aria-pressed="false"
          class="app-filter-btn inline-flex items-center rounded-full border border-border bg-surface-raised px-4 py-2 text-sm font-medium text-on-surface-variant transition-all hover:border-primary/50 hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
        >
          Multimedia & Radio
        </button>
      </div>
    </div>
  </section>

  <!-- 2x2 Compact Apps Grid Section -->
  <section class="border-b border-border bg-surface-subtle/60 py-10 dark:border-dark-border dark:bg-dark-surface-subtle/50 md:py-14">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      {apps.length > 0 ? (
        <div id="apps-grid" class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
          {apps.map((app) => {
            const slug = app.slug.split('/').pop() || '';
            const isRadioHub = slug === 'radiohub';
            const realIcon = isRadioHub
              ? (app.data.realIconUrl || "/images/apps/radiohub/logo.png")
              : app.data.realIconUrl;

            const categories = ['all'];
            if (app.data.googlePlayUrl) categories.push('google-play');
            if (isRadioHub || app.data.tags?.some((t: string) => ['Radio', 'Music', 'Streaming'].includes(t))) {
              categories.push('multimedia');
            }
            if (['puzzlehub', 'sudoku-plus', '2048-puzzle', '4line'].includes(slug) || app.data.tags?.some((t: string) => ['Puzzle', 'Logic', 'Strategy'].includes(t))) {
              categories.push('puzzles');
            }

            return (
              <div data-app-card data-app-category={categories.join(' ')} class="h-full">
                <AppCard
                  title={app.data.title}
                  description={app.data.description}
                  icon={app.data.icon}
                  realIconUrl={realIcon}
                  link={`${linkPrefix}/apps/${slug}`}
                  isExternal={false}
                  compact={true}
                  ctaText={t('common.read_more')}
                  badges={["Google Play", "Android"]}
                />
              </div>
            );
          })}
        </div>
      ) : (
        <p class="rounded-xl border border-border p-8 text-center dark:border-dark-border">{t('apps.empty')}</p>
      )}
    </div>
  </section>

  <!-- Featured Application Spotlight Section (RadioHub) -->
  {featured && (
    <section class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
      <div class="grid gap-10 rounded-3xl border border-border bg-surface-raised p-6 shadow-sm dark:border-dark-border dark:bg-dark-surface-raised md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] md:p-10 lg:gap-14">
        <!-- Left Column -->
        <div class="flex flex-col justify-center">
          <!-- Top row with RadioHub icon + title -->
          <div class="mb-4 flex items-center gap-3.5">
            <img
              src="/images/apps/radiohub/logo.png"
              alt="RadioHub icon"
              width="40"
              height="40"
              class="h-10 w-10 rounded-xl object-cover shadow-sm"
            />
            <div>
              <span class="text-xs font-bold uppercase tracking-[0.14em] text-primary">
                Featured application
              </span>
              <h2 class="text-xl font-bold text-on-surface dark:text-dark-on-surface">
                {featured.data.title}
              </h2>
            </div>
          </div>

          <!-- Big subtitle H3 -->
          <h3 class="text-2xl font-bold tracking-tight text-on-surface dark:text-dark-on-surface sm:text-3xl">
            Radio, the way you like it
          </h3>

          <!-- Description paragraph -->
          <p class="mt-4 max-w-xl text-base leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant sm:text-lg">
            Access thousands of radio stations from around the world with a simple, fast, and hassle-free interface.
          </p>

          <!-- Two CTA buttons -->
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href={featured.data.googlePlayUrl || `${linkPrefix}/apps/${featured.slug.split('/').pop()}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-primary-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              <span>View on Google Play</span>
              <span class="material-icons text-base" aria-hidden="true">arrow_forward</span>
            </a>
            {featured.data.repoUrl && (
              <a
                href={featured.data.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-border bg-surface px-5 py-3 text-sm font-semibold text-on-surface transition-colors hover:border-primary hover:text-primary dark:border-dark-border dark:bg-dark-surface dark:text-dark-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
              >
                <span class="material-icons text-base" aria-hidden="true">code</span>
                <span>View code</span>
              </a>
            )}
            <a
              href={`${linkPrefix}/apps/${featured.slug.split('/').pop()}`}
              class="inline-flex min-h-11 items-center gap-1.5 rounded-xl px-4 py-3 text-sm font-semibold text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              <span>App details</span>
              <span class="material-icons text-sm" aria-hidden="true">chevron_right</span>
            </a>
          </div>

          <!-- Category pills row below CTAs -->
          <div class="mt-7 flex flex-wrap gap-2">
            {["Android", "Radio", "Multimedia"].map((tag) => (
              <span class="rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-on-surface-variant dark:border-dark-border dark:bg-dark-surface dark:text-dark-on-surface-variant">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Right Column: Sleek Phone Frames -->
        <div class="relative flex min-h-72 items-end justify-center gap-2 overflow-hidden rounded-3xl bg-surface-subtle/80 px-4 pt-8 dark:bg-dark-surface-subtle/60 sm:min-h-96">
          {(featured.data.screenshots || []).slice(0, 3).map((shot, index) => (
            <div
              class:list={[
                "relative overflow-hidden rounded-2xl border-[3px] border-slate-800 bg-slate-900 p-1 shadow-2xl dark:border-slate-700 transition-transform duration-300",
                index === 1
                  ? "z-10 w-[38%] max-w-48 shadow-primary/10"
                  : "w-[30%] max-w-40 translate-y-4 opacity-90 hover:opacity-100 hover:translate-y-2",
              ]}
            >
              <div class="mx-auto mb-1 h-1 w-6 rounded-full bg-slate-700/80"></div>
              <img
                src={shot}
                alt={`${featured.data.title} screenshot ${index + 1}`}
                loading="lazy"
                decoding="async"
                class="h-auto w-full rounded-xl object-contain"
              />
            </div>
          ))}
          {(!featured.data.screenshots || featured.data.screenshots.length === 0) && featured.data.heroImage && (
            <img src={featured.data.heroImage} alt={featured.data.title} class="h-auto w-full object-contain" loading="lazy" />
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Bottom 4-column Feature Highlights Bar -->
  <section class="border-t border-border bg-surface-subtle py-14 dark:border-dark-border dark:bg-dark-surface-subtle">
    <div class="mx-auto max-w-7xl px-4 md:px-6">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {highlights.map((item) => (
          <div class="flex flex-col items-center rounded-2xl border border-border bg-surface-raised p-6 text-center shadow-sm dark:border-dark-border dark:bg-dark-surface-raised transition-all">
            <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary dark:text-teal-300">
              <span class="material-icons text-2xl" aria-hidden="true">{item.icon}</span>
            </div>
            <h3 class="mt-4 font-bold text-on-surface dark:text-dark-on-surface">
              {item.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Client-side filtering script -->
  <script>
    function setupAppFilters() {
      const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-app-filter]');
      const cards = document.querySelectorAll<HTMLElement>('[data-app-card]');

      if (!filterBtns.length || !cards.length) return;

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-app-filter') || 'all';

          // Update active state of buttons
          filterBtns.forEach((b) => {
            if (b === btn) {
              b.classList.remove('border', 'border-border', 'bg-surface-raised', 'text-on-surface-variant', 'dark:border-dark-border', 'dark:bg-dark-surface-raised', 'dark:text-dark-on-surface-variant', 'font-medium');
              b.classList.add('bg-primary', 'text-white', 'font-semibold', 'shadow-sm');
              b.setAttribute('aria-pressed', 'true');
            } else {
              b.classList.remove('bg-primary', 'text-white', 'font-semibold', 'shadow-sm');
              b.classList.add('border', 'border-border', 'bg-surface-raised', 'text-on-surface-variant', 'dark:border-dark-border', 'dark:bg-dark-surface-raised', 'dark:text-dark-on-surface-variant', 'font-medium');
              b.setAttribute('aria-pressed', 'false');
            }
          });

          // Filter cards
          cards.forEach((card) => {
            const categories = (card.getAttribute('data-app-category') || '').split(' ');
            if (filter === 'all' || categories.includes(filter)) {
              card.style.display = '';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    }

    setupAppFilters();
    document.addEventListener('astro:page-load', setupAppFilters);
  </script>
</Layout>
