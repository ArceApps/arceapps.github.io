---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import PhilosophyCard from "../../components/PhilosophyCard.astro";
import PageIntro from "../../components/PageIntro.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations('en');
const apps = (await getCollection("apps", ({ data, id }) => !data.draft && id.startsWith('en/'))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title={`${t('apps.title')} - ArceApps`}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://arceapps.com" },
        { "@type": "ListItem", position: 2, name: "Apps", item: "https://arceapps.com/apps" },
      ],
    }).replace(/</g, "\\u003C")}
  />
  <section class="border-b border-border bg-surface px-4 py-14 dark:border-dark-border dark:bg-dark-surface md:py-20">
    <div class="container mx-auto">
      <PageIntro title={t('apps.title')} description={t('apps.subtitle')} />
    </div>
  </section>

  <section class="bg-surface-variant/30 py-14 dark:bg-dark-surface-variant/30 md:py-20 cv-auto" style="contain-intrinsic-size: 800px;">
    <div class="container mx-auto px-4">
      <PhilosophyCard />
      {apps.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 md:gap-8">
          {apps.map((app) => (
            <ProjectCard
              title={app.data.title}
              description={app.data.description}
              heroImage={app.data.heroImage}
              realIconUrl={app.data.realIconUrl}
              tags={app.data.tags}
              pubDate={app.data.pubDate}
              slug={app.slug.split('/').pop() || ''}
            />
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-border bg-surface-raised px-6 py-14 text-center dark:border-dark-border dark:bg-dark-surface-raised">
          <p class="text-lg text-on-surface-variant dark:text-dark-on-surface-variant">{t('apps.empty')}</p>
        </div>
      )}
    </div>
  </section>
</Layout>
