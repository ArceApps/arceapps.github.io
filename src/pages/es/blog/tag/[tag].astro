---
import Layout from "../../../../layouts/Layout.astro";
import BlogCard from "../../../../components/BlogCard.astro";
import PageIntro from "../../../../components/PageIntro.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { slugify } from "../../../../utils/slugs";
import { useTranslations } from "../../../../i18n/utils";
import { isPublished } from "../../../../utils/publishing";

const t = useTranslations('es');

interface TagGroup {
  posts: Set<CollectionEntry<'blog'>>;
  displayNames: Map<string, number>;
}

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith('es/'));

  // Group posts by slugified tag
  const tagGroups = new Map<string, TagGroup>();

  allPosts.forEach(post => {
    const tags = post.data.tags || [];
    tags.forEach(tag => {
      const slug = slugify(tag);
      if (!tagGroups.has(slug)) {
        tagGroups.set(slug, {
          posts: new Set(),
          displayNames: new Map() // Count occurrences of each display name
        });
      }

      // Explicitly type the retrieved group
      const group = tagGroups.get(slug)!;
      group.posts.add(post);

      const count = group.displayNames.get(tag) || 0;
      group.displayNames.set(tag, count + 1);
    });
  });

  return Array.from(tagGroups, ([slug, data]) => {
    // Find the most frequent display name for this slug
    let bestDisplayName = "";
    let maxCount = -1;

    for (const [name, count] of data.displayNames) {
      if (count > maxCount) {
        maxCount = count;
        bestDisplayName = name;
      }
    }

    const filteredPosts = Array.from(data.posts).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { tag: slug },
      props: { posts: filteredPosts, tagName: bestDisplayName },
    };
  });
}

const { posts, tagName } = Astro.props;
---

<Layout title={t('blog.tag_page_title').replace('{tag}', tagName)}>
  <main class="mx-auto max-w-5xl px-4 py-12 md:py-16">
    <a
      href="/es/blog"
      class="mb-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
    >
      <span class="material-icons text-base" aria-hidden="true">arrow_back</span>
      {t('common.back')}
    </a>

    <PageIntro
      eyebrow="BLOG"
      title={t('blog.tag_title').replace('{tag}', tagName)}
      description={(posts.length === 1 ? t('blog.tag_count_one') : t('blog.tag_count_many')).replace('{count}', String(posts.length))}
    />

    <!-- Search bar & Filter pills -->
    <div class="mb-8">
      <button
        type="button"
        data-open-search
        class="flex min-h-12 w-full items-center gap-3 rounded-xl border border-border bg-surface-raised px-5 py-3 text-left text-on-surface-variant shadow-sm transition-all hover:border-primary/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
      >
        <span class="material-icons text-primary dark:text-teal-300" aria-hidden="true">search</span>
        <span class="flex-1 text-sm md:text-base text-on-surface-variant/70 dark:text-dark-on-surface-variant/70">Buscar artículos...</span>
        <kbd class="hidden rounded-md border border-border bg-surface px-2 py-0.5 text-xs font-semibold text-on-surface-variant dark:border-dark-border dark:bg-dark-surface dark:text-dark-on-surface-variant sm:inline-block">⌘K</kbd>
      </button>

      <nav class="mt-4 flex flex-wrap items-center gap-2" aria-label="Filtro de etiquetas">
        <a
          href="/es/blog"
          class="inline-flex min-h-9 items-center rounded-full border border-border bg-surface-raised px-4 py-1.5 text-xs md:text-sm font-semibold text-on-surface-variant hover:border-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
        >
          Todos los artículos
        </a>
        <span class="inline-flex min-h-9 items-center rounded-full bg-primary px-4 py-1.5 text-xs md:text-sm font-semibold text-white">
          #{tagName}
        </span>
      </nav>
    </div>

    <!-- Article list -->
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 gap-4">
        {posts.map((post: CollectionEntry<'blog'>) => (
          <BlogCard post={post} list={true} />
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-border bg-surface-raised px-6 py-14 text-center dark:border-dark-border dark:bg-dark-surface-raised">
        <p class="text-lg text-on-surface-variant dark:text-dark-on-surface-variant">{t('blog.tag_empty')}</p>
      </div>
    )}
  </main>
</Layout>
