---
import Layout from "../../../layouts/Layout.astro";
import BlogCard from "../../../components/BlogCard.astro";
import PageIntro from "../../../components/PageIntro.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import type { Page } from "astro";
import { slugify } from "../../../utils/slugs";
import { useTranslations } from "../../../i18n/utils";
import { isPublished } from "../../../utils/publishing";
import { blogTopics, topicOf } from "../../../utils/blog-topics";

const t = useTranslations('es');

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allPosts = (await getCollection("blog", ({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith('es/'))).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  const tagCounts = new Map<string, number>();
  for (const post of allPosts) {
    for (const tag of post.data.tags || []) tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
  const allTags = [...tagCounts.keys()].sort((a, b) => (tagCounts.get(b) || 0) - (tagCounts.get(a) || 0) || a.localeCompare(b));

  const topicCounts = blogTopics.map(topic => ({
    slug: topic.slug,
    label: topic.es,
    count: allPosts.filter(post => topicOf(post) === topic.slug).length,
  })).filter(topic => topic.count > 0);
  return paginate(allPosts, { pageSize: 6, props: { allTags, topicCounts } });
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
  allTags: string[];
  topicCounts: { slug: string; label: string; count: number }[];
}

const { page, allTags, topicCounts } = Astro.props;
---

<Layout title="Artículos técnicos y guías — ArceApps" description="Tutoriales, análisis, comparativas y reflexiones sobre desarrollo Android, inteligencia artificial y tecnología en general.">
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: "https://arceapps.com" },
        { "@type": "ListItem", position: 2, name: "Blog", item: "https://arceapps.com/es/blog" },
      ],
    }).replace(/</g, "\\u003C")}
  />

  <main class="mx-auto max-w-5xl px-4 py-12 md:py-16">
    <PageIntro
      eyebrow="BLOG"
      title="Artículos técnicos y guías"
      description="Tutoriales, análisis, comparativas y reflexiones sobre desarrollo Android, inteligencia artificial y tecnología en general."
    />

    <!-- Search bar & Category filter pills row -->
    <div class="mb-8">
      <button
        type="button"
        data-open-search
        class="flex min-h-12 w-full items-center gap-3 rounded-xl border border-border bg-surface-raised px-5 py-3 text-left text-on-surface-variant shadow-sm transition-all hover:border-primary/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
      >
        <span class="material-icons text-primary dark:text-teal-300" aria-hidden="true">search</span>
        <span class="flex-1 text-sm md:text-base text-on-surface-variant/70 dark:text-dark-on-surface-variant/70">Buscar artículos...</span>
        <kbd class="hidden rounded-md border border-border bg-surface px-2 py-0.5 text-xs font-semibold text-on-surface-variant dark:border-dark-border dark:bg-dark-surface dark:text-dark-on-surface-variant sm:inline-block">⌘K</kbd>
      </button>

      <nav class="mt-4 flex flex-wrap items-center gap-2" aria-label="Filtrar artículos por categoría">
        <a
          href="/es/blog"
          aria-current={page.currentPage === 1 ? 'page' : undefined}
          class:list={[
            "inline-flex min-h-9 items-center rounded-full px-4 py-1.5 text-xs md:text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary",
            page.currentPage === 1
              ? "bg-primary text-white"
              : "border border-border bg-surface-raised text-on-surface hover:border-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface"
          ]}
        >
          Todos
        </a>
        {topicCounts.slice(0, 4).map(topic => (
          <a
            href={`/es/blog/topic/${topic.slug}/`}
            class="inline-flex min-h-9 items-center rounded-full border border-border bg-surface-raised px-4 py-1.5 text-xs md:text-sm font-semibold text-on-surface-variant transition-colors hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant"
          >
            {topic.label} <span class="ml-1.5 rounded-full bg-primary/10 px-2 py-0.5 text-xs text-primary dark:text-teal-300">{topic.count}</span>
          </a>
        ))}
        <details class="relative inline-block">
          <summary class="inline-flex min-h-9 cursor-pointer list-none items-center rounded-full border border-border bg-surface-raised px-4 py-1.5 text-xs md:text-sm font-semibold text-on-surface-variant transition-colors hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface-raised dark:text-dark-on-surface-variant [&::-webkit-details-marker]:hidden">
            Más ▾
          </summary>
          <div class="absolute left-0 top-full z-30 mt-2 min-w-52 rounded-xl border border-border bg-surface-raised p-2 shadow-lg dark:border-dark-border dark:bg-dark-surface-raised">
            {topicCounts.slice(4).map(topic => (
              <a
                href={`/es/blog/topic/${topic.slug}/`}
                class="flex items-center justify-between rounded-lg px-3 py-2 text-xs md:text-sm text-on-surface-variant hover:bg-primary/10 hover:text-primary dark:text-dark-on-surface-variant"
              >
                <span>{topic.label}</span>
                <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs text-primary dark:text-teal-300">{topic.count}</span>
              </a>
            ))}
            {allTags.slice(0, 8).map(tag => (
              <a
                href={`/es/blog/tag/${slugify(tag)}/`}
                class="flex items-center justify-between rounded-lg px-3 py-2 text-xs md:text-sm text-on-surface-variant hover:bg-primary/10 hover:text-primary dark:text-dark-on-surface-variant"
              >
                <span>#{tag}</span>
              </a>
            ))}
          </div>
        </details>
      </nav>
    </div>

    <!-- Article list -->
    {page.data.length > 0 ? (
      <div class="grid grid-cols-1 gap-4">
        {page.data.map((post) => (
          <BlogCard post={post} list={true} />
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-border bg-surface-raised px-6 py-14 text-center dark:border-dark-border dark:bg-dark-surface-raised">
        <p class="text-lg text-on-surface-variant dark:text-dark-on-surface-variant">{t('blog.empty')}</p>
      </div>
    )}

    <!-- Pagination Controls -->
    {(page.url.prev || page.url.next) && (
      <nav class="mt-10 flex justify-center gap-4" aria-label={t('blog.pagination')} data-pagination>
        {page.url.prev && (
          <a href={page.url.prev} class="inline-flex items-center rounded-xl border border-border bg-surface-raised px-5 py-2.5 font-medium text-primary transition-colors hover:border-primary hover:bg-primary hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus/50 motion-reduce:transition-none dark:border-dark-border dark:bg-dark-surface-raised">
            <span class="material-icons mr-2 text-base" aria-hidden="true">arrow_back</span>
            {t('blog.previous')}
          </a>
        )}
        {page.url.next && (
          <a href={page.url.next} class="inline-flex items-center rounded-xl border border-border bg-surface-raised px-5 py-2.5 font-medium text-primary transition-colors hover:border-primary hover:bg-primary hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus/50 motion-reduce:transition-none dark:border-dark-border dark:bg-dark-surface-raised">
            {t('blog.next')}
            <span class="material-icons ml-2 text-base" aria-hidden="true">arrow_forward</span>
          </a>
        )}
      </nav>
    )}

    <!-- Bottom tags section -->
    <section class="mt-16 rounded-2xl border border-border bg-surface-raised p-8 text-center dark:border-dark-border dark:bg-dark-surface-raised">
      <h2 class="mb-4 text-xl font-bold text-on-surface dark:text-dark-on-surface">{t('blog.filter_tags')}</h2>
      <p class="mx-auto mb-6 max-w-xl text-sm text-on-surface-variant dark:text-dark-on-surface-variant">Temas y tecnologías más habituales</p>
      <nav class="flex flex-wrap justify-center gap-2" aria-label="Temas más habituales">
        {allTags.slice(0, 12).map((tag) => (
          <a
            href={`/es/blog/tag/${slugify(tag)}/`}
            class="inline-flex items-center rounded-full border border-border bg-surface px-3 py-1.5 text-xs md:text-sm font-medium text-on-surface transition-colors hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-dark-border dark:bg-dark-surface dark:text-dark-on-surface"
          >
            #{tag}
          </a>
        ))}
      </nav>
      {allTags.length > 12 && (
        <details class="mx-auto mt-6 max-w-3xl rounded-xl border border-border bg-surface p-4 text-left dark:border-dark-border dark:bg-dark-surface">
          <summary class="cursor-pointer text-center text-sm font-semibold text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
            Todas las etiquetas ({allTags.length})
          </summary>
          <div class="mt-4 flex flex-wrap justify-center gap-2 border-t border-border pt-4 dark:border-dark-border">
            {allTags.slice(12).map((tag) => (
              <a
                href={`/es/blog/tag/${slugify(tag)}/`}
                class="rounded-lg px-2.5 py-1 text-xs md:text-sm text-on-surface-variant hover:bg-primary/10 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:text-dark-on-surface-variant"
              >
                #{tag}
              </a>
            ))}
          </div>
        </details>
      )}
    </section>
  </main>
</Layout>
