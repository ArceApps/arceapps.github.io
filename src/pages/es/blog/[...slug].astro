---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SocialShare from '../../../components/SocialShare.astro';
import PostNavigation from '../../../components/PostNavigation.astro';
import { slugify } from '../../../utils/slugs';
import { useTranslations } from '../../../i18n/utils';

const t = useTranslations('es');

export async function getStaticPaths() {
  const [posts, enPosts] = await Promise.all([
    getCollection('blog', ({ data, id }) => !data.draft && data.pubDate <= new Date() && id.startsWith('es/')),
    getCollection('blog', ({ data, id }) => !data.draft && data.pubDate <= new Date() && id.startsWith('en/'))
  ]);

  // Create a map for O(1) translation lookup
  const enPostsMap = new Map(enPosts.map(p => [p.data.reference_id, p]));

  // Sort posts by date to ensure correct next/prev logic
  const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return sortedPosts.map((post, index) => {
    const nextPost = index > 0 ? sortedPosts[index - 1] : undefined;
    const prevPost = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : undefined;

    // Find translated post
    let translatedPath = undefined;
    let hreflangPath = undefined;
    if (post.data.reference_id) {
       const enPost = enPostsMap.get(post.data.reference_id);
       if (enPost) {
         translatedPath = `/blog/${enPost.slug.split('/').pop()}`;
         hreflangPath = `/blog/${enPost.slug.split('/').pop()}`;
       }
    }

// Related posts logic — precomputed in getStaticPaths using sortedPosts (no extra getCollection call)
    const currentTags = post.data.tags || [];
    const currentTagsSet = new Set(currentTags);
    const relatedPostsData = [];

    for (let i = 0; i < sortedPosts.length; i++) {
      const p = sortedPosts[i];
      if (p.slug === post.slug) continue;

      let commonTags = 0;
      const pTags = p.data.tags;
      if (pTags) {
        for (let j = 0; j < pTags.length; j++) {
          if (currentTagsSet.has(pTags[j])) {
            commonTags++;
          }
        }
      }

      relatedPostsData.push({ post: p, commonTags });
    }

    const relatedPosts = relatedPostsData
      .sort((a, b) => {
        if (b.commonTags !== a.commonTags) return b.commonTags - a.commonTags;
        return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
      })
      .slice(0, 3)
      .map(r => ({ ...r.post, commonTags: r.commonTags }));

    return {
      params: { slug: post.slug.split('/').pop() },
      props: {
        post,
        prevPost: prevPost ? {
          slug: prevPost.slug.split('/').pop()!,
          title: prevPost.data.title
        } : undefined,
        nextPost: nextPost ? {
          slug: nextPost.slug.split('/').pop()!,
          title: nextPost.data.title
        } : undefined,
        translatedPath,
        hreflangPath,
        relatedPosts,
      },
    };
  });
}

const { post, prevPost, nextPost, translatedPath, hreflangPath, relatedPosts } = Astro.props;
const { Content, headings } = await post.render();

const wordCount = post.body.split(/\s+/g).length;
const readingTime = Math.ceil(wordCount / 200);

const formattedDate = post.data.pubDate.toLocaleDateString('es-ES', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Filter headings for TOC (H2 and H3 only)
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const breadcrumbItems = [
  { label: t('common.home'), href: '/es' },
  { label: t('nav.blog'), href: '/es/blog' },
  { label: post.data.title, href: Astro.url.pathname }
];
---

<Layout title={`${post.data.title} - ArceApps Blog`} description={post.data.description} translatedPath={translatedPath} hreflangPath={hreflangPath} type="article" publishDate={post.data.pubDate} image={`/images/og/blog-es-${post.slug.split('/').pop()}.png`}>
  <div id="progress-container" class="fixed top-0 left-0 z-[100] h-1 w-full bg-transparent" aria-hidden="true">
    <div id="progress-bar" class="scroll-progress-bar h-full w-full origin-left bg-secondary"></div>
  </div>

  <article class="article-detail pt-24 pb-20" data-article-progress>
    <header class="article-header mx-auto w-full max-w-[760px] px-4 pb-12">
      <div class="mb-8 flex justify-center">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <div class="text-center">
        <div class="mb-6 flex flex-wrap items-center justify-center gap-2">
          {post.data.tags && post.data.tags.map((tag: string) => (
            <a
              href={`/es/blog/tag/${slugify(tag)}/`}
              class="rounded-full bg-primary/10 px-3 py-1 text-sm font-bold uppercase tracking-wider text-primary whitespace-nowrap transition-colors hover:bg-primary/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              #{tag}
            </a>
          ))}
        </div>

        <h1 class="mb-6 text-3xl font-bold leading-tight text-on-surface dark:text-dark-on-surface md:text-5xl lg:text-6xl">
          {post.data.title}
        </h1>

        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-lg text-on-surface-variant dark:text-dark-on-surface-variant">
          <div class="flex items-center">
            <span class="material-icons mr-2 text-primary" aria-hidden="true">calendar_today</span>
            <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
          </div>
          <div class="flex items-center">
            <span class="material-icons mr-2 text-primary" aria-hidden="true">schedule</span>
            <span>{readingTime} {t('blog.reading_time')}</span>
          </div>
        </div>
      </div>
    </header>

    {post.data.heroImage && (
      <figure class="article-hero mx-auto mb-16 w-full max-w-[1080px] px-4">
        <div class="overflow-hidden rounded-2xl border border-border bg-surface-subtle elevation-1 dark:border-dark-border dark:bg-dark-surface-subtle">
          <img
            src={post.data.heroImage}
            alt={post.data.title}
            class="block h-auto w-full object-contain"
            loading="eager"
            fetchpriority="high"
            width="1280"
            height="720"
          />
        </div>
      </figure>
    )}

    <div class="article-reading-layout mx-auto grid w-full max-w-[1080px] grid-cols-1 gap-8 px-4 lg:grid-cols-[minmax(0,200px)_minmax(0,760px)] lg:items-start lg:gap-12">
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          {tocHeadings.length > 0 && (
            <nav class="rounded-xl border border-border bg-surface-raised p-4 dark:border-dark-border dark:bg-dark-surface-raised" aria-label={t('blog.table_of_contents')}>
              <h2 class="mb-4 flex items-center text-lg font-bold text-on-surface dark:text-dark-on-surface">
                <span class="material-icons mr-2 text-primary" aria-hidden="true">list</span>
                {t('blog.table_of_contents')}
              </h2>
              <ul class="space-y-2 text-sm">
                {tocHeadings.map(heading => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class:list={[
                        "block rounded py-1 text-on-surface-variant transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:text-dark-on-surface-variant",
                        { "pl-0": heading.depth === 2, "pl-3": heading.depth === 3 }
                      ]}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          <a href="/es/blog" class="mt-8 inline-flex items-center rounded font-medium text-on-surface-variant transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:text-dark-on-surface-variant">
            <span class="material-icons mr-2" aria-hidden="true">arrow_back</span>
            {t('blog.back_to_blog')}
          </a>
        </div>
      </aside>

      <section class="article-reading-column min-w-0 w-full">
        <div class="mb-8 lg:hidden">
          {tocHeadings.length > 0 && (
            <details class="overflow-hidden rounded-xl border border-border bg-surface-raised dark:border-dark-border dark:bg-dark-surface-raised">
              <summary class="flex cursor-pointer list-none items-center justify-between rounded-xl p-4 font-bold text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:text-dark-on-surface">
                <span class="flex items-center">
                  <span class="material-icons mr-2 text-primary" aria-hidden="true">list</span>
                  {t('blog.table_of_contents')}
                </span>
                <span class="material-icons" aria-hidden="true">expand_more</span>
              </summary>
              <nav class="px-4 pb-4" aria-label={t('blog.table_of_contents')}>
                <ul class="space-y-2 border-t border-border pt-3 text-sm dark:border-dark-border">
                  {tocHeadings.map(heading => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class:list={[
                          "block rounded py-1 text-on-surface-variant transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:text-dark-on-surface-variant",
                          { "pl-0": heading.depth === 2, "pl-4": heading.depth === 3 }
                        ]}
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          )}
        </div>

        <div class="article-prose prose prose-lg min-w-0 max-w-none dark:prose-invert">
          <Content />
        </div>

        <SocialShare url={Astro.url.href} title={post.data.title} lang="es" />
        <PostNavigation prevPost={prevPost} nextPost={nextPost} lang="es" />

        <div class="mt-8 border-t border-border pt-8 dark:border-dark-border lg:hidden">
          <a href="/es/blog" class="inline-flex items-center rounded font-medium text-on-surface-variant transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:text-dark-on-surface-variant">
            <span class="material-icons mr-2" aria-hidden="true">arrow_back</span>
            {t('blog.back_to_blog')}
          </a>
        </div>
      </section>
    </div>

    {relatedPosts.length > 0 && (
      <section class="mt-20 bg-surface-subtle py-16 dark:bg-dark-surface-subtle fade-in-section" aria-labelledby="related-articles-title">
        <div class="mx-auto max-w-6xl px-4">
          <h2 id="related-articles-title" class="mb-10 flex items-center justify-center gap-3 text-center text-3xl font-bold text-on-surface dark:text-dark-on-surface">
            <span class="material-icons text-4xl text-primary" aria-hidden="true">style</span>
            {t('blog.related')}
          </h2>
          <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
            {relatedPosts.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Layout>
