---
import Layout from "../../layouts/Layout.astro";
import ContactForm from "../../components/ContactForm.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageIntro from "../../components/PageIntro.astro";

const title = "Contacto — ArceApps";
const description = "Ponte en contacto con ArceApps. Preguntas, sugerencias, o simplemente saludar.";
const breadcrumbItems = [
  { label: "Inicio", href: "/es/" },
  { label: "Contacto", href: "/es/contact" },
];
---

<Layout title={title} description={description}>
  <main class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <div class="mb-6">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <PageIntro
      eyebrow="CONTACTO"
      title="Hablemos"
      description="¿Tienes alguna pregunta sobre mis apps, quieres comentarme una idea o simplemente saludar? Me encantaría escucharte."
    />

    <div class="mt-8 rounded-3xl border border-border bg-surface-raised p-6 shadow-sm dark:border-dark-border dark:bg-dark-surface-raised md:p-10">
      <ContactForm lang="es" />
    </div>
  </main>
</Layout>
