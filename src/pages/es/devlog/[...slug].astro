---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SocialShare from '../../../components/SocialShare.astro';
import { useTranslations } from '../../../i18n/utils';
import { isPublished } from '../../../utils/publishing';

const t = useTranslations('es');

export async function getStaticPaths() {
  const [posts, enPosts] = await Promise.all([
    getCollection('devlog', ({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith('es/')),
    getCollection('devlog', ({ data, id }) => !data.draft && isPublished(data.pubDate) && id.startsWith('en/')),
  ]);

  // Map EN posts by reference_id for O(1) cross-language lookup.
  const enPostsMap = new Map(enPosts.map((p) => [p.data.reference_id, p]));

  return posts.map((post) => {
    // Resolve the EN equivalent so the language switcher works even if
    // filenames diverge. Filename parity (verified by i18n-parity-check)
    // is the primary contract; this is the defense in depth.
    let translatedPath = undefined;
    let hreflangPath = undefined;
    if (post.data.reference_id) {
      const enPost = enPostsMap.get(post.data.reference_id);
      if (enPost) {
        translatedPath = `/devlog/${enPost.slug.split('/').pop()}`;
        hreflangPath = translatedPath;
      }
    }

    return {
      params: { slug: post.slug.split('/').pop() },
      props: { post, translatedPath, hreflangPath },
    };
  });
}

const { post, translatedPath, hreflangPath } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.pubDate.toLocaleDateString('es-ES', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${post.data.title} - ArceApps Bitácora`} description={post.data.description} image={`/images/og/devlog-es-${post.slug.split('/').pop()}.png`} translatedPath={translatedPath} hreflangPath={hreflangPath}>
  <article class="pt-24 pb-20">
    <div class="container mx-auto px-4 max-w-4xl">
      <!-- Back Link -->
      <a href="/es/devlog" class="inline-flex items-center text-on-surface-variant dark:text-dark-on-surface-variant hover:text-primary transition-colors mb-8 focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none rounded">
        <span class="material-icons mr-2" aria-hidden="true">arrow_back</span>
        {t('common.back')}
      </a>

      <!-- Header -->
      <header class="mb-12 text-center">
        <div class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-bold uppercase tracking-wider mb-4">
           {t('home.building_public')}
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-on-surface dark:text-teal-200 leading-tight">
          {post.data.title}
        </h1>
        <div class="flex items-center justify-center text-on-surface-variant dark:text-gray-200 text-lg">
           <span class="material-icons mr-2 text-primary" aria-hidden="true">calendar_today</span>
           <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        </div>
      </header>

      <!-- Content -->
      <div class="prose dark:prose-invert md:prose-lg max-w-none bg-surface dark:bg-dark-surface p-8 md:p-12 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-800">
        <Content />
      </div>

      <SocialShare url={Astro.url.href} title={post.data.title} lang="es" />

    </div>
  </article>
</Layout>
