---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageIntro from "../components/PageIntro.astro";

const title = "Contact — ArceApps";
const description = "Get in touch with ArceApps. Questions, suggestions, or just want to say hi.";
const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "Contact", href: "/contact" },
];
---

<Layout title={title} description={description}>
  <!-- Hero -->
  <div class="border-b border-border bg-surface-subtle py-16 dark:border-dark-border dark:bg-dark-surface-subtle">
    <div class="container mx-auto px-4 max-w-4xl text-center">
      <PageIntro eyebrow="Let's talk" title="Contact" description="Whether you have a question about my apps, want to discuss an idea, or just feel like saying hello — I'd love to hear from you." />
    </div>
  </div>

  <!-- Content -->
  <div class="container mx-auto max-w-2xl px-4 py-16">
    <div class="mb-4">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <div class="rounded-[2rem] border border-border bg-surface-raised p-6 shadow-xl shadow-primary/5 dark:border-dark-border dark:bg-dark-surface-raised md:p-10">
      <ContactForm lang="en" />
    </div>
  </div>
</Layout>
