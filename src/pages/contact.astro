---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageIntro from "../components/PageIntro.astro";

const title = "Contact — ArceApps";
const description = "Get in touch with ArceApps. Questions, suggestions, or just want to say hi.";
const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "Contact", href: "/contact" },
];
---

<Layout title={title} description={description}>
  <main class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <div class="mb-6">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <PageIntro
      eyebrow="CONTACT"
      title="Let's talk"
      description="Whether you have a question about my apps, want to discuss an idea, or just feel like saying hello — I'd love to hear from you."
    />

    <div class="mt-8 rounded-3xl border border-border bg-surface-raised p-6 shadow-sm dark:border-dark-border dark:bg-dark-surface-raised md:p-10">
      <ContactForm lang="en" />
    </div>
  </main>
</Layout>
