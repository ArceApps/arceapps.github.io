---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="mb-12 rounded-2xl border border-border bg-surface-raised p-6 shadow-sm dark:border-dark-border dark:bg-dark-surface-raised md:p-8">
  <div class="flex flex-col items-start gap-6 md:flex-row md:items-center">
    <div class="shrink-0 rounded-xl border border-primary/20 bg-primary/10 p-4 text-primary">
      <span class="material-icons text-4xl" aria-hidden="true">spa</span>
    </div>

    <div class="max-w-3xl space-y-3">
      <h2 class="text-2xl font-bold text-on-surface dark:text-dark-on-surface md:text-3xl">
        {t('philosophy.title')}
      </h2>
      <p class="text-lg leading-relaxed text-on-surface-variant dark:text-dark-on-surface-variant">
        {t('philosophy.text')}
      </p>
    </div>
  </div>
</div>
